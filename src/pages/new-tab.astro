        shell.dataset.hasGroups = newTabState.shortcutGroups.length ? "true" : "false";
      }

      const previousPlacements = new Map(shortcutPlacementMemory);

      shortcutPlacementMemory.clear();
      stack.textContent = "";
      closeShortcutContextMenu();

      if (!newTabState.shortcutGroups.length) {
        stack.append(createShortcutEmptyState());
