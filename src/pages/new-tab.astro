            ) {
              persistConfigChange("已排序");
            }
          });

          const item = document.createElement("a");
          item.className = "shortcut-item group/item absolute inset-0 flex flex-col items-center justify-center gap-[0.4rem] overflow-hidden border border-transparent px-1 py-2 font-[inherit] text-inherit no-underline transition-[transform,background-color,box-shadow] duration-200 hover:z-20 hover:-translate-y-0.5 focus-visible:z-20 focus-visible:-translate-y-0.5 active:translate-y-0 active:scale-[0.985]";
          item.href = shortcut.url;
          if (newTabState.shortcutOpenMode === "newTab") {
            item.target = "_blank";
            item.rel = "noopener noreferrer";
          }
          item.setAttribute(
            "aria-label",
            `${shortcut.title}：${getShortcutSubtitle(shortcut)}`,
