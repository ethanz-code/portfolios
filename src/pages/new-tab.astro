      const cancelButton = createIconButton("取消", "close");
      let shortcutMetadataRequestId = 0;
      let shortcutMetadataTimer = 0;
      let shortcutMetadata = null;

      const applyShortcutMetadata = (metadata) => {
        shortcutMetadata = metadata;

        if (normalizeText(titleInput.value)) {
          return;
        }

        const suggestedTitle = metadata?.title || getShortcutHostname(normalizeShortcutUrlInput(urlInput.value));

        if (suggestedTitle) {
          titleInput.value = suggestedTitle;
          clearInlineFormError(error);
        }
