          itemShell.addEventListener("pointerleave", () => {
            if (newTabState.shortcutLayout === "stack") {
              itemShell.style.zIndex = itemShell.dataset.canvasZ ?? "";
            }
          });
          itemShell.addEventListener("contextmenu", openShortcutMenu);
          let longPressTimer = 0;
          let suppressNextClick = false;

          itemShell.addEventListener("touchstart", (event) => {
            if (event.touches.length !== 1 || activeShortcutContextMenu) {
              return;
            }

            const touch = event.touches[0];
            longPressTimer = window.setTimeout(() => {
              longPressTimer = 0;
              suppressNextClick = true;
              openShortcutMenu({
                clientX: touch.clientX,
                clientY: touch.clientY,
                preventDefault: () => {},
                stopPropagation: () => {},
              });
            }, 500);
          }, { passive: true });

          itemShell.addEventListener("touchmove", () => {
            window.clearTimeout(longPressTimer);
          }, { passive: true });
          itemShell.addEventListener("touchend", () => {
            window.clearTimeout(longPressTimer);
          });
          itemShell.addEventListener("touchcancel", () => {
            window.clearTimeout(longPressTimer);
          });
          itemShell.addEventListener(
            "click",
            (event) => {
              if (!suppressNextClick) {
                return;
              }

              event.preventDefault();
              event.stopPropagation();
              suppressNextClick = false;
            },
            true,
          );
          itemShell.addEventListener("dragstart", (event) => {
            if (event.target instanceof Element && event.target.closest("button")) {
              event.preventDefault();
              return;
            }

            setDragPayload({
              type: "shortcut",
              groupIndex,
              shortcutIndex,
            });
            if (event.dataTransfer) {
              event.dataTransfer.setData("application/json", JSON.stringify(activeDragPayload));
              event.dataTransfer.setData("text/plain", shortcut.title);
              event.dataTransfer.effectAllowed = "move";
            }
            itemShell.classList.add("opacity-50");
          });
          itemShell.addEventListener("dragend", () => {
            itemShell.classList.remove("opacity-50");
            clearDropIndicators(stack);
            clearDragPayload();
          });

          itemShell.addEventListener("dragover", (event) => {
            const payload = readDragPayload(event);

            if (payload?.type !== "shortcut") {
              return;
            }

            event.preventDefault();
            event.stopPropagation();
            if (event.dataTransfer) {
              event.dataTransfer.dropEffect = "move";
            }
            clearDropIndicators(stack);
            const position = getDropPosition(event, itemShell, "x");
            setDropPosition(itemShell, position);
          });
          itemShell.addEventListener("dragleave", () => {
            clearDropElement(itemShell);
          });
          itemShell.addEventListener("drop", (event) => {
            const payload = readDragPayload(event);

            if (payload?.type !== "shortcut") {
              return;
            }

            event.preventDefault();
            event.stopPropagation();
            clearDropIndicators(stack);

            const position = getDropPosition(event, itemShell, "x");
            const targetIndex = shortcutIndex + (position === "after" ? 1 : 0);

            if (
              moveShortcutItem(
                Number(payload.groupIndex),
                Number(payload.shortcutIndex),
                groupIndex,
                targetIndex,
              )
            ) {
              persistConfigChange("已排序");
            }
          });

          const item = document.createElement("a");
          item.className = "shortcut-item group/item absolute inset-0 flex flex-col items-center justify-center gap-[0.4rem] overflow-hidden border border-transparent px-1 py-2 font-[inherit] text-inherit no-underline transition-[transform,border-color,background-color] duration-200 hover:z-20 hover:-translate-y-0.5 focus-visible:z-20 focus-visible:-translate-y-0.5 focus-visible:outline-none";
          item.href = shortcut.url;
          if (newTabState.shortcutOpenMode === "newTab") {
            item.target = "_blank";
            item.rel = "noopener noreferrer";
