          const icon = document.createElement("span");
          icon.className = "shortcut-item__icon relative grid h-10 w-10 shrink-0 place-items-center overflow-hidden";
          icon.setAttribute("aria-hidden", "true");

          const image = document.createElement("img");
          const logoUrls = getShortcutLogoUrls(shortcut);
          image.className = "h-full w-full object-contain p-[0.3rem]";
          image.src = logoUrls[0] ?? "";
          image.alt = "";
          image.loading = "lazy";
          image.decoding = "async";
          image.referrerPolicy = "no-referrer";
          image.dataset.logoCacheKey = getShortcutLogoCacheKey(shortcut.url);
          image.dataset.logoFallbacks = JSON.stringify(logoUrls.slice(1));
          bindLogoFallback(image);
          discoverShortcutLogo(shortcut, image);

          const initial = document.createElement("span");
          initial.className = "shortcut-item__initial hidden text-[0.95rem] font-bold leading-none text-base-content/60";
          initial.textContent = getShortcutInitial(shortcut.title);

          icon.append(image, initial);

          const itemLabel = document.createElement("span");
          itemLabel.className = "shortcut-item__label grid w-full min-w-0 justify-items-center gap-[0.12rem]";
          itemLabel.setAttribute("aria-hidden", "true");

          const itemLabelTitle = document.createElement("strong");
          itemLabelTitle.className = "block w-full truncate text-center text-[0.72rem] font-medium leading-tight sm:text-[0.76rem]";
          itemLabelTitle.dataset.newTabColorTarget = "itemLabel";
          itemLabelTitle.textContent = shortcut.title;

          const itemLabelText = document.createElement("small");
          itemLabelText.className = "block w-full truncate text-center text-[0.63rem] font-medium leading-tight text-base-content/45 sm:text-[0.66rem]";
          itemLabelText.textContent = getShortcutSubtitle(shortcut);

          itemLabel.append(itemLabelTitle, itemLabelText);

          const tooltip = document.createElement("span");
          tooltip.className = "shortcut-item__tooltip pointer-events-none absolute bottom-[calc(100%+0.6rem)] left-1/2 z-40 grid min-w-36 max-w-64 -translate-x-1/2 translate-y-1.5 gap-[0.18rem] border border-base-content/15 bg-base-100 px-3 py-2 text-base-content opacity-0 shadow-[0_8px_28px_rgba(0,0,0,0.10)] transition duration-150 after:absolute after:left-1/2 after:top-full after:h-2 after:w-2 after:-translate-x-1/2 after:-translate-y-1/2 after:rotate-45 after:border-b after:border-r after:border-base-content/15 after:bg-base-100 after:content-[''] group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 max-sm:hidden";
          tooltip.role = "tooltip";

          const tooltipTitle = document.createElement("strong");
          tooltipTitle.className = "block overflow-hidden text-ellipsis whitespace-nowrap text-[0.8rem] font-semibold";
          tooltipTitle.dataset.newTabColorTarget = "itemLabel";
          tooltipTitle.textContent = shortcut.title;

          const tooltipText = document.createElement("small");
          tooltipText.className = "block overflow-hidden text-ellipsis whitespace-nowrap text-[0.72rem] leading-snug text-base-content/55";
          tooltipText.textContent = getShortcutSubtitle(shortcut);

          tooltip.append(tooltipTitle, tooltipText);
          item.append(icon, itemLabel);

          itemShell.append(item, tooltip);
          items.append(itemShell);
        });

        section.append(summary, items);
        groupSections.push(section);
      });

      // 弧形/随机是全画布布局：所有分组的 item 拼接进同一张画布（分组标题隐藏，item 的拖拽/右键/添加都保留）
      if (newTabState.shortcutLayout === "ring" || newTabState.shortcutLayout === "scatter") {
        const lastGroupIndex = newTabState.shortcutGroups.length - 1;
        const lastGroup = newTabState.shortcutGroups[lastGroupIndex];
        const canvasSection = document.createElement("section");
        canvasSection.className = "shortcut-group shortcut-group--canvas relative flex flex-col gap-2.5 py-1";
        canvasSection.setAttribute("aria-label", "全部快捷方式");
        const canvasItems = document.createElement("div");
        canvasItems.className = "shortcut-group__items relative flex w-full min-w-0 flex-wrap items-start justify-start gap-2 sm:gap-2.5";

        canvasItems.addEventListener("dragover", (event) => {
          const payload = readDragPayload(event);

          if (payload?.type !== "shortcut") {
            return;
          }

          event.preventDefault();
          if (event.dataTransfer) {
            event.dataTransfer.dropEffect = "move";
          }
          clearDropIndicators(stack);
          setDropContainer(canvasItems);
        });
        canvasItems.addEventListener("dragleave", () => {
          clearDropElement(canvasItems);
        });
        canvasItems.addEventListener("drop", (event) => {
          const payload = readDragPayload(event);

          if (payload?.type !== "shortcut") {
            return;
          }

          event.preventDefault();
          clearDropIndicators(stack);

          if (moveShortcutItem(Number(payload.groupIndex), Number(payload.shortcutIndex), lastGroupIndex, lastGroup.shortcuts.length)) {
            persistConfigChange("已排序");
          }
        });
        canvasItems.addEventListener("contextmenu", (event) => {
          if (event.target !== canvasItems) {
            return;
          }

          event.preventDefault();
          openShortcutAddForm(lastGroup);
        });

        groupSections.forEach((section) => {
          section.querySelectorAll(":scope > .shortcut-group__items > *").forEach((child) => {
            canvasItems.append(child);
          });
        });

        canvasSection.append(canvasItems);

        // 弧形是底部弧形坞：画布固定在视口底部、吃满全宽，item 沿弧线贴底排开
        if (newTabState.shortcutLayout === "ring") {
          canvasSection.classList.add("new-tab-arc-dock");
        }

        stack.append(canvasSection);
      } else {
        groupSections.forEach((section) => {
          stack.append(section);
        });
      }

      if (stack.dataset.groupDropBound !== "true") {
        stack.addEventListener("dragover", (event) => {
          const payload = readDragPayload(event);

          if (payload?.type !== "group") {
            return;
          }

          event.preventDefault();
          if (event.dataTransfer) {
            event.dataTransfer.dropEffect = "move";
          }
          clearDropIndicators(stack);
          setDropContainer(stack);
        });
        stack.addEventListener("dragleave", () => {
          clearDropElement(stack);
        });
        stack.addEventListener("drop", (event) => {
          const payload = readDragPayload(event);

          if (payload?.type !== "group") {
            return;
          }

          event.preventDefault();
          clearDropIndicators(stack);

          if (moveArrayItem(newTabState.shortcutGroups, Number(payload.groupIndex), newTabState.shortcutGroups.length)) {
            persistConfigChange("已排序");
          }
        });
        stack.addEventListener("contextmenu", (event) => {
          if (event.target !== stack) {
            return;
          }

          event.preventDefault();
          const addGroupButton = stack.querySelector(".shortcut-group--add");

          if (!(addGroupButton instanceof HTMLElement) || !addGroupButton.isConnected) {
            return;
          }

          const form = createGroupAddForm();
          addGroupButton.replaceWith(form);
          focusFirstInput(form);
        });
        stack.dataset.groupDropBound = "true";
      }

      const addGroupButton = document.createElement("button");
      addGroupButton.className = "shortcut-group shortcut-group--add mt-1 flex w-fit items-center gap-2 border border-dashed border-base-content/15 bg-transparent px-3.5 py-2.5 font-[inherit] text-[0.8rem] font-semibold text-base-content/40 opacity-80 transition-[transform,border-color,color,opacity] duration-200 hover:-translate-y-0.5 hover:border-base-content/35 hover:text-base-content/70 hover:opacity-100 focus-visible:-translate-y-0.5 focus-visible:border-base-content/35 focus-visible:text-base-content/70 focus-visible:opacity-100 focus-visible:outline-none";
      addGroupButton.type = "button";
      addGroupButton.setAttribute("aria-label", settingsLabels.addGroupLabel ?? "添加分组");
      const addGroupSummary = document.createElement("span");
      addGroupSummary.className = "shortcut-group__summary flex items-center gap-2 text-inherit";
      const addGroupTitle = document.createElement("span");
      addGroupTitle.textContent = settingsLabels.addGroupLabel ?? "添加分组";
      const addGroupMark = document.createElement("span");
      addGroupMark.className = "grid h-4 w-4 place-items-center [&_svg]:h-3.5 [&_svg]:w-3.5";
      addGroupMark.setAttribute("aria-hidden", "true");
      addGroupMark.innerHTML = getIconMarkup("plus");
      addGroupSummary.append(addGroupTitle, addGroupMark);

      addGroupButton.append(addGroupSummary);
      addGroupButton.addEventListener("click", () => {
        const form = createGroupAddForm();
        addGroupButton.replaceWith(form);
        focusFirstInput(form);
      });

      stack.append(addGroupButton);

      applyShortcutLayouts(previousPlacements);
      applyTextColors();
    };

    const setStatus = (message) => {
      const status = document.querySelector("[data-config-status]");

      if (status instanceof HTMLElement) {
        status.textContent = message;
      }
    };

    const compressBackgroundImage = (file) =>
      new Promise((resolve) => {
        const reader = new FileReader();

        reader.addEventListener("load", () => {
          if (typeof reader.result !== "string") {
            resolve("");
            return;
          }

          const originalUrl = reader.result;

          if (file.type === "image/svg+xml" || file.type === "image/gif") {
            resolve(originalUrl);
            return;
          }

          const image = new Image();
          image.addEventListener("load", () => {
            const width = image.naturalWidth || 0;
            const height = image.naturalHeight || 0;

            if (!width || !height) {
              resolve(originalUrl);
              return;
            }

            const maxDimension = 1920;
            const scale = Math.max(width, height) > maxDimension
              ? maxDimension / Math.max(width, height)
              : 1;
            const canvas = document.createElement("canvas");
            canvas.width = Math.max(1, Math.round(width * scale));
            canvas.height = Math.max(1, Math.round(height * scale));
            const context = canvas.getContext("2d");

            if (!context) {
              resolve(originalUrl);
              return;
            }

            context.drawImage(image, 0, 0, canvas.width, canvas.height);

            let compressedUrl = "";

            try {
              compressedUrl = canvas.toDataURL("image/webp", 0.8);
            } catch {
              compressedUrl = "";
            }

            resolve(
              compressedUrl && compressedUrl.length < originalUrl.length
                ? compressedUrl
                : originalUrl,
            );
          });
          image.addEventListener("error", () => {
            resolve(originalUrl);
          });
          image.src = originalUrl;
        });

        reader.readAsDataURL(file);
      });

    const syncSettingsControls = () => {
      const nameInput = document.querySelector("[data-config-name]");
      const homeLabelInput = document.querySelector("[data-config-home-label]");
      const homeHrefInput = document.querySelector("[data-config-home-href]");
      const shortcutOpenModeInput = document.querySelector("[data-config-shortcut-open-mode]");
      const backgroundInput = document.querySelector("[data-config-background]");
      const backgroundOpacityInput = document.querySelector("[data-config-background-opacity]");
      const backgroundOpacityValue = document.querySelector("[data-config-background-opacity-value]");
      const backgroundStatus = document.querySelector("[data-config-background-status]");
      const textColorModeInput = document.querySelector("[data-config-text-color-mode]");

      if (nameInput instanceof HTMLInputElement) {
        nameInput.value = newTabState.userName;
      }

      if (homeLabelInput instanceof HTMLInputElement) {
        homeLabelInput.value = newTabState.homeLink.label;
      }

      if (homeHrefInput instanceof HTMLInputElement) {
        homeHrefInput.value = newTabState.homeLink.href;
      }

      if (shortcutOpenModeInput instanceof HTMLSelectElement) {
        shortcutOpenModeInput.value = newTabState.shortcutOpenMode;
      }

      if (backgroundInput instanceof HTMLInputElement) {
        backgroundInput.value = newTabState.backgroundImage.startsWith("data:")
          ? ""
          : newTabState.backgroundImage;
      }

      if (backgroundOpacityInput instanceof HTMLInputElement) {
        backgroundOpacityInput.value = String(Math.round(newTabState.backgroundOpacity));
      }

      if (backgroundOpacityValue instanceof HTMLElement) {
        backgroundOpacityValue.textContent = `${Math.round(newTabState.backgroundOpacity)}%`;
      }

      if (textColorModeInput instanceof HTMLSelectElement) {
        textColorModeInput.value = newTabState.textColors.mode;
      }

      if (backgroundStatus instanceof HTMLElement) {
        backgroundStatus.textContent = newTabState.backgroundImage.startsWith("data:")
          ? (settingsLabels.backgroundUploadedLabel ?? "已上传本地背景")
          : newTabState.backgroundImage
            ? (settingsLabels.backgroundUrlStatusLabel ?? "使用背景 URL")
            : (settingsLabels.backgroundEmptyLabel ?? "未设置背景");
      }
    };

    const persistConfigChange = (message = "已保存") => {
      const saved = writeStoredState();
      renderGreeting();
      renderHomeLink();
      renderSearchEngines();
      renderShortcutGroups();
      applyBackground();
      applyTextColors();
      setStatus(saved ? message : storageQuotaErrorMessage);
    };

    const scheduleTextColorSave = () => {
      window.clearTimeout(textColorSaveTimer);
      applyTextColors();
      textColorSaveTimer = window.setTimeout(() => {
        setStatus(writeStoredState() ? "已保存" : storageQuotaErrorMessage);
      }, 500);
    };

    const applyBackground = () => {
      const backgroundBase = document.querySelector("[data-new-tab-background-base]");
      const backgroundLayer = document.querySelector("[data-new-tab-background-layer]");

      if (!(backgroundBase instanceof HTMLElement) || !(backgroundLayer instanceof HTMLElement)) {
        return;
      }

      if (!newTabState.backgroundImage) {
        backgroundBase.hidden = true;
        backgroundBase.classList.add("hidden");
        backgroundLayer.hidden = true;
        backgroundLayer.classList.add("hidden");
        backgroundLayer.style.removeProperty("background-image");
        backgroundLayer.style.opacity = "0";
        delete document.documentElement.dataset.newTabBackground;
        return;
      }

      const cssUrl = newTabState.backgroundImage
        .replace(/\\/g, "\\\\")
        .replace(/"/g, '\\"')
        .replace(/\n/g, "");

      backgroundLayer.hidden = false;
      backgroundBase.hidden = false;
      backgroundBase.classList.remove("hidden");
      backgroundLayer.classList.remove("hidden");
      backgroundLayer.style.backgroundImage = `url("${cssUrl}")`;
      backgroundLayer.style.opacity = String(newTabState.backgroundOpacity / 100);
      document.documentElement.dataset.newTabBackground = "true";
    };

    const getResolvedTextColors = () => {
      if (newTabState.textColors.mode === "default") {
        return null;
      }

      const color = newTabState.textColors.mode === "dark" ? "#111827" : "#f8fafc";

      return { navigationColor: color, itemLabelColor: color };
    };

    const applyTextColors = () => {
      const colors = getResolvedTextColors();
      const colorTargets = document.querySelectorAll("[data-new-tab-color-target]");

      // item 卡片深浅跟随颜色模式：浅色文字配黑卡，深色文字配浅卡，默认跟随主题
      const itemTone = colors
        ? (newTabState.textColors.mode === "light" ? "dark" : "light")
        : (document.documentElement.dataset.theme === "black" ? "dark" : "light");
      document.documentElement.dataset.itemTone = itemTone;

      if (!colors) {
        delete document.documentElement.dataset.newTabTextColors;
        colorTargets.forEach((target) => {
          if (target instanceof HTMLElement) {
            target.style.removeProperty("color");
          }
        });
        return;
      }

      document.documentElement.dataset.newTabTextColors = newTabState.textColors.mode;
      colorTargets.forEach((target) => {
        if (!(target instanceof HTMLElement)) {
          return;
        }

        target.style.color = colors.navigationColor;
      });
    };

    const renderAll = () => {
      renderSearchEngines();
      renderGreeting();
      renderHomeLink();
      renderShortcutGroups();
      applyBackground();
      applyTextColors();
      applyHeaderState();
      syncLayoutSwitcher();
      syncSettingsControls();
    };

    const getHeaderState = () =>
      newTabState.headerSuspended ? "suspended" : newTabState.headerCollapsed ? "collapsed" : "normal";

    const setHeaderState = (state) => {
      newTabState.headerSuspended = state === "suspended";
      newTabState.headerCollapsed = state === "collapsed";
    };

    const applyHeaderState = () => {
      const page = document.querySelector("[data-new-tab-page]");
      const toggle = document.querySelector("[data-header-collapse]");
      const restore = document.querySelector("[data-header-restore]");
      const state = getHeaderState();

      if (page instanceof HTMLElement) {
        if (state === "normal") {
          delete page.dataset.headerState;
        } else {
          page.dataset.headerState = state;
        }
      }

      if (toggle instanceof HTMLElement) {
        const label = state === "normal"
          ? "收起问候"
          : state === "collapsed"
            ? "挂起：屏幕只显示 item"
            : "展开问候与搜索";

        toggle.title = label;
        toggle.setAttribute("aria-label", label);
        toggle.setAttribute("aria-expanded", state === "suspended" ? "false" : "true");
      }

      if (restore instanceof HTMLElement) {
        restore.setAttribute("aria-hidden", state === "suspended" ? "false" : "true");
      }
    };

    // 收起/展开会改变搜索框所在格的列宽（fit-content(28rem) ↔ 22rem），搜索框宽度随之
    // 收放。列宽补间本身是连续的，这里只兜住"位置也动了"的情况（聚焦撑满时搜索框换行），
    // 用 FLIP 把位移补成动画。窄屏没有网格化，两条都为 0，直接跳过。
    const applyHeaderStateWithSearchFlip = () => {
      const search = document.querySelector("[data-new-tab-search]");
      const beforeRect = search instanceof HTMLElement ? search.getBoundingClientRect() : null;
      const beforeState = getHeaderState();

      applyHeaderState();

      if (
        !(search instanceof HTMLElement) ||
        !beforeRect ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        return;
      }

      const afterState = getHeaderState();
      const crossingCollapsed = (beforeState === "collapsed") !== (afterState === "collapsed");

      if (!crossingCollapsed) {
        return;
      }

      const afterRect = search.getBoundingClientRect();
      const dx = beforeRect.left - afterRect.left;
      const dy = beforeRect.top - afterRect.top;

      if (Math.abs(dx) < 1 && Math.abs(dy) < 1) {
        return;
      }

      search.style.transition = "none";
      search.style.transform = `translate(${dx}px, ${dy}px)`;
      search.getBoundingClientRect();
      search.style.transition = "";
      search.style.transform = "";
    };

    const expandHeaderAndFocusSearch = () => {
      setHeaderState("normal");
      writeStoredState();
      applyHeaderStateWithSearchFlip();
      document.querySelector("[data-search-query]")?.focus();
    };

    const syncLayoutSwitcher = () => {
      document.querySelectorAll("[data-layout-option]").forEach((button) => {
        if (!(button instanceof HTMLElement)) {
          return;
        }

        const active = button.dataset.layoutOption === newTabState.shortcutLayout;

        button.setAttribute("aria-pressed", active ? "true" : "false");
        button.classList.toggle("bg-base-200", active);
        button.classList.toggle("font-medium", active);
      });

      document.querySelectorAll("[data-layout-selected]").forEach((mark) => {
        if (!(mark instanceof HTMLElement)) {
          return;
        }

        mark.classList.toggle("hidden", mark.dataset.layoutSelected !== newTabState.shortcutLayout);
      });

      document.querySelectorAll("[data-layout-trigger-icon]").forEach((icon) => {
        if (!(icon instanceof HTMLElement)) {
          return;
        }

        icon.classList.toggle("hidden", icon.dataset.layoutTriggerIcon !== newTabState.shortcutLayout);
      });

      const trigger = document.querySelector("[data-layout-trigger]");

      if (trigger instanceof HTMLElement) {
        const label = layoutLabels[newTabState.shortcutLayout] ?? "网格";
        trigger.title = `布局：${label}`;
        trigger.setAttribute("aria-label", `切换布局，当前${label}`);
      }
    };

    const bindShortcutAdd = () => {
      const trigger = document.querySelector("[data-shortcut-add]");

      if (!(trigger instanceof HTMLElement) || trigger.dataset.addBound === "true") {
        return;
      }

      trigger.addEventListener("click", () => {
        openShortcutAddForm();
      });

      trigger.dataset.addBound = "true";
    };

    const closeLayoutMenu = () => {
      const active = document.activeElement;

      if (active instanceof HTMLElement && active.closest("[data-layout-switcher]")) {
        active.blur();
      }
    };

    const bindLayoutSwitcher = () => {
      const switcher = document.querySelector("[data-layout-switcher]");

      if (!(switcher instanceof HTMLElement) || switcher.dataset.layoutBound === "true") {
        return;
      }

      switcher.addEventListener("click", (event) => {
        const button = event.target instanceof Element ? event.target.closest("[data-layout-option]") : null;

        if (!(button instanceof HTMLElement)) {
          return;
        }

        const mode = normalizeShortcutLayout(button.dataset.layoutOption);
        const isScatter = mode === "scatter";

        // 每次点「随机」都重掷 seed，包括从其他模式切进来时
        if (isScatter) {
          newTabState.scatterSeed = Math.floor(Math.random() * 1000000000) + 1;
        }

        if (mode === newTabState.shortcutLayout) {
          if (isScatter) {
            writeStoredState();
            renderShortcutGroups();
            setStatus("已重新随机");
          }
          closeLayoutMenu();
          return;
        }

        newTabState.shortcutLayout = mode;
        writeStoredState();
        syncLayoutSwitcher();
        renderShortcutGroups();
        closeLayoutMenu();
      });

      switcher.dataset.layoutBound = "true";
    };

    const bindHeaderCollapse = () => {
      const toggle = document.querySelector("[data-header-collapse]");

      if (!(toggle instanceof HTMLElement) || toggle.dataset.collapseBound === "true") {
        return;
      }

      toggle.addEventListener("click", () => {
        const state = getHeaderState();

        // 展开 → 收起（搜索并入功能栏）→ 挂起（只剩 item）→ 展开
        setHeaderState(state === "normal" ? "collapsed" : state === "collapsed" ? "suspended" : "normal");
        writeStoredState();
        applyHeaderStateWithSearchFlip();
      });

      toggle.dataset.collapseBound = "true";
    };

    const bindHeaderRestore = () => {
      const restore = document.querySelector("[data-header-restore]");

      if (!(restore instanceof HTMLElement) || restore.dataset.restoreBound === "true") {
        return;
      }

      restore.addEventListener("click", expandHeaderAndFocusSearch);
      restore.dataset.restoreBound = "true";
    };

    const downloadConfig = () => {
      const blob = new Blob([JSON.stringify(newTabState, null, 2)], {
        type: "application/json;charset=utf-8",
      });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = url;
      link.download = "new-tab-config.json";
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      setStatus("已导出");
    };

    const importConfigFromText = (text) => {
      newTabState = normalizeNewTabState(JSON.parse(text));
      const saved = writeStoredState();
      renderAll();
      setStatus(saved ? "已导入" : storageQuotaErrorMessage);
    };

    const bindSearch = () => {
      const form = document.querySelector("[data-new-tab-search]");
      const input = document.querySelector("[data-search-query]");

      if (
        !(form instanceof HTMLFormElement) ||
        !(input instanceof HTMLInputElement) ||
        form.dataset.searchBound === "true"
      ) {
        return;
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();

        const query = input.value.trim();
        const searchUrl = newTabState.searchEngines.find(
          (engine) => engine.id === newTabState.defaultSearchEngineId,
        )?.searchUrl;

        if (!query) {
          input.focus();
          return;
        }

        if (!searchUrl) {
          return;
        }

        window.location.assign(searchUrl.replace("{query}", encodeURIComponent(query)));
      });

      form.dataset.searchBound = "true";
    };

    // 注意事项抽屉的开合：配置抽屉也要能关它（两个抽屉同时只开一个），
    // 所以 open/close 提到这里共享，绑定只做一次。
    const getNotesPanel = () => {
      const panel = document.querySelector("[data-notes-panel]");

      return panel instanceof HTMLElement ? panel : null;
    };

    // 出场动画结束后补落 hidden：opacity 过渡完只是看不见，hidden 才真正把它
    // 移出可访问性树、也不再占布局。transitionend 只认 opacity（display 那一项
    // 由 allow-discrete 静默收尾，不会派发事件）。
    const hideDrawerAfterExit = (panel) => {
      if (panel.hidden) {
        return;
      }

      const finish = () => {
        if (!panel.dataset.open) {
          panel.hidden = true;
          panel.classList.add("hidden");
        }

        panel.removeEventListener("transitionend", finish);
      };

      panel.addEventListener("transitionend", finish);
    };

    const openNotesPanel = () => {
      const panel = getNotesPanel();

      if (!panel) {
        return;
      }

      closeSettingsPanel();
      // 先摘 hidden 让元素回到过渡起点，下一帧再置 data-open 触发滑入
      panel.hidden = false;
      panel.classList.remove("hidden");
      document.querySelector("[data-notes-open]")?.setAttribute("aria-expanded", "true");
      window.requestAnimationFrame(() => {
        panel.dataset.open = "true";
      });
    };

    const closeNotesPanel = () => {
      const panel = getNotesPanel();

      if (!panel) {
        return;
      }

      delete panel.dataset.open;
      document.querySelector("[data-notes-open]")?.setAttribute("aria-expanded", "false");
      hideDrawerAfterExit(panel);
    };

    const bindNotes = () => {
      const panel = getNotesPanel();
      const openButton = document.querySelector("[data-notes-open]");
      const command = panel?.querySelector("[data-notes-command]");

      if (!panel || panel.dataset.notesBound === "true") {
        return;
      }

      // 指令写成单行、可整段复制：键名跟着当前配置走，别让人手打
      if (command instanceof HTMLElement) {
        command.textContent = `localStorage.removeItem(${JSON.stringify(logoCacheStorageKey)})`;
      }

      openButton?.addEventListener("click", openNotesPanel);
      panel.querySelectorAll("[data-notes-close]").forEach((button) => {
        button.addEventListener("click", closeNotesPanel);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && panel.dataset.open === "true") {
          closeNotesPanel();
        }
      });

      panel.dataset.notesBound = "true";
    };

    // 配置抽屉的开合同理提到这里：注意事项开时要能关它
    const closeSettingsPanel = () => {
      const settings = document.querySelector("[data-config-drawer]");

      if (!(settings instanceof HTMLElement)) {
        return;
      }

      delete settings.dataset.open;
      hideDrawerAfterExit(settings);
    };

    const bindSettings = () => {
      const settings = document.querySelector("[data-config-drawer]");
      const openButton = document.querySelector("[data-config-open]");

      if (!(settings instanceof HTMLElement) || settings.dataset.settingsBound === "true") {
        return;
      }

      const nameInput = settings.querySelector("[data-config-name]");
      const homeLabelInput = settings.querySelector("[data-config-home-label]");
      const homeHrefInput = settings.querySelector("[data-config-home-href]");
      const shortcutOpenModeInput = settings.querySelector("[data-config-shortcut-open-mode]");
      const searchEngineInput = settings.querySelector("[data-config-search-engine]");
      const backgroundInput = settings.querySelector("[data-config-background]");
      const backgroundOpacityInput = settings.querySelector("[data-config-background-opacity]");
      const textColorModeInput = settings.querySelector("[data-config-text-color-mode]");
      const backgroundFileInput = settings.querySelector("[data-config-background-file]");
      const backgroundFileTrigger = settings.querySelector("[data-config-background-file-trigger]");
      const fileInput = settings.querySelector("[data-config-file]");
      const importButton = settings.querySelector("[data-config-import]");
      const exportButton = settings.querySelector("[data-config-export]");
      const clearBackgroundButton = settings.querySelector("[data-config-clear-background]");
      const resetButton = settings.querySelector("[data-config-reset]");

      const openSettings = () => {
        closeNotesPanel();
        settings.hidden = false;
        settings.classList.remove("hidden");
        window.requestAnimationFrame(() => {
          settings.dataset.open = "true";
        });
      };

      openButton?.addEventListener("click", openSettings);
      settings.querySelectorAll("[data-config-close]").forEach((button) => {
        button.addEventListener("click", closeSettingsPanel);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && settings.dataset.open === "true") {
          closeSettingsPanel();
        }
      });

      nameInput?.addEventListener("input", () => {
        if (!(nameInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.userName = normalizeText(nameInput.value, defaultPayload.config?.userName ?? "Ethanz888");
        persistConfigChange();
      });

      homeLabelInput?.addEventListener("input", () => {
        if (!(homeLabelInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.homeLink.label = normalizeText(homeLabelInput.value, defaultPayload.config?.homeLink?.label ?? "资料卡首页");
        persistConfigChange();
      });

      homeHrefInput?.addEventListener("input", () => {
        if (!(homeHrefInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.homeLink.href = normalizeText(homeHrefInput.value, defaultPayload.config?.homeLink?.href ?? "/");
        persistConfigChange();
      });

      shortcutOpenModeInput?.addEventListener("change", () => {
        if (!(shortcutOpenModeInput instanceof HTMLSelectElement)) {
          return;
        }

        newTabState.shortcutOpenMode = normalizeShortcutOpenMode(shortcutOpenModeInput.value);
        persistConfigChange();
        syncSettingsControls();
      });

      searchEngineInput?.addEventListener("change", () => {
        if (!(searchEngineInput instanceof HTMLSelectElement)) {
          return;
        }

        if (newTabState.searchEngines.some((engine) => engine.id === searchEngineInput.value)) {
          newTabState.defaultSearchEngineId = searchEngineInput.value;
        }
        persistConfigChange();
        syncSettingsControls();
      });

      backgroundInput?.addEventListener("input", () => {
        if (!(backgroundInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.backgroundImage = backgroundInput.value.trim();
        persistConfigChange();
      });

      backgroundOpacityInput?.addEventListener("input", () => {
        if (!(backgroundOpacityInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.backgroundOpacity = Math.min(100, Math.max(0, Number(backgroundOpacityInput.value)));
        persistConfigChange();
        syncSettingsControls();
      });

      const handleTextColorModeChange = () => {
        if (!(textColorModeInput instanceof HTMLSelectElement)) {
          return;
        }

        newTabState.textColors.mode = ["default", "light", "dark"].includes(textColorModeInput.value)
          ? textColorModeInput.value
          : "default";
        persistConfigChange();
        syncSettingsControls();
      };

      textColorModeInput?.addEventListener("input", handleTextColorModeChange);
      textColorModeInput?.addEventListener("change", handleTextColorModeChange);

      backgroundFileTrigger?.addEventListener("click", () => {
        if (backgroundFileInput instanceof HTMLInputElement) {
          backgroundFileInput.click();
        }
      });

      backgroundFileInput?.addEventListener("change", () => {
        if (!(backgroundFileInput instanceof HTMLInputElement)) {
          return;
        }

        const file = backgroundFileInput.files?.[0];

        if (!file) {
          return;
        }

        compressBackgroundImage(file).then((backgroundImage) => {
          if (!backgroundImage) {
            return;
          }

          newTabState.backgroundImage = backgroundImage;
          const saved = writeStoredState();
          renderAll();
          backgroundFileInput.value = "";
          setStatus(saved ? "背景已保存" : storageQuotaErrorMessage);
        });
      });

      importButton?.addEventListener("click", () => {
        if (fileInput instanceof HTMLInputElement) {
          fileInput.click();
        }
      });

      fileInput?.addEventListener("change", () => {
        if (!(fileInput instanceof HTMLInputElement)) {
          return;
        }

        const file = fileInput.files?.[0];

        if (!file) {
          return;
        }

        const reader = new FileReader();
        reader.addEventListener("load", () => {
          if (typeof reader.result !== "string") {
            return;
          }

          try {
            importConfigFromText(reader.result);
          } catch {
            setStatus("JSON 格式不对");
          }

          fileInput.value = "";
        });
        reader.readAsText(file);
      });

      exportButton?.addEventListener("click", downloadConfig);

      clearBackgroundButton?.addEventListener("click", () => {
        newTabState.backgroundImage = "";
        writeStoredState();
        renderAll();
        setStatus("背景已清除");
      });

      resetButton?.addEventListener("click", () => {
        newTabState = defaultState();

        try {
          window.localStorage.removeItem(storageKey);
        } catch {
          // Ignore storage write failures and keep the reset state in memory.
        }

        renderAll();
        setStatus("已恢复默认");
      });
      settings.dataset.settingsBound = "true";
    };

    let shortcutResizeBound = false;
    let shortcutKeysBound = false;
    let themeToneObserverBound = false;

    const bindNewTab = () => {
      newTabState = readStoredState();
      shortcutLogoCache = readShortcutLogoCache();
      renderAll();
      bindSearch();
      bindSettings();
      bindNotes();
      bindShortcutAdd();
      bindLayoutSwitcher();
      bindHeaderCollapse();
      bindHeaderRestore();
      bindShortcutContextMenuDismissal();

      // 首屏布局已落定，放行 padding 补间（之后的收起/挂起切换照常有动画）
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          document.querySelectorAll("[data-booting]").forEach((el) => el.removeAttribute("data-booting"));
        });
      });

      if (!shortcutResizeBound) {
        window.addEventListener("resize", scheduleShortcutRelayout);
        shortcutResizeBound = true;
      }

      // 默认颜色模式下 item 深浅跟随主题，主题切换时重算
      if (!themeToneObserverBound) {
        new MutationObserver(() => applyTextColors()).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
        themeToneObserverBound = true;
      }

      if (!shortcutKeysBound) {
        // 挂起状态下按 / 唤回搜索
        document.addEventListener("keydown", (event) => {
          if (event.key !== "/" || !newTabState.headerSuspended) {
            return;
          }

          const target = event.target;

          if (
            target instanceof HTMLElement &&
            (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.tagName === "SELECT" || target.isContentEditable)
          ) {
            return;
          }

          event.preventDefault();
          expandHeaderAndFocusSearch();
        });
        shortcutKeysBound = true;
      }
    };

    const clearNewTabBackground = () => {
      const backgroundBase = document.querySelector("[data-new-tab-background-base]");
      const backgroundLayer = document.querySelector("[data-new-tab-background-layer]");

      delete document.documentElement.dataset.newTabBackground;
      delete document.documentElement.dataset.newTabTextColors;
      delete document.documentElement.dataset.itemTone;
      closeShortcutContextMenu();

      if (backgroundBase instanceof HTMLElement) {
        backgroundBase.hidden = true;
        backgroundBase.classList.add("hidden");
      }

      if (backgroundLayer instanceof HTMLElement) {
        backgroundLayer.hidden = true;
        backgroundLayer.classList.add("hidden");
        backgroundLayer.style.removeProperty("background-image");
        backgroundLayer.style.opacity = "0";
      }
    };

    bindNewTab();
    document.addEventListener("astro:after-swap", bindNewTab);
    document.addEventListener("astro:before-swap", clearNewTabBackground);
  </script>

</BaseLayout>
