---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  ArrowUpRight,
  Check,
  ChevronUp,
  Dices,
  EllipsisVertical,
  GripVertical,
  Info,
  Layers,
  LayoutGrid,
  PencilLine,
  Plus,
  Spline,
  Search,
  Trash2,
  X,
} from "lucide-astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import {
  newTabConfig,
  newTabSearchEngines,
  newTabShortcutGroups,
} from "../data/new-tab-shortcuts";

const defaultNewTabPayload = {
  config: newTabConfig,
  searchEngines: newTabSearchEngines,
  shortcutGroups: newTabShortcutGroups,
};

const serializedDefaultNewTabPayload = JSON.stringify(defaultNewTabPayload).replace(/</g, "\\u003c");
---

<BaseLayout
  title={newTabConfig.title}
  description={newTabConfig.description}
  includeSidebar={false}
  showHeader={false}
  showFooter={false}
  showFloatingThemeToggle={false}
>
  {/* 布局存在 localStorage、服务端不知道：入场动画要不要为弧形档降级，必须在 shell
      首次渲染前定下来，所以这里内联读一次，把判据挂到 html 上（CSS 见样式块）。 */}
  <script
    is:inline
    set:html={`(() => {
  try {
    const storedLayout = JSON.parse(window.localStorage.getItem(${JSON.stringify(newTabConfig.storageKey)}) ?? "null")?.shortcutLayout;
    if (storedLayout) {
      document.documentElement.dataset.newTabLayout = storedLayout;
    }
  } catch {
    // 读不到就按默认网格处理
  }
})();`}
  />

  {/* 背景层挂 shell 外：shell 入场要整体缩放，fixed 元素留在里面会被拽进包含块。
      外面这层 isolate 容器兜住负 z-index，否则会被 body 的不透明背景色盖住。 */}
  <div class="pointer-events-none fixed inset-0 isolate z-0" aria-hidden="true" data-new-tab-background-host>
    <div
      class="pointer-events-none absolute inset-0 z-[-20] hidden bg-base-100"
      aria-hidden="true"
      data-new-tab-background-base
    ></div>
    <div
      class="pointer-events-none absolute inset-0 -z-10 hidden bg-center bg-cover bg-no-repeat opacity-0 transition-opacity duration-200"
      aria-hidden="true"
      data-new-tab-background-layer
    ></div>
  </div>

  <section
    class="new-tab-shell relative isolate z-10 mx-auto grid w-[min(100%,70rem)] gap-[clamp(1.5rem,3.5vh,2.25rem)] pt-[clamp(2rem,9vh,5.5rem)] max-sm:gap-7"
    aria-labelledby="new-tab-title"
    data-new-tab-page
    data-booting="true"
  >
    <h1 id="new-tab-title" class="sr-only">{newTabConfig.heading}</h1>

    <div class="new-tab-toolbar flex items-end justify-between gap-4 max-sm:flex-col max-sm:items-start max-sm:gap-3">
      <div class="new-tab-greeting-block grid content-start gap-1.5">
        <p
          class="new-tab-greeting m-0 text-[clamp(1.45rem,3vw,1.9rem)] font-normal leading-[1.18] tracking-[-0.015em] [font-family:var(--font-reading)]"
          data-new-tab-greeting
          data-new-tab-color-target="navigation"
        ></p>
        <p
          class="new-tab-date m-0 text-[0.82rem] font-medium tracking-[0.01em] text-base-content/45"
          data-new-tab-date
          data-new-tab-color-target="navigation"
        ></p>
      </div>
      {/* 窄屏工具行自动折行：屏幕放不下就分两排，不挤压也不溢出 */}
      <div class="new-tab-actions flex flex-wrap items-center justify-end gap-1.5 max-sm:justify-start max-sm:gap-1">
        <div class="dropdown dropdown-end" data-layout-switcher>
          <button
            class="btn btn-ghost btn-sm h-8 min-h-8 w-8 p-0 transition-colors [&_svg]:h-4 [&_svg]:w-4"
            type="button"
            tabindex="0"
            aria-haspopup="menu"
            aria-label="切换布局"
            title="切换布局"
            data-layout-trigger
            data-new-tab-color-target="navigation"
          >
            <span data-layout-trigger-icon="grid" class="grid place-items-center">
              <LayoutGrid aria-hidden="true" />
            </span>
            <span data-layout-trigger-icon="stack" class="hidden grid place-items-center">
              <Layers aria-hidden="true" />
            </span>
            <span data-layout-trigger-icon="ring" class="hidden grid place-items-center">
              <Spline aria-hidden="true" />
            </span>
            <span data-layout-trigger-icon="scatter" class="hidden grid place-items-center">
              <Dices aria-hidden="true" />
            </span>
          </button>
          <ul
            tabindex="0"
            class="menu dropdown-content z-[60] mt-2 w-40 rounded-box border border-base-300 bg-base-100 p-2 shadow [&_button]:justify-start [&_button]:gap-2"
          >
            <li>
              <button
                class="layout-option btn btn-ghost btn-sm normal-case font-normal"
                type="button"
                aria-pressed="true"
                data-layout-option="grid"
              >
                <LayoutGrid class="h-4 w-4" aria-hidden="true" />
                <span class="flex-1 text-left">网格</span>
                <span class="grid h-3.5 w-3.5 place-items-center" data-layout-selected="grid">
                  <Check class="h-3.5 w-3.5" aria-hidden="true" />
                </span>
              </button>
            </li>
            <li>
              <button
                class="layout-option btn btn-ghost btn-sm normal-case font-normal"
                type="button"
                aria-pressed="false"
                data-layout-option="stack"
              >
                <Layers class="h-4 w-4" aria-hidden="true" />
                <span class="flex-1 text-left">堆叠</span>
                <span class="hidden grid h-3.5 w-3.5 place-items-center" data-layout-selected="stack">
                  <Check class="h-3.5 w-3.5" aria-hidden="true" />
                </span>
              </button>
            </li>
            <li>
              <button
                class="layout-option btn btn-ghost btn-sm normal-case font-normal"
                type="button"
                aria-pressed="false"
                data-layout-option="ring"
              >
                <Spline class="h-4 w-4" aria-hidden="true" />
                <span class="flex-1 text-left">弧形</span>
                <span class="hidden grid h-3.5 w-3.5 place-items-center" data-layout-selected="ring">
                  <Check class="h-3.5 w-3.5" aria-hidden="true" />
                </span>
              </button>
            </li>
            <li>
              <button
                class="layout-option btn btn-ghost btn-sm normal-case font-normal"
                type="button"
                aria-pressed="false"
                data-layout-option="scatter"
              >
                <Dices class="h-4 w-4" aria-hidden="true" />
                <span class="flex-1 text-left">随机</span>
                <span class="hidden grid h-3.5 w-3.5 place-items-center" data-layout-selected="scatter">
                  <Check class="h-3.5 w-3.5" aria-hidden="true" />
                </span>
              </button>
            </li>
          </ul>
        </div>
        <div>
          <ThemeToggle
            mobile={true}
            triggerClass="h-8 min-h-8 w-8 p-0 [&_svg]:h-[1.05rem] [&_svg]:w-[1.05rem]"
            colorTarget="navigation"
          />
        </div>
        <a
          class="btn btn-ghost btn-sm h-8 min-h-8 gap-1.5 px-3 text-[0.82rem] font-medium transition-colors"
          href={newTabConfig.homeLink.href}
          data-home-link
          data-new-tab-color-target="navigation"
        >
          {newTabConfig.homeLink.label && <span data-home-link-label>{newTabConfig.homeLink.label}</span>}
          <ArrowUpRight class="h-3.5 w-3.5 opacity-55" aria-hidden="true" />
        </a>
        <button
          class="btn btn-ghost btn-sm h-8 min-h-8 gap-1.5 px-3 text-[0.82rem] font-medium transition-colors [&_svg]:h-3.5 [&_svg]:w-3.5"
          type="button"
          data-shortcut-add
          data-new-tab-color-target="navigation"
          aria-label={newTabConfig.settings.addShortcutLabel}
          title={newTabConfig.settings.addShortcutLabel}
        >
          <Plus aria-hidden="true" />
          <span class="max-sm:hidden">{newTabConfig.settings.addShortcutLabel}</span>
        </button>
        <button
          class="btn btn-ghost btn-sm h-8 min-h-8 px-3.5 text-[0.82rem] font-medium transition-colors"
          type="button"
          data-config-open
          data-new-tab-color-target="navigation"
        >
          {newTabConfig.settings.openLabel}
        </button>
        <button
          class="btn btn-ghost btn-sm h-8 min-h-8 w-8 p-0 transition-colors [&_svg]:h-4 [&_svg]:w-4"
          type="button"
          title="注意事项"
          aria-label="注意事项"
          aria-haspopup="dialog"
          aria-expanded="false"
          data-notes-open
          data-new-tab-color-target="navigation"
        >
          <Info aria-hidden="true" />
        </button>
        <button
          class="btn btn-ghost btn-sm h-8 min-h-8 w-8 p-0 transition-colors [&_svg]:h-4 [&_svg]:w-4"
          type="button"
          title="收起问候"
          aria-label="收起问候"
          aria-expanded="true"
          data-header-collapse
          data-new-tab-color-target="navigation"
        >
          <ChevronUp aria-hidden="true" />
        </button>
      </div>
    </div>

    <form
      class="new-tab-search flex w-full min-w-[16rem] max-w-[70rem] items-stretch border border-base-content/10 bg-base-100 transition-colors duration-200 focus-within:border-base-content/30"
      role="search"
      data-new-tab-search
    >
      <label class="sr-only" for="new-tab-query">搜索关键词</label>
      <span class="grid w-10 shrink-0 place-items-center pl-3 text-base-content/35" aria-hidden="true">
        <Search class="h-[1.05rem] w-[1.05rem]" />
      </span>
      <input
        id="new-tab-query"
        class="new-tab-search__input h-12 min-w-0 flex-1 border-0 bg-transparent px-2.5 text-base text-base-content outline-none placeholder:text-base-content/30 sm:text-[0.95rem]"
        type="search"
        name="q"
        autocomplete="off"
        placeholder={newTabConfig.search.placeholder}
        data-search-query
      />
      <span class="new-tab-search__divider my-[0.7rem] w-px shrink-0 bg-base-content/10" aria-hidden="true"></span>
      <button
        class="btn h-auto min-h-0 w-12 shrink-0 rounded-none border-0 bg-base-content text-base-100 hover:bg-base-content/85 focus-visible:bg-base-content/85 sm:w-auto sm:px-5"
        type="submit"
        aria-label={newTabConfig.search.submitLabel}
        title={newTabConfig.search.submitLabel}
      >
        <Search class="h-[1.05rem] w-[1.05rem]" aria-hidden="true" />
        <span class="new-tab-search__submit-label hidden text-[0.82rem] font-medium sm:inline">{newTabConfig.search.submitLabel}</span>
      </button>
    </form>

    <div class="shortcut-stack grid gap-6 max-sm:gap-5" aria-label="快捷网站" data-shortcut-stack></div>
  </section>

  {/* 恢复按钮同样移出 shell：它是 fixed，留在里面会被 shell 的入场缩放当成包含块。 */}
  <button
    class="new-tab-restore btn btn-square btn-sm fixed right-4 top-4 z-[70] h-8 min-h-8 w-8 border border-base-content/15 bg-base-100/85 p-0 text-base-content/70 shadow-[0_6px_20px_rgba(0,0,0,0.10)] backdrop-blur hover:text-base-content [&_svg]:h-4 [&_svg]:w-4"
    type="button"
    aria-label="展开问候与搜索"
    title="展开问候与搜索（按 / 唤回搜索）"
    data-header-restore
  >
    <ChevronUp aria-hidden="true" />
  </button>

  {/* 两个抽屉共用一套开合规则：data-open 是唯一开关。
      进出都走同一条 transition——进场 translate-x-full → 0，出场 0 → translate-x-full，
      allow-discrete 让 hidden 也能参与过渡，JS 不再需要 setTimeout 兜底延迟隐藏。 */}
  <div class="new-tab-config fixed inset-0 z-[80] hidden opacity-0 transition-opacity duration-200 [transition-behavior:allow-discrete] [&:not([data-open])]:pointer-events-none" data-config-drawer>
    <button class="new-tab-config__backdrop absolute inset-0 border-0 bg-base-content/20 opacity-0 transition-opacity duration-200" type="button" aria-label={newTabConfig.settings.closeLabel} data-config-close></button>
    <aside class="new-tab-config__sheet absolute right-0 top-0 grid h-dvh w-[min(100vw,31rem)] max-sm:w-[min(100vw,24rem)] grid-rows-[auto_minmax(0,1fr)_auto] translate-x-full border-l border-base-content/10 bg-base-100 shadow-[-16px_0_48px_rgba(0,0,0,0.10)] transition-transform duration-[280ms] ease-[cubic-bezier(0.22,1,0.36,1)]" aria-label={newTabConfig.settings.panelTitle} aria-modal="true" role="dialog">
      <div class="new-tab-config__header flex items-center justify-between gap-3 border-b border-base-content/10 p-4">
        <div class="min-w-0">
          <h2 class="m-0 text-[0.95rem] font-bold leading-tight">{newTabConfig.settings.panelTitle}</h2>
          <p class="mt-1 text-xs leading-snug text-base-content/50" data-config-status>{newTabConfig.settings.statusReady}</p>
        </div>
        <button class="btn btn-square btn-ghost btn-sm" type="button" aria-label={newTabConfig.settings.closeLabel} data-config-close>
          <X class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>

      <div class="new-tab-config__body grid content-start gap-4 overflow-y-auto p-4">
        <section class="new-tab-config__section grid gap-3">
          <div class="new-tab-config__section-title text-xs font-semibold tracking-[0.12em] text-base-content/45">{newTabConfig.settings.generalLabel}</div>
          <div class="new-tab-config__grid grid grid-cols-2 gap-3 max-sm:grid-cols-1">
            <label class="form-control grid min-w-0 gap-1.5">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.nameLabel}</span>
              </span>
              <input class="input input-bordered input-sm" type="text" autocomplete="off" data-config-name />
            </label>
            <label class="form-control grid min-w-0 gap-1.5">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.homeLinkLabel}</span>
              </span>
              <input class="input input-bordered input-sm" type="text" autocomplete="off" data-config-home-label />
            </label>
            <label class="form-control grid min-w-0 gap-1.5">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.homeHrefLabel}</span>
              </span>
              <input class="input input-bordered input-sm" type="text" autocomplete="off" data-config-home-href />
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.shortcutOpenModeLabel}</span>
              </span>
              <select class="select select-bordered select-sm" data-config-shortcut-open-mode>
                <option value="current">{newTabConfig.settings.shortcutOpenModeCurrentLabel}</option>
                <option value="newTab">{newTabConfig.settings.shortcutOpenModeNewTabLabel}</option>
              </select>
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.searchEngineLabel}</span>
              </span>
              <select class="select select-bordered select-sm" data-config-search-engine></select>
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.backgroundUrlLabel}</span>
              </span>
              <input
                class="input input-bordered input-sm"
                type="url"
                placeholder={newTabConfig.settings.backgroundPlaceholder}
                data-config-background
              />
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.backgroundFileLabel}</span>
              </span>
              <div class="new-tab-config-upload flex min-w-0 items-center gap-2">
                <input hidden type="file" accept="image/*" data-config-background-file />
                <button class="btn btn-outline btn-sm" type="button" data-config-background-file-trigger>
                  {newTabConfig.settings.backgroundFileLabel}
                </button>
                <span class="truncate text-[0.78rem] leading-snug text-base-content/55" data-config-background-status>{newTabConfig.settings.backgroundEmptyLabel}</span>
              </div>
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.backgroundOpacityLabel}</span>
                <span class="label-text-alt" data-config-background-opacity-value></span>
              </span>
              <input
                class="range range-xs"
                type="range"
                min="0"
                max="100"
                step="1"
                data-config-background-opacity
              />
            </label>
            <div class="new-tab-config__wide new-tab-config__section-title col-span-full mt-1 border-t border-base-content/10 pt-4 text-xs font-semibold tracking-[0.12em] text-base-content/45">
              {newTabConfig.settings.textColorLabel}
            </div>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.textColorModeLabel}</span>
              </span>
              <select class="select select-bordered select-sm" data-config-text-color-mode>
                <option value="default">{newTabConfig.settings.textColorDefaultLabel}</option>
                <option value="light">{newTabConfig.settings.textColorLightLabel}</option>
                <option value="dark">{newTabConfig.settings.textColorDarkLabel}</option>
              </select>
            </label>
          </div>
        </section>

      </div>

      <div class="new-tab-config__footer flex flex-wrap items-center justify-start gap-3 border-t border-base-content/10 p-4">
        <input
          hidden
          type="file"
          accept="application/json,.json"
          aria-label={newTabConfig.settings.fileLabel}
          data-config-file
        />
        <button class="btn btn-sm btn-outline" type="button" data-config-import>
          {newTabConfig.settings.importLabel}
        </button>
        <button class="btn btn-sm btn-outline" type="button" data-config-export>
          {newTabConfig.settings.exportLabel}
        </button>
        <button class="btn btn-sm btn-ghost" type="button" data-config-clear-background>
          {newTabConfig.settings.clearBackgroundLabel}
        </button>
        <button class="btn btn-sm btn-ghost" type="button" data-config-reset>
          {newTabConfig.settings.resetLabel}
        </button>
      </div>
    </aside>
  </div>

  {/* 注意事项弹层：讲清数据存在哪、图标怎么来、缓存怎么清——都是用户遇到
     「图标不出来/数据丢了」时真正需要的那几句话，顺带把清理指令写成能直接粘贴的。 */}
  <div class="new-tab-notes fixed inset-0 z-[85] hidden opacity-0 transition-opacity duration-200 [transition-behavior:allow-discrete] [&:not([data-open])]:pointer-events-none" data-notes-panel>
    <button class="new-tab-notes__backdrop absolute inset-0 border-0 bg-base-content/20 opacity-0 transition-opacity duration-200" type="button" aria-label={newTabConfig.settings.notesPanelTitle} data-notes-close></button>
    <aside class="new-tab-notes__sheet absolute right-0 top-0 grid h-dvh w-[min(100vw,31rem)] max-sm:w-[min(100vw,24rem)] grid-rows-[auto_minmax(0,1fr)_auto] translate-x-full border-l border-base-content/10 bg-base-100 shadow-[-16px_0_48px_rgba(0,0,0,0.10)] transition-transform duration-[280ms] ease-[cubic-bezier(0.22,1,0.36,1)]" role="dialog" aria-modal="true" aria-label={newTabConfig.settings.notesPanelTitle}>
      <div class="new-tab-notes__header flex items-center justify-between gap-3 border-b border-base-content/10 p-4">
        <div class="flex min-w-0 items-center gap-2.5">
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-base-content/[0.06] text-base-content/55 [&_svg]:h-4 [&_svg]:w-4">
            <Info aria-hidden="true" />
          </span>
          <h2 class="m-0 text-[0.95rem] font-bold leading-tight">{newTabConfig.settings.notesPanelTitle}</h2>
        </div>
        <button class="btn btn-square btn-ghost btn-sm" type="button" aria-label={newTabConfig.settings.closeLabel} data-notes-close>
          <X class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>

      <div class="new-tab-notes__body grid content-start gap-5 overflow-y-auto p-4 text-[0.8rem] leading-relaxed text-base-content/75">
        <section class="grid gap-1.5">
          <h3 class="m-0 text-[0.82rem] font-semibold text-base-content">{newTabConfig.settings.notesLocalTitle}</h3>
          <p class="m-0">{newTabConfig.settings.notesLocalBody}</p>
        </section>

        <section class="grid gap-1.5">
          <h3 class="m-0 text-[0.82rem] font-semibold text-base-content">{newTabConfig.settings.notesLogoTitle}</h3>
          <p class="m-0">{newTabConfig.settings.notesLogoBody}</p>
        </section>

        <section class="grid gap-1.5">
          <h3 class="m-0 text-[0.82rem] font-semibold text-base-content">{newTabConfig.settings.notesLogoCacheTitle}</h3>
          <p class="m-0">{newTabConfig.settings.notesLogoCacheBody}</p>
        </section>

        <section class="grid gap-2">
          <h3 class="m-0 text-[0.82rem] font-semibold text-base-content">{newTabConfig.settings.notesRecoveryTitle}</h3>
          <p class="m-0">{newTabConfig.settings.notesRecoveryBody}</p>
          <p class="m-0 text-[0.72rem] leading-snug text-base-content/50">{newTabConfig.settings.notesCommandLabel}</p>
          <pre class="new-tab-notes__code m-0 overflow-x-auto border border-base-content/10 bg-base-200/40 p-3 text-[0.72rem] leading-relaxed" data-notes-command></pre>
        </section>
      </div>
    </aside>
  </div>

  <template data-new-tab-icon="check">
    <Check class="h-3.5 w-3.5" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="close">
    <X class="h-3.5 w-3.5" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="drag">
    <GripVertical class="h-3.5 w-3.5" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="more">
    <EllipsisVertical class="h-4 w-4" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="edit">
    <PencilLine class="h-4 w-4" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="plus">
    <Plus class="h-4 w-4" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="trash">
    <Trash2 class="h-3.5 w-3.5" aria-hidden="true" />
  </template>

  <script is:inline type="application/json" id="new-tab-defaults" set:html={serializedDefaultNewTabPayload} />

  <style is:inline>
    /* new-tab 是单屏工具页，不走 BaseLayout 的阅读宽度：main 的 max-w-5xl 会把 shell
       自己的 70rem 卡回 928px，lg:px-12 又会再吃掉左右各 48px——用户要「左右空隙少一点」。
       注意 max-width 不能设成 none：main 靠 mx-auto + max-width 居中，置 none 会让它
       贴左（1512 屏实测 x=0、右侧空 392px）。改成 100% 保持弹性宽度，居中交给 shell 自己。 */
    main:has([data-new-tab-page]) {
      padding: 0;
      max-width: 100%;
    }

    /* 滚动条交给浏览器默认行为：内容放不下才出现、能滚，放得下就不出现。
       不要用 scrollbar-gutter 固定占槽，也不要 overflow: clip 剪掉溢出内容——
       那会造成"占着滚动条区域却不能滚"。 */

    /* new-tab 动效（全局样式，绕过 Tailwind purge）：布局补间 / 入场 / 问候与搜索收起、挂起 */
    [data-new-tab-page].new-tab-shell {
      align-items: end;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "toolbar"
        "search"
        "stack";
      transition: padding-top 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* 宽屏（≥640px）：问候语与日期独占最顶一行，搜索框与功能按钮并排第二行，快捷区垫底——
       用户原话「搜索栏和操作的那几个功能在一行内，那个 xx好，Ethanz888 再往上移」。
       工具栏在宽屏始终 display: contents，让 greeting-block 与 actions 各自成为 shell 的
       直接网格项。关键是「始终」：以前只有展开态拆、收起态收回 flex，折叠第一帧
       display 从 contents 跳成 flex，工具栏凭空长出 446px 的盒，用户原话
       「折叠过程中操作栏区域过渡有一点卡顿僵硬」——实测就是这一下。

       列宽一律写 minmax(0, Xrem)，不用 fit-content：fit-content 与 minmax 是不同类型的
       轨道，二者之间 transition: grid-template-columns 不生效，浏览器直接一步跳到终值
       （实测 t=56ms cols=734px → t=63ms cols=352px，actions 同步从 x=763 瞬移到 x=380）。
       同类型轨道才能逐帧补间。areas 也全程不变，同理——areas 变了元素的行列映射立即重算，
       同样不补间（实测 search 宽度 658 → 1120 一步跳）。
       收起态靠问候语自己的 max-height 归零让位，搜索框与功能按钮的位置都不动。
       封顶值分三档：宽屏 28rem（七个按钮带文字全展开约 446px）常规桌面单行放得下；
       640~899px 收 22rem、640~699px 再收 18rem，逼 flex-wrap 折成两行，
       否则搜索框被挤到和功能行重叠（实测 640px 重叠 110px、700px 重叠 50px）。
       提醒：grid-template-areas 每行 token 数必须等于列数（这里是 2），写成单 token 的
       跨行形状会被浏览器整条静默丢弃。 */
    @media (min-width: 640px) {
      [data-new-tab-page].new-tab-shell {
        grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
        grid-template-areas:
          "greeting greeting"
          "search actions"
          "stack stack";
        transition:
          padding-top 0.45s cubic-bezier(0.22, 1, 0.36, 1),
          grid-template-columns 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      }

      @media (min-width: 640px) and (max-width: 899px) {
        [data-new-tab-page].new-tab-shell {
          grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
        }
      }

      /* 640 这一档 shell 只有约 592px：搜索框保底 16rem(256px) + 列间距 32px 后，
         功能行只剩约 300px。22rem(352px) 还会重叠 16px，收到 18rem(288px) 刚好放下
         四个图标钮，带文字的按钮折到第二行。 */
      @media (min-width: 640px) and (max-width: 699px) {
        [data-new-tab-page].new-tab-shell {
          grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
        }
      }

      [data-new-tab-page] .new-tab-toolbar {
        display: contents;
        gap: 0;
      }

      [data-new-tab-page] .new-tab-greeting-block {
        grid-area: greeting;
      }

      [data-new-tab-page] .new-tab-actions {
        grid-area: actions;
        align-self: center;
        justify-content: flex-end;
      }

      /* 聚焦即撑满，但功能按钮不许换行：搜索框在自己的格子里从 22rem 过渡到 100%，
         按钮留在第二列原位。这里刻意不切单列网格——切成单列 actions 会被推到下一行
         （用户原话「不要让右侧功能换行」），而且 areas 变形不补间、位置是瞬移。 */
      [data-new-tab-page]:has(.new-tab-search:focus-within) .new-tab-search {
        max-width: 100%;
      }
    }

    /* 刷新/首次加载入场：整页像窗口打开一样「突」到眼前（缩放是 new-tab 的语言），
       并带一点自下而上的上浮。缩放收底边、上浮压顶边，中间态不会把文档顶高闪滚动条，
       结束即释放 transform。背景层与恢复按钮已移出 shell，不会被当成 fixed 的包含块。 */
    [data-new-tab-page].new-tab-shell {
      animation: ntab-page-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    @keyframes ntab-page-in {
      from {
        opacity: 0;
        transform: translateY(0.9rem) scale(0.94);
      }
    }

    /* 背景与页面同一口气入场：轻微缩放 + 淡入（宿主在 shell 外，transform 动画不影响任何 fixed 布局）。
       没配背景图时宿主里只有同色兜底层，动画无感、无副作用。 */
    [data-new-tab-background-host] {
      animation: ntab-bg-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    @keyframes ntab-bg-in {
      from {
        opacity: 0;
        transform: scale(0.96);
      }
    }

    /* ── 抽屉（配置 / 注意事项）开合 ─────────────────────────────────
       唯一开关是宿主上的 data-open。hidden 也进了过渡列表（allow-discrete），
       所以进场：hidden 摘掉 → 遮罩淡入 + 抽屉从右滑到位；出场：反向走完再落 hidden，
       不再靠 JS setTimeout 猜时长。duration 280ms 比原 200ms 稍长，滑动手感更完整。 */
    [data-config-drawer],
    [data-notes-panel] {
      transition:
        opacity 0.2s ease,
        display 0.28s allow-discrete;
    }

    [data-config-drawer][data-open],
    [data-notes-panel][data-open] {
      opacity: 1;
    }

    [data-config-drawer] .new-tab-config__backdrop,
    [data-notes-panel] .new-tab-notes__backdrop {
      opacity: 0;
      transition: opacity 0.24s ease;
    }

    [data-config-drawer][data-open] .new-tab-config__backdrop,
    [data-notes-panel][data-open] .new-tab-notes__backdrop {
      opacity: 1;
    }

    [data-config-drawer] .new-tab-config__sheet,
    [data-notes-panel] .new-tab-notes__sheet {
      transform: translateX(100%);
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-config-drawer][data-open] .new-tab-config__sheet,
    [data-notes-panel][data-open] .new-tab-notes__sheet {
      transform: translateX(0);
    }

    /* 弧形布局的瓦片钉在 fixed 坞上（贴着屏幕底部）：shell 一旦有 transform，坞会被当成包含块
       参照拽进内容区，整页缩放/上浮会破坏布局。这一档把动效拆到壳内区块自己做：
       工具栏/搜索上浮淡入、弧形坞自身从底部略沉淡入、缩放交给坞内瓦片自己的弹入。
       判据挂在 html 上——布局存 localStorage，由 shell 前的内联脚本在首帧前写入。 */
    html[data-new-tab-layout="ring"] [data-new-tab-page].new-tab-shell {
      animation: none;
    }

    html[data-new-tab-layout="ring"] [data-new-tab-page] .new-tab-toolbar,
    html[data-new-tab-layout="ring"] [data-new-tab-page] .new-tab-search {
      animation: ntab-rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    html[data-new-tab-layout="ring"] [data-new-tab-page] .new-tab-search {
      animation-delay: 60ms;
    }

    @keyframes ntab-rise {
      from {
        opacity: 0;
        transform: translateY(0.7rem);
      }
    }

    html[data-new-tab-layout="ring"] [data-new-tab-page] .new-tab-arc-dock {
      animation: ntab-dock-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    @keyframes ntab-dock-in {
      from {
        opacity: 0;
        transform: translateY(1.4rem);
      }
    }

    /* 首屏 padding 从展开态滑到收起态要 0.45s，而快捷方式正好在这条过渡刚开始时插入，
       被撑在旧 padding 上把整页顶高约 60px，右侧就闪出滚动条。首帧先不起过渡，
       等布局落定再放行——入场 keyframe 动画不受影响，只有 padding 补间在首屏被跳过。 */
    [data-new-tab-page][data-booting="true"].new-tab-shell,
    [data-new-tab-page][data-booting="true"] .new-tab-search,
    [data-new-tab-page][data-booting="true"] .new-tab-greeting-block,
    [data-new-tab-page][data-booting="true"] .new-tab-toolbar {
      transition: none;
    }

    /* toolbar 在宽屏是 display: contents，本身不占格；窄屏仍是普通 flex 流里的第一块，
       grid-area 由基础规则（"toolbar" 单列区）兜住，不需要按 header 状态切换。 */
    [data-new-tab-page] .new-tab-search {
      grid-area: search;
    }

    [data-new-tab-page] [data-shortcut-stack] {
      grid-area: stack;
    }

    /* 工具栏图标与文字统一跟一个基准色走：默认模式用 55% 不透明度的正文色，
       选了颜色模式（浅色/深色文字）时 applyTextColors 会给每个带
       data-new-tab-color-target 的元素内联写 color，图标用 currentColor 自然跟上。
       之前图标各自写死 text-base-content/55、文字写 /60，两档灰度不一致；
       背景图 + 颜色模式组合下图标还会比文字暗一截，用户反馈「图标看不到」。
       hover 提亮用 filter 而不是 color，避免覆盖内联色让颜色模式失效。 */
    [data-new-tab-page] .new-tab-actions .btn {
      color: color-mix(in oklab, currentColor 55%, transparent);
    }

    [data-new-tab-page] .new-tab-actions .btn:hover {
      filter: brightness(1.6);
    }

    [data-new-tab-page] .new-tab-actions .btn[aria-expanded="true"] {
      filter: brightness(1.6);
    }

    /* 常态（normal）搜索框就是短的：22rem 上限，右侧功能按钮留在原位不换行。
       聚焦时由上面的 :focus-within 规则过渡到 100%，两端都是长度值所以能逐帧补间。
       之前这里写 max-width: none 让常态就顶满整列，用户原话
       「我其实希望输入框本来很短的，然后点击后就有过渡撑满当前宽度」。
       分档与列宽对齐：第一列比 22rem 还窄的档位（640~899px 实测 316~437px）
       若沿用 22rem，常态就已顶满、聚焦时看不出过渡，所以按第一列可用宽度逐档收窄，
       保证每一档都有「短 → 撑满」的可见过程。 */
    [data-new-tab-page]:not([data-header-state]) .new-tab-search {
      max-width: 22rem;
    }

    @media (min-width: 640px) and (max-width: 899px) {
      [data-new-tab-page]:not([data-header-state]) .new-tab-search {
        max-width: 18rem;
      }
    }

    @media (min-width: 640px) and (max-width: 979px) {
      [data-new-tab-page]:not([data-header-state]) .new-tab-search {
        max-width: 20rem;
      }
    }

    /* 700 这一档第一列只剩 316px，20rem(320px) 会逼得常态就顶满、看不出过渡；
       收到 18rem(288px)，给聚焦留出可见的撑满过程。 */
    @media (min-width: 640px) and (max-width: 759px) {
      [data-new-tab-page]:not([data-header-state]) .new-tab-search {
        max-width: 18rem;
      }
    }

    @media (min-width: 640px) and (max-width: 699px) {
      [data-new-tab-page]:not([data-header-state]) .new-tab-search {
        max-width: 16rem;
      }
    }

    /* 一段收起：问候语缩到 0 让位，搜索框吃掉它空出来的宽度。
       刻意不改 areas、也不改列数——areas 一变，元素的行列映射立即重算、不补间
       （实测 search 宽度 658 → 1120 一步跳，actions 从 x=886 瞬移到 x=580）。
       这里只把第二列从 28rem 收到 22rem，与展开态同为 minmax 轨道，
       列宽补间照常生效，搜索框与功能按钮的位置连续变化。
       收起态功能按钮改贴左：第一行问候语已归零，第二行按钮与搜索框同行，
       贴左才和搜索框左边缘对齐，不会孤零零挂在右边。 */
    @media (min-width: 640px) {
      [data-new-tab-page][data-header-state="collapsed"].new-tab-shell,
      [data-new-tab-page][data-header-state="suspended"].new-tab-shell {
        grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
        transition:
          padding-top 0.45s cubic-bezier(0.22, 1, 0.36, 1),
          grid-template-columns 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      }

      [data-new-tab-page][data-header-state="collapsed"] .new-tab-actions,
      [data-new-tab-page][data-header-state="suspended"] .new-tab-actions {
        justify-content: flex-start;
      }
    }

    [data-new-tab-page] .new-tab-toolbar {
      max-height: 10rem;
      transition:
        opacity 0.3s ease,
        transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
        max-height 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-new-tab-page] .new-tab-greeting-block {
      max-height: 8rem;
      transition:
        opacity 0.32s ease,
        transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
        max-height 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-new-tab-page] .new-tab-search {
      max-height: 8rem;
      transition:
        max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
        max-height 0.42s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.3s ease,
        transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.2s ease;
    }

    [data-new-tab-page] .new-tab-search__input {
      transition: height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-new-tab-page] [data-header-collapse] svg,
    html:has([data-new-tab-page]) .new-tab-restore svg {
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* 恢复按钮已移出 shell（fixed，免疫入场缩放的包含块），选择器改挂 html:has */
    html:has([data-new-tab-page]) .new-tab-restore {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.4rem);
      transition:
        opacity 0.25s ease,
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0.35s;
    }

    [data-new-tab-page][data-header-state="collapsed"].new-tab-shell {
      padding-top: clamp(1.25rem, 4vh, 2.25rem);
    }

    /* 挂起态沿用收起态的问候语压缩：suspended 是 collapsed 的下一级，
       第一行必须继续是 0 高。之前这条只写 collapsed，suspended 下问候语回到
       自然高度，第二行被顶下去、搜索框跟着位移——用户原话「第二次折叠的时候
       那个大的搜索框闪了一下」。 */
    [data-new-tab-page][data-header-state="collapsed"] .new-tab-greeting-block,
    [data-new-tab-page][data-header-state="suspended"] .new-tab-greeting-block {
      /* 只压高度，不压宽度。一旦同时把 max-width 也归零，overflow: hidden 里内部 grid
         子元素会按极窄宽度重新换行，盒子反而被撑高（实测 62px → 97px），
         把第二行在折叠第一帧顶下去 36px。宽度让位交给 grid 列宽自己过渡，
         问候语跨满整行、宽度根本不参与折叠。 */
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(-0.75rem);
      pointer-events: none;
    }

    /* 聚焦即撑满：收起态定的 22rem 在 focus-within 时作废，搜索框在自己的格子里
       过渡到 100%，功能按钮留在第二列原位不换行（与展开态同一套做法）。
       注意这里不能写 max-width: none——none 不是长度值，浏览器不插值，
       实测 max-width: 22rem → none 直接一步跳到终值，没有过渡。 */
    [data-new-tab-page][data-header-state="collapsed"] .new-tab-search:focus-within {
      max-width: 100%;
    }

    /* 挂起态沿用收起态的搜索框压缩：高度、分隔线边距、文字标签都不许弹回完整尺寸。
       这些是 collapsed 专属的「变小」规则，漏了 suspended 就会在第二次折叠时
       把大号搜索框的内容重新铺开（搜索框正处于 max-height: 0 的折叠过程中，
       内容反而被撑出来闪一下）。 */
    [data-new-tab-page][data-header-state="collapsed"] .new-tab-search__input,
    [data-new-tab-page][data-header-state="suspended"] .new-tab-search__input {
      height: 2.5rem;
    }

    [data-new-tab-page][data-header-state="collapsed"] .new-tab-search__divider,
    [data-new-tab-page][data-header-state="suspended"] .new-tab-search__divider {
      margin-top: 0.55rem;
      margin-bottom: 0.55rem;
    }

    [data-new-tab-page][data-header-state="collapsed"] .new-tab-search__submit-label,
    [data-new-tab-page][data-header-state="suspended"] .new-tab-search__submit-label {
      display: none;
    }

    /* 箭头指向「点下去之后内容往哪走」，与标题文字同向，不要按状态字面猜：
       normal 朝上（问候与搜索收上去）、collapsed/suspended 朝下（再收一级 / 展开回来）。
       之前只有 collapsed 一条 rotate 且方向搞反，用户原话「刚开始的时候那个箭头方向不对」——
       首屏正是 normal 态，一眼就看到箭头朝下却写着「收起」。 */
    [data-new-tab-page][data-header-state="collapsed"] [data-header-collapse] svg,
    [data-new-tab-page][data-header-state="suspended"] [data-header-collapse] svg,
    html:has([data-new-tab-page][data-header-state="suspended"]) .new-tab-restore svg {
      transform: rotate(180deg);
    }

    [data-new-tab-page][data-header-state="suspended"].new-tab-shell {
      padding-top: clamp(0.75rem, 2vh, 1.5rem);
    }

    [data-new-tab-page][data-header-state="suspended"] .new-tab-toolbar,
    [data-new-tab-page][data-header-state="suspended"] .new-tab-search {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(-1rem);
      pointer-events: none;
    }

    [data-new-tab-page][data-header-state="suspended"] .new-tab-search {
      border-color: transparent;
    }

    html:has([data-new-tab-page][data-header-state="suspended"]) .new-tab-restore {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition:
        opacity 0.25s ease 0.12s,
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1) 0.12s,
        visibility 0s;
    }

    [data-shortcut-stack] .shortcut-item-shell {
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* 还没有分组时工具栏的添加入口先收起来——没有「加进哪个分组」的概念，空态里已有引导按钮 */
    [data-new-tab-page][data-has-groups="false"] [data-shortcut-add] {
      display: none;
    }

    /* 添加站点面板：从快捷方式区顶部落下来，缓动与全站同一条曲线 */
    [data-new-tab-page] .shortcut-item-add-form {
      animation: ntab-add-form-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes ntab-add-form-in {
      from {
        opacity: 0;
        transform: translateY(-0.45rem);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* 弧形布局：拼接画布固定为底部弧形坞，吃满视口全宽 */
    [data-new-tab-page] .new-tab-arc-dock {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      padding: 0 0.375rem 0.25rem;
    }

    /* ── item 卡片材质 ────────────────────────────────────────────────
       四层阴影叠出实物感：顶部受光边 + 1px 内描边 + 接触阴影 + 环境阴影。
       深浅仍由 data-item-tone 驱动（浅色文字配黑卡、深色文字配浅卡、默认跟随主题），
       但 tone / 主题 / 背景图只改写 --ntab-card-* 变量，材质与 hover 各只有一份规则，
       不再每个变体各写一套 background-color / border-color。 */
    [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: rgba(0, 0, 0, 0.05);
      --ntab-card-sheen: none;
      --ntab-card-ring: rgba(0, 0, 0, 0.08);
      --ntab-card-edge: rgba(255, 255, 255, 0.85);
      --ntab-card-contact: rgba(15, 23, 42, 0.05);
      --ntab-card-ambient: rgba(15, 23, 42, 0.1);
      --ntab-card-lift: 1;
      --ntab-card-focus: rgba(15, 23, 42, 0.55);
      --ntab-card-label-shadow: none;

      background-color: var(--ntab-card-bg);
      background-image: var(--ntab-card-sheen);
      border-color: transparent;
      box-shadow:
        inset 0 1px 0 0 var(--ntab-card-edge),
        inset 0 0 0 1px var(--ntab-card-ring),
        0 1px 2px -1px var(--ntab-card-contact),
        0 calc(13px * var(--ntab-card-lift)) calc(26px * var(--ntab-card-lift)) calc(-17px * var(--ntab-card-lift)) var(--ntab-card-ambient);
    }

    /* 悬停 / 聚焦：环境阴影放大做出「抬起来」的高度变化。
       下面是亮色页面浅灰卡的配色，深色变体各自覆盖。 */
    [data-shortcut-stack] .shortcut-item:hover,
    [data-shortcut-stack] .shortcut-item:focus-visible {
      --ntab-card-lift: 1.45;
      --ntab-card-bg: rgba(0, 0, 0, 0.075);
      --ntab-card-ring: rgba(0, 0, 0, 0.14);
      --ntab-card-edge: rgba(255, 255, 255, 1);
      --ntab-card-ambient: rgba(15, 23, 42, 0.17);
    }

    /* 键盘聚焦补一道轮廓环：走 outline，不参与阴影插值 */
    [data-shortcut-stack] .shortcut-item:focus-visible {
      outline: 1px solid var(--ntab-card-focus);
      outline-offset: 3px;
    }

    /* 按下回弹：位移归零 + 轻微缩小，模拟实体按键 */
    [data-shortcut-stack] .shortcut-item:active {
      transition-duration: 0.09s;
    }

    /* 图标不加底板：favicon 真实透出（用户定稿），hover 时只放大图标本身 */
    [data-shortcut-stack] .shortcut-item__icon {
      background-color: transparent;
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-shortcut-stack] .shortcut-item:hover .shortcut-item__icon,
    [data-shortcut-stack] .shortcut-item:focus-visible .shortcut-item__icon {
      transform: scale(1.05);
    }

    [data-shortcut-stack] .shortcut-item__label {
      text-shadow: var(--ntab-card-label-shadow);
    }

    /* 纯黑页面：深灰卡靠提亮与受光边分层，黑色阴影在纯黑上不可见，故留空 */
    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: rgba(255, 255, 255, 0.07);
      --ntab-card-sheen: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0) 72%);
      --ntab-card-ring: rgba(255, 255, 255, 0.09);
      --ntab-card-edge: rgba(255, 255, 255, 0.1);
      --ntab-card-contact: rgba(0, 0, 0, 0);
      --ntab-card-ambient: rgba(0, 0, 0, 0);
      --ntab-card-focus: rgba(255, 255, 255, 0.6);
    }

    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item:focus-visible {
      --ntab-card-bg: rgba(255, 255, 255, 0.13);
      --ntab-card-ring: rgba(255, 255, 255, 0.26);
      --ntab-card-edge: rgba(255, 255, 255, 0.16);
    }

    /* 亮色页面上的黑卡用实底近纯黑，顶部一道受光渐变；阴影落回浅色背景 */
    html[data-item-tone="dark"][data-theme="light"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: rgba(8, 9, 12, 0.97);
      --ntab-card-sheen: linear-gradient(180deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0) 68%);
      --ntab-card-ring: rgba(255, 255, 255, 0.1);
      --ntab-card-edge: rgba(255, 255, 255, 0.11);
      --ntab-card-contact: rgba(8, 9, 12, 0.16);
      --ntab-card-ambient: rgba(8, 9, 12, 0.26);
      --ntab-card-focus: rgba(8, 9, 12, 0.6);
    }

    html[data-item-tone="dark"][data-theme="light"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-item-tone="dark"][data-theme="light"] [data-shortcut-stack] .shortcut-item:focus-visible {
      --ntab-card-bg: rgba(24, 26, 32, 0.98);
      --ntab-card-ring: rgba(255, 255, 255, 0.22);
      --ntab-card-edge: rgba(255, 255, 255, 0.15);
      --ntab-card-ambient: rgba(8, 9, 12, 0.36);
    }

    /* 暗色页面上的浅卡用白色提亮，黑 5% 在纯黑上不可见 */
    html[data-item-tone="light"][data-theme="black"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: rgba(255, 255, 255, 0.08);
      --ntab-card-sheen: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0) 72%);
      --ntab-card-ring: rgba(255, 255, 255, 0.1);
      --ntab-card-edge: rgba(255, 255, 255, 0.12);
      --ntab-card-contact: rgba(0, 0, 0, 0);
      --ntab-card-ambient: rgba(0, 0, 0, 0);
      --ntab-card-focus: rgba(255, 255, 255, 0.6);
    }

    html[data-item-tone="light"][data-theme="black"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-item-tone="light"][data-theme="black"] [data-shortcut-stack] .shortcut-item:focus-visible {
      --ntab-card-bg: rgba(255, 255, 255, 0.13);
      --ntab-card-ring: rgba(255, 255, 255, 0.28);
      --ntab-card-edge: rgba(255, 255, 255, 0.18);
    }

    /* 黑卡上的副标题改浅色，避免深灰小字压深卡看不清 */
    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item__label small {
      color: rgba(255, 255, 255, 0.6) !important;
    }

    /* 有背景图时改为半透明卡片：黑卡压暗照片、白卡提亮照片；
       照片上文字补一道投影，标题与说明都保住可读性 */
    html[data-item-tone="dark"][data-new-tab-background="true"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: rgba(0, 0, 0, 0.58);
      --ntab-card-sheen: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 70%);
      --ntab-card-ring: rgba(255, 255, 255, 0.14);
      --ntab-card-edge: rgba(255, 255, 255, 0.16);
      --ntab-card-contact: rgba(0, 0, 0, 0.28);
      --ntab-card-ambient: rgba(0, 0, 0, 0.34);
      --ntab-card-focus: rgba(255, 255, 255, 0.65);
      --ntab-card-label-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
    }

    html[data-item-tone="dark"][data-new-tab-background="true"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-item-tone="dark"][data-new-tab-background="true"] [data-shortcut-stack] .shortcut-item:focus-visible {
      --ntab-card-bg: rgba(0, 0, 0, 0.74);
      --ntab-card-ring: rgba(255, 255, 255, 0.3);
      --ntab-card-edge: rgba(255, 255, 255, 0.22);
      --ntab-card-ambient: rgba(0, 0, 0, 0.44);
    }

    html[data-item-tone="light"][data-new-tab-background="true"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: rgba(255, 255, 255, 0.62);
      --ntab-card-sheen: linear-gradient(180deg, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0) 70%);
      --ntab-card-ring: rgba(0, 0, 0, 0.08);
      --ntab-card-edge: rgba(255, 255, 255, 0.9);
      --ntab-card-contact: rgba(15, 23, 42, 0.08);
      --ntab-card-ambient: rgba(15, 23, 42, 0.18);
      --ntab-card-focus: rgba(15, 23, 42, 0.6);
    }

    html[data-item-tone="light"][data-new-tab-background="true"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-item-tone="light"][data-new-tab-background="true"] [data-shortcut-stack] .shortcut-item:focus-visible {
      --ntab-card-bg: rgba(255, 255, 255, 0.78);
      --ntab-card-ring: rgba(0, 0, 0, 0.16);
      --ntab-card-ambient: rgba(15, 23, 42, 0.24);
    }

    /* 悬浮提示跟随 item 卡片深浅：文字颜色模式强制换色后，浮层底色同步切换，标题和说明都保持可读 */
    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item__tooltip {
      background-color: rgba(8, 9, 12, 0.97) !important;
      border-color: rgba(255, 255, 255, 0.16) !important;
      color: rgba(255, 255, 255, 0.92) !important;
    }

    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item__tooltip::after {
      background-color: rgba(8, 9, 12, 0.97) !important;
      border-color: rgba(255, 255, 255, 0.16) !important;
    }

    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item__tooltip small {
      color: rgba(255, 255, 255, 0.6) !important;
    }

    html[data-item-tone="light"] [data-shortcut-stack] .shortcut-item__tooltip {
      background-color: rgba(255, 255, 255, 0.97) !important;
      border-color: rgba(0, 0, 0, 0.12) !important;
      color: rgba(17, 24, 39, 0.92) !important;
    }

    html[data-item-tone="light"] [data-shortcut-stack] .shortcut-item__tooltip::after {
      background-color: rgba(255, 255, 255, 0.97) !important;
      border-color: rgba(0, 0, 0, 0.12) !important;
    }

    html[data-item-tone="light"] [data-shortcut-stack] .shortcut-item__tooltip small {
      color: rgba(17, 24, 39, 0.6) !important;
    }

    /* 刷新入场：快捷方式瓦片逐个弹出（序号 × 24ms 错峰，上限 360ms），自下而上浮到位并带轻微缩放——
       new-tab 的"窗"感来源。backwards 只在动画期间生效，结束后交还给常规级联，
       避免盖掉 FLIP 与收起态的行内 transform。 */
    [data-shortcut-stack] .ntab-pop > .shortcut-item,
    [data-shortcut-stack] .shortcut-item.ntab-pop {
      animation: ntab-pop-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: var(--ntab-delay, 0ms);
    }

    @keyframes ntab-pop-in {
      from {
        opacity: 0;
        transform: translateY(0.9rem) scale(0.94);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      [data-new-tab-page] *,
      [data-new-tab-page] *::before,
      [data-new-tab-page] *::after {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-delay: 0ms !important;
      }
    }
  </style>

  <script>
    // @ts-nocheck
    import { META_PROXY_ORIGIN } from "../data/meta-proxy";
    const defaultPayloadElement = document.getElementById("new-tab-defaults");
    const defaultPayload = defaultPayloadElement?.textContent
      ? JSON.parse(defaultPayloadElement.textContent)
      : {};

    const cloneValue = (value) => {
      if (typeof structuredClone === "function") {
        return structuredClone(value);
      }

      return JSON.parse(JSON.stringify(value));
    };

    const configVersion = 7;
    const defaultBackgroundOpacity = 60;
    const oldDefaultBackgroundOpacities = [34, 50];
    const storageQuotaErrorMessage = "配置过大，超出本地存储上限，无法保存；请压缩背景图或精简数据";
    const defaultTextColors = {
      mode: "default",
    };

    const defaultState = () => ({
      version: configVersion,
      userName: defaultPayload.config?.userName ?? "Ethanz888",
      backgroundImage: "",
      backgroundOpacity: defaultBackgroundOpacity,
      textColors: cloneValue(defaultTextColors),
      defaultSearchEngineId: defaultPayload.config?.search?.defaultEngineId ?? "google",
      homeLink: cloneValue(defaultPayload.config?.homeLink ?? { label: "资料卡首页", href: "/" }),
      shortcutOpenMode: "current",
      greetings: cloneValue(defaultPayload.config?.greetings ?? []),
      searchEngines: cloneValue(defaultPayload.searchEngines ?? []),
      shortcutGroups: cloneValue(defaultPayload.shortcutGroups ?? []),
      shortcutLayout: "grid",
      scatterSeed: Math.floor(Math.random() * 1000000000) + 1,
      headerCollapsed: false,
      headerSuspended: false,
    });

    const storageKey = defaultPayload.config?.storageKey ?? "ethanz-new-tab-config";
    const layoutLabels = {
      grid: "网格",
      stack: "堆叠",
      ring: "弧形",
      scatter: "随机",
    };
    const logoCacheStorageKey = `${storageKey}:logo-cache`;
    // v5→v6：缓存里的 logoUrl 存的是代理地址，读出来会被再套一层代理（522）；
    // 同时 canProxyUrl 补齐环回/链路本地拦截、候选链补 1Panel 与按目录探测，旧条目全部作废重建。
    const logoResolverVersion = 6;
    const settingsLabels = defaultPayload.config?.settings ?? {};
    let newTabState = defaultState();
    let activeDragPayload = null;
    let textColorSaveTimer = 0;
    let shortcutLogoCache = {};
    let activeShortcutContextMenu = null;
    const shortcutLogoRequests = new Map();
    const onePanelLogoDataUrl = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 33 33" fill="#3370ff"><path d="M19.42 4.842 7.785 11.56v10.064l7.539 4.353-2.921 1.686-7.54-4.353V9.874L16.5 3.156z"/><path d="m20.598 5.522-2.921 1.686 7.539 4.352v10.064l2.92 1.686V9.874zM16.922 9.328l.892.532v13.666l-.892.515zM12.523 11.862l4.399-2.534-.002 14.714-2.848-1.644v-8.82h-1.549z"/><path fill-rule="evenodd" d="M3 8.796 16.5 1 30 8.796v15.592l-13.5 7.796L3 24.388zm26.64.208L16.5 1.417V1.41L3.357 8.997v15.182L16.5 31.772l13.141-7.587z" clip-rule="evenodd"/></svg>')}`;

    const isPlainObject = (value) =>
      value !== null && typeof value === "object" && !Array.isArray(value);

    const normalizeText = (value, fallback = "") =>
      typeof value === "string" && value.trim() ? value.trim() : fallback;

    const normalizeMaybeText = (value) =>
      typeof value === "string" && value.trim() ? value.trim() : undefined;

    const normalizeShortcutOpenMode = (value, fallback = "current") =>
      value === "newTab" || value === "current" ? value : fallback;

    const shortcutLayoutIds = ["grid", "stack", "ring", "scatter"];

    const normalizeShortcutLayout = (value, fallback = "grid") =>
      shortcutLayoutIds.includes(value) ? value : fallback;

    const normalizeScatterSeed = (value, fallback = 1) => {
      const seed = Number(value);

      return Number.isFinite(seed) && seed > 0 ? Math.floor(seed) : fallback;
    };

    const normalizeTextColors = (value, fallback) => {
      const mode = isPlainObject(value) && ["default", "light", "dark"].includes(value.mode)
        ? value.mode
        : fallback.mode;

      return { mode };
    };

    const normalizeGreetings = (greetings, fallback) => {
      if (!Array.isArray(greetings)) {
        return cloneValue(fallback);
      }

      const normalized = greetings
        .map((item) => ({
          label: normalizeText(item?.label),
          from: Number(item?.from),
          to: Number(item?.to),
        }))
        .filter((item) =>
          item.label &&
          Number.isInteger(item.from) &&
          Number.isInteger(item.to) &&
          item.from >= 0 &&
          item.from <= 23 &&
          item.to >= 0 &&
          item.to <= 23
        );

      return normalized.length ? normalized : cloneValue(fallback);
    };

    const normalizeSearchEngines = (engines, fallback) => {
      if (!Array.isArray(engines)) {
        return cloneValue(fallback);
      }

      const ids = new Set();
      const normalized = engines
        .map((engine) => ({
          id: normalizeText(engine?.id),
          label: normalizeText(engine?.label),
          searchUrl: normalizeText(engine?.searchUrl),
        }))
        .filter((engine) => {
          if (!engine.id || !engine.label || !engine.searchUrl.includes("{query}") || ids.has(engine.id)) {
            return false;
          }

          ids.add(engine.id);
          return true;
        });

      return normalized.length ? normalized : cloneValue(fallback);
    };

    // 历史配置里 shortcut.logo 可能存的是代理地址（v5 及以前写坏的），
    // 导入时直接还原成裸址，否则每次渲染都会再套一层代理。
    // 按 host 判定而不是前缀字符串，缓存里可能是 /?url=（带斜杠）也可能不是。
    const normalizeShortcutLogo = (logo) => {
      const value = normalizeMaybeText(logo);

      if (!value) {
        return value;
      }

      let current = value;

      for (let round = 0; round < 4; round += 1) {
        let parsed;
        try {
          parsed = new URL(current);
        } catch {
          return current;
        }

        if (parsed.origin !== META_PROXY_ORIGIN || parsed.pathname !== "/") {
          return current;
        }

        const inner = normalizeMaybeText(parsed.searchParams.get("url"));
        if (!inner) {
          return current;
        }

        current = inner;
      }

      return current;
    };

    const normalizeShortcutGroups = (groups, fallback) => {
      if (!Array.isArray(groups)) {
        return cloneValue(fallback);
      }

      const normalized = groups
        .map((group) => ({
          title: normalizeText(group?.title),
          shortcuts: Array.isArray(group?.shortcuts)
            ? group.shortcuts
                .map((shortcut) => ({
                  title: normalizeText(shortcut?.title),
                  url: normalizeText(shortcut?.url),
                  description: normalizeMaybeText(shortcut?.description),
                  logo: normalizeShortcutLogo(shortcut?.logo),
                }))
                .filter((shortcut) => shortcut.title && shortcut.url)
            : [],
        }))
        .filter((group) => group.title);

      return normalized.length ? normalized : cloneValue(fallback);
    };

    const normalizeHomeLink = (homeLink, fallback) => {
      if (!isPlainObject(homeLink)) {
        return cloneValue(fallback);
      }

      return {
        label: normalizeText(homeLink.label, fallback.label),
        href: normalizeText(homeLink.href, fallback.href),
      };
    };

    const normalizeNewTabState = (value) => {
      const fallback = defaultState();

      if (!isPlainObject(value)) {
        return fallback;
      }

      const searchEngines = normalizeSearchEngines(value.searchEngines, fallback.searchEngines);
      const defaultSearchEngineId = normalizeText(
        value.defaultSearchEngineId ?? value.search?.defaultEngineId,
        fallback.defaultSearchEngineId,
      );

      return {
        version: configVersion,
        userName: normalizeText(value.userName, fallback.userName),
        backgroundImage: typeof value.backgroundImage === "string" ? value.backgroundImage.trim() : "",
        backgroundOpacity: Number.isFinite(Number(value.backgroundOpacity))
          ? Math.min(100, Math.max(0, Number(value.backgroundOpacity)))
          : fallback.backgroundOpacity,
        textColors: normalizeTextColors(value.textColors, fallback.textColors),
        defaultSearchEngineId: searchEngines.some((engine) => engine.id === defaultSearchEngineId)
          ? defaultSearchEngineId
          : searchEngines[0]?.id ?? fallback.defaultSearchEngineId,
        homeLink: normalizeHomeLink(value.homeLink, fallback.homeLink),
        shortcutOpenMode: normalizeShortcutOpenMode(value.shortcutOpenMode, fallback.shortcutOpenMode),
        greetings: normalizeGreetings(value.greetings, fallback.greetings),
        searchEngines,
        shortcutGroups: normalizeShortcutGroups(value.shortcutGroups, fallback.shortcutGroups),
        shortcutLayout: normalizeShortcutLayout(value.shortcutLayout),
        scatterSeed: normalizeScatterSeed(value.scatterSeed),
        headerCollapsed: value.headerCollapsed === true,
        headerSuspended: value.headerSuspended === true,
      };
    };

    const readStoredState = () => {
      try {
        const storedConfig = window.localStorage.getItem(storageKey);

        if (!storedConfig) {
          return defaultState();
        }

        const parsedConfig = JSON.parse(storedConfig);
        const storedState = normalizeNewTabState(parsedConfig);

        if (Number(parsedConfig?.version ?? 1) < configVersion) {
          storedState.shortcutGroups = [];
          window.localStorage.setItem(storageKey, JSON.stringify(storedState));
        }

        if (
          Number(parsedConfig?.version ?? 1) < configVersion &&
          oldDefaultBackgroundOpacities.includes(storedState.backgroundOpacity)
        ) {
          storedState.backgroundOpacity = defaultBackgroundOpacity;
          window.localStorage.setItem(storageKey, JSON.stringify(storedState));
        }

        return storedState;
      } catch {
        return defaultState();
      }
    };

    const writeStoredState = () => {
      try {
        window.localStorage.setItem(storageKey, JSON.stringify(newTabState));
        return true;
      } catch (error) {
        if (error && error.name === "QuotaExceededError") {
          return false;
        }

        // The page still works with the in-memory config when storage is unavailable.
        return true;
      }
    };

    const readShortcutLogoCache = () => {
      try {
        const cache = JSON.parse(window.localStorage.getItem(logoCacheStorageKey) ?? "{}");

        return isPlainObject(cache) ? cache : {};
      } catch {
        return {};
      }
    };

    const writeShortcutLogoCache = () => {
      try {
        window.localStorage.setItem(logoCacheStorageKey, JSON.stringify(shortcutLogoCache));
      } catch {
        // Logo discovery is an enhancement; shortcuts still work without the cache.
      }
    };

    const getShortcutHostname = (url) => {
      try {
        return new URL(url).hostname.replace(/^www\./, "");
      } catch {
        return url;
      }
    };

    const getShortcutInitial = (title) => title.trim().slice(0, 1).toUpperCase();

    const normalizeShortcutUrlInput = (value) => {
      const url = normalizeText(value);

      if (!url) {
        return "";
      }

      if (/^(https?:|mailto:|tel:|\/|#)/i.test(url)) {
        return url;
      }

      return `https://${url}`;
    };

    const isValidShortcutUrl = (url) => {
      if (/^(\/|#)/.test(url)) {
        return true;
      }

      try {
        new URL(url);
        return true;
      } catch {
        return false;
      }
    };

    const focusFirstInput = (element) => {
      element.querySelector("input")?.focus();
    };

    const setInlineFormError = (target, message) => {
      target.textContent = message;
      target.classList.remove("hidden");
    };

    const clearInlineFormError = (target) => {
      target.textContent = "";
      target.classList.add("hidden");
    };

    const getIconMarkup = (name) => {
      const template = document.querySelector(`template[data-new-tab-icon="${name}"]`);

      return template instanceof HTMLTemplateElement ? template.innerHTML.trim() : "";
    };

    const createIconButton = (label, iconName, extraClasses = "") => {
      const button = document.createElement("button");
      button.className = `btn btn-square btn-ghost btn-xs h-8 min-h-8 w-8 p-0 text-base-content/60 transition hover:text-base-content focus-visible:text-base-content [&_svg]:h-3.5 [&_svg]:w-3.5 ${extraClasses}`;
      button.type = "button";
      button.title = label;
      button.setAttribute("aria-label", label);
      button.innerHTML = getIconMarkup(iconName);
      return button;
    };

    const closeShortcutContextMenu = () => {
      activeShortcutContextMenu?.remove();
      activeShortcutContextMenu = null;
    };

    const getContextMenuPoint = (event, fallbackElement) => {
      if (event instanceof MouseEvent && Number.isFinite(event.clientX) && Number.isFinite(event.clientY)) {
        return {
          x: event.clientX,
          y: event.clientY,
        };
      }

      const rect = fallbackElement?.getBoundingClientRect();
      return {
        x: rect ? rect.left + rect.width / 2 : window.innerWidth / 2,
        y: rect ? rect.bottom + 8 : window.innerHeight / 2,
      };
    };

    const positionShortcutContextMenu = (menu, point) => {
      const margin = 12;
      const rect = menu.getBoundingClientRect();
      const maxLeft = Math.max(margin, window.innerWidth - rect.width - margin);
      const maxTop = Math.max(margin, window.innerHeight - rect.height - margin);

      menu.style.left = `${Math.min(Math.max(point.x, margin), maxLeft)}px`;
      menu.style.top = `${Math.min(Math.max(point.y, margin), maxTop)}px`;
    };

    const openShortcutContextMenu = ({ event, fallbackElement, title, subtitle, actions }) => {
      event?.preventDefault();
      event?.stopPropagation();
      closeShortcutContextMenu();

      const menu = document.createElement("div");
      menu.className = "shortcut-context-menu fixed z-[90] grid min-w-44 max-w-[18rem] gap-1 border border-base-content/15 bg-base-100 p-1.5 text-sm text-base-content shadow-[0_12px_36px_rgba(0,0,0,0.12)] outline-none";
      menu.setAttribute("role", "menu");
      menu.tabIndex = -1;

      const header = document.createElement("div");
      header.className = "grid border-b border-base-content/10 px-2 py-1.5";
      const headerText = document.createElement("span");
      headerText.className = "grid min-w-0 gap-0.5";
      const headerTitle = document.createElement("strong");
      headerTitle.className = "truncate text-xs font-bold leading-tight";
      headerTitle.textContent = title;
      headerText.append(headerTitle);

      if (subtitle) {
        const headerSubtitle = document.createElement("small");
        headerSubtitle.className = "truncate text-[0.68rem] font-semibold leading-tight text-base-content/45";
        headerSubtitle.textContent = subtitle;
        headerText.append(headerSubtitle);
      }

      header.append(headerText);
      menu.append(header);

      actions.forEach((action) => {
        const button = document.createElement("button");
        button.className = action.danger
          ? "grid h-9 grid-cols-[1rem_minmax(0,1fr)] items-center gap-2 rounded-[0.15rem] border-0 bg-transparent px-2 text-left text-error/80 transition hover:bg-error/10 focus-visible:bg-error/10 focus-visible:outline-none"
          : "grid h-9 grid-cols-[1rem_minmax(0,1fr)] items-center gap-2 rounded-[0.15rem] border-0 bg-transparent px-2 text-left text-base-content/75 transition hover:bg-base-200 focus-visible:bg-base-200 focus-visible:outline-none";
        button.type = "button";
        button.setAttribute("role", "menuitem");
        button.innerHTML = `<span class="grid h-4 w-4 place-items-center [&_svg]:h-3.5 [&_svg]:w-3.5">${getIconMarkup(action.icon)}</span><span class="truncate text-xs font-semibold">${action.label}</span>`;
        button.addEventListener("click", () => {
          closeShortcutContextMenu();
          action.onSelect();
        });
        menu.append(button);
      });

      document.body.append(menu);
      activeShortcutContextMenu = menu;
      positionShortcutContextMenu(menu, getContextMenuPoint(event, fallbackElement));
      menu.focus({ preventScroll: true });
    };

    const createShortcutEmptyState = () => {
      const empty = document.createElement("div");
      empty.className = "shortcut-empty grid place-items-center gap-3.5 border border-dashed border-base-content/15 px-6 py-12 text-center";

      const title = document.createElement("p");
      title.className = "m-0 text-sm font-medium leading-relaxed text-base-content/50";
      title.textContent = "还没有快捷入口，先把常用的网站加进来";

      const action = document.createElement("button");
      action.className = "btn btn-sm h-9 min-h-9 gap-1.5 border border-base-content/20 bg-transparent px-4 text-[0.82rem] font-medium text-base-content/60 hover:border-base-content/40 hover:bg-transparent hover:text-base-content";
      action.type = "button";
      action.innerHTML = `<span class="grid h-3.5 w-3.5 place-items-center [&_svg]:h-3.5 [&_svg]:w-3.5">${getIconMarkup("plus")}</span><span>开始添加</span>`;
      action.addEventListener("click", () => {
        const form = createGroupAddForm();
        empty.replaceWith(form);
        focusFirstInput(form);
      });

      empty.append(title, action);
      return empty;
    };

    const bindShortcutContextMenuDismissal = () => {
      if (document.documentElement.dataset.newTabContextMenuBound === "true") {
        return;
      }

      document.addEventListener("pointerdown", (event) => {
        if (
          activeShortcutContextMenu &&
          event.target instanceof Node &&
          !activeShortcutContextMenu.contains(event.target)
        ) {
          closeShortcutContextMenu();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeShortcutContextMenu();
        }
      });

      window.addEventListener("resize", closeShortcutContextMenu);
      window.addEventListener("scroll", closeShortcutContextMenu, true);
      document.documentElement.dataset.newTabContextMenuBound = "true";
    };

    // 记住上次加进哪个分组，下次从工具栏进来默认还是它
    let lastShortcutAddGroupTitle = "";

    const createShortcutAddForm = (group) => {
      const form = document.createElement("form");
      form.className = "shortcut-item-add-form col-span-full grid w-full max-w-[min(100%,24rem)] gap-3 border border-base-content/10 bg-base-100/95 p-3.5 shadow-[0_10px_36px_rgba(0,0,0,0.12)] backdrop-blur";

      // 标题栏：一句话说明 + 关闭钮，让这块面板自己会说话
      const header = document.createElement("div");
      header.className = "flex items-center justify-between gap-2";
      const heading = document.createElement("p");
      heading.className = "m-0 text-[0.82rem] font-semibold leading-tight";
      heading.textContent = settingsLabels.addShortcutLabel ?? "添加站点";
      const dismissButton = document.createElement("button");
      dismissButton.className = "btn btn-square btn-ghost btn-xs h-7 min-h-7 w-7 p-0 text-base-content/50 transition hover:text-base-content";
      dismissButton.type = "button";
      dismissButton.setAttribute("aria-label", "取消添加");
      dismissButton.title = "取消";
      dismissButton.innerHTML = getIconMarkup("close");
      header.append(heading, dismissButton);

      const fields = document.createElement("div");
      fields.className = "grid min-w-0 gap-2.5";

      let targetGroup = group;
      const syncAddTarget = () => {
        form.setAttribute("aria-label", `${settingsLabels.addShortcutLabel ?? "添加站点"}：${targetGroup.title}`);
        lastShortcutAddGroupTitle = targetGroup.title;
      };

      // 有多个分组时表单自带分组选择：入口在工具栏，得让用户看得见加进哪一组
      if (newTabState.shortcutGroups.length > 1) {
        const groupSelectLabel = document.createElement("label");
        groupSelectLabel.className = "sr-only";
        groupSelectLabel.textContent = "所属分组";

        const groupSelect = document.createElement("select");
        groupSelect.className = "select select-bordered select-sm h-9 min-h-9 w-full bg-base-100/80 text-xs";
        groupSelect.setAttribute("aria-label", "所属分组");

        newTabState.shortcutGroups.forEach((item, index) => {
          const option = document.createElement("option");
          option.value = String(index);
          option.textContent = item.title;
          groupSelect.append(option);
        });

        groupSelect.value = String(Math.max(0, newTabState.shortcutGroups.indexOf(group)));
        groupSelect.addEventListener("change", () => {
          targetGroup = newTabState.shortcutGroups[Number(groupSelect.value)] ?? targetGroup;
          syncAddTarget();
        });

        fields.append(groupSelectLabel, groupSelect);
      }

      syncAddTarget();

      // 图标预览：地址解析出 logo 前先显示站点首字母，拿到后真实透出 favicon
      const preview = document.createElement("div");
      preview.className = "flex items-center gap-2.5";
      const previewIcon = document.createElement("span");
      previewIcon.className = "shortcut-item__icon relative grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-md border border-base-content/10 bg-base-200/60";
      previewIcon.setAttribute("aria-hidden", "true");
      const previewImage = document.createElement("img");
      previewImage.className = "hidden h-full w-full object-contain p-[0.3rem]";
      previewImage.alt = "";
      previewImage.referrerPolicy = "no-referrer";
      const previewInitial = document.createElement("span");
      previewInitial.className = "text-[0.95rem] font-bold leading-none text-base-content/60";
      previewInitial.textContent = "?";
      previewIcon.append(previewImage, previewInitial);
      const previewText = document.createElement("div");
      previewText.className = "grid min-w-0 gap-0.5";
      const previewTitle = document.createElement("p");
      previewTitle.className = "m-0 truncate text-[0.82rem] font-medium leading-tight";
      previewTitle.textContent = "新站点";
      const previewHint = document.createElement("p");
      previewHint.className = "m-0 truncate text-[0.72rem] leading-tight text-base-content/45";
      previewHint.textContent = "填地址后自动识别名称与图标";
      previewText.append(previewTitle, previewHint);
      preview.append(previewIcon, previewText);
      fields.append(preview);

      const fieldRow = (labelText, inputEl) => {
        const row = document.createElement("label");
        row.className = "grid min-w-0 gap-1";
        const rowLabel = document.createElement("span");
        rowLabel.className = "text-[0.72rem] font-medium text-base-content/55";
        rowLabel.textContent = labelText;
        row.append(rowLabel, inputEl);
        return row;
      };

      const titleInput = document.createElement("input");
      titleInput.className = "input input-bordered input-sm h-9 min-h-9 w-full min-w-0 bg-base-100/80 text-xs";
      titleInput.type = "text";
      titleInput.autocomplete = "off";
      titleInput.setAttribute("aria-label", settingsLabels.shortcutTitleLabel ?? "名称");
      titleInput.placeholder = settingsLabels.shortcutTitleLabel ?? "名称";

      const urlInput = document.createElement("input");
      urlInput.className = "input input-bordered input-sm h-9 min-h-9 w-full min-w-0 bg-base-100/80 text-xs";
      urlInput.type = "text";
      urlInput.inputMode = "url";
      urlInput.autocomplete = "off";
      urlInput.setAttribute("aria-label", settingsLabels.shortcutUrlLabel ?? "地址");
      urlInput.placeholder = "example.com";

      fields.append(fieldRow(settingsLabels.shortcutTitleLabel ?? "名称", titleInput));
      fields.append(fieldRow(settingsLabels.shortcutUrlLabel ?? "地址", urlInput));

      const error = document.createElement("p");
      error.className = "hidden text-[0.72rem] leading-snug text-error";

      let shortcutMetadataRequestId = 0;
      let shortcutMetadataTimer = 0;
      let shortcutMetadata = null;

      const footer = document.createElement("div");
      footer.className = "flex items-center justify-end gap-1.5";
      const cancelButton = document.createElement("button");
      cancelButton.className = "btn btn-ghost btn-sm h-8 min-h-8 px-3 text-xs text-base-content/60 transition hover:text-base-content";
      cancelButton.type = "button";
      cancelButton.textContent = "取消";
      const submitButton = document.createElement("button");
      submitButton.className = "btn btn-sm h-8 min-h-8 border-0 bg-base-content px-4 text-xs text-base-100 transition hover:bg-base-content/85 focus-visible:bg-base-content/85";
      submitButton.type = "submit";
      submitButton.textContent = "添加";
      footer.append(cancelButton, submitButton);

      const applyShortcutMetadata = (metadata) => {
        shortcutMetadata = metadata;

        // 图标预览跟随解析结果
        const logoUrl = metadata?.logoUrl ?? metadata?.candidates?.[0] ?? "";
        if (logoUrl) {
          previewImage.src = logoUrl;
          previewImage.classList.remove("hidden");
          previewInitial.classList.add("hidden");
        }

        // 预览标题同步（用户已填名称时不抢）
        if (!normalizeText(titleInput.value)) {
          const suggestedTitle = metadata?.title || getShortcutHostname(normalizeShortcutUrlInput(urlInput.value));

          if (suggestedTitle) {
            titleInput.value = suggestedTitle;
            previewTitle.textContent = suggestedTitle;
            clearInlineFormError(error);
          }
        } else {
          previewTitle.textContent = normalizeText(titleInput.value);
        }
      };

      const syncShortcutMetadata = () => {
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (!url || !isValidShortcutUrl(url) || !isRemoteUrl(url)) {
          return Promise.resolve(null);
        }

        const requestId = shortcutMetadataRequestId + 1;
        shortcutMetadataRequestId = requestId;

        return fetchShortcutMetadata({ url }).then((metadata) => {
          if (requestId !== shortcutMetadataRequestId || normalizeShortcutUrlInput(urlInput.value) !== url) {
            return null;
          }

          applyShortcutMetadata(metadata);
          return metadata;
        });
      };

      const scheduleShortcutMetadataSync = () => {
        window.clearTimeout(shortcutMetadataTimer);
        shortcutMetadataTimer = window.setTimeout(syncShortcutMetadata, 550);
      };

      const dismiss = () => {
        renderShortcutGroups();
      };

      dismissButton.addEventListener("click", dismiss);
      cancelButton.addEventListener("click", dismiss);

      titleInput.addEventListener("input", () => {
        previewTitle.textContent = normalizeText(titleInput.value) || "新站点";
        previewInitial.textContent = getShortcutInitial(titleInput.value) || "?";
        clearInlineFormError(error);
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (!url) {
          setInlineFormError(error, "先输入地址");
          urlInput.focus();
          return;
        }

        if (!isValidShortcutUrl(url)) {
          setInlineFormError(error, "地址格式不对");
          urlInput.focus();
          return;
        }

        let title = normalizeText(titleInput.value);
        let metadata = shortcutMetadata;

        if (isRemoteUrl(url) && !metadata) {
          submitButton.disabled = true;
          setInlineFormError(error, title ? "正在解析图标" : "正在解析标题");
          metadata = await syncShortcutMetadata();
          title = normalizeText(titleInput.value, metadata?.title ?? "");
          submitButton.disabled = false;
        }

        if (!title) {
          setInlineFormError(error, "先输入名称");
          titleInput.focus();
          return;
        }

        const logo = metadata?.logoUrl;
        const description = metadata?.description;
        targetGroup.shortcuts.push({
          title,
          url,
          ...(description ? { description } : {}),
          ...(logo ? { logo } : {}),
        });
        persistConfigChange("已添加");
      });

      [titleInput, urlInput].forEach((input) => {
        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            event.preventDefault();
            dismiss();
          }
        });
      });

      // 地址框回车：先去补名称（元数据还没到就停在原地），别直接提交半成品
      urlInput.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") {
          return;
        }
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (url && isValidShortcutUrl(url) && !normalizeText(titleInput.value)) {
          event.preventDefault();
          titleInput.focus();
        }
      });

      urlInput.addEventListener("input", () => {
        shortcutMetadata = null;
        previewImage.classList.add("hidden");
        previewImage.removeAttribute("src");
        previewInitial.classList.remove("hidden");
        previewInitial.textContent = "?";
        previewHint.textContent = "填地址后自动识别名称与图标";
        scheduleShortcutMetadataSync();
      });
      urlInput.addEventListener("blur", syncShortcutMetadata);
      urlInput.addEventListener("change", syncShortcutMetadata);

      form.append(header, fields, error, footer);
      return form;
    };

    // 添加入口只有工具栏一处（原先挂在每组末尾、悬停才浮现的「+」瓦片已去掉）：
    // 表单统一插到快捷方式区顶部，避免在弧形/随机画布里被绝对定位的瓦片压住。
    const openShortcutAddForm = (group) => {
      const stack = document.querySelector("[data-shortcut-stack]");

      if (!(stack instanceof HTMLElement)) {
        return;
      }

      // 入口常驻，重复点很容易：已经开着就只改目标分组 + 送回焦点，不叠第二份表单
      const existing = stack.querySelector(".shortcut-item-add-form");

      if (existing instanceof HTMLFormElement) {
        const targetIndex = group ? newTabState.shortcutGroups.indexOf(group) : -1;
        const existingSelect = existing.querySelector("select");

        if (targetIndex >= 0 && existingSelect instanceof HTMLSelectElement) {
          existingSelect.value = String(targetIndex);
          existingSelect.dispatchEvent(new Event("change", { bubbles: true }));
        }

        existing.scrollIntoView({ block: "nearest" });
        focusFirstInput(existing);
        return;
      }

      const groups = newTabState.shortcutGroups;
      const target = group ?? groups.find((item) => item.title === lastShortcutAddGroupTitle) ?? groups[0];

      if (!target) {
        return;
      }

      const form = createShortcutAddForm(target);
      stack.prepend(form);
      form.scrollIntoView({ block: "nearest" });
      focusFirstInput(form);
    };

    const createShortcutEditForm = (group, shortcut) => {
      const form = document.createElement("form");
      form.className = "shortcut-item-edit-form grid w-full max-w-[min(100%,24rem)] grid-cols-[minmax(0,1fr)_auto_auto] items-start gap-1.5 border border-base-content/10 bg-base-100/90 p-2 backdrop-blur";
      form.setAttribute("aria-label", `修改 item：${shortcut.title}`);

      const fields = document.createElement("div");
      fields.className = "grid min-w-0 gap-1";

      const createInput = (label, value, inputMode = "text") => {
        const inputLabel = document.createElement("label");
        inputLabel.className = "sr-only";
        inputLabel.textContent = label;
        const input = document.createElement("input");
        input.className = "input input-bordered input-xs h-8 min-w-0 bg-base-100/80 text-xs";
        input.type = "text";
        input.inputMode = inputMode;
        input.autocomplete = "off";
        input.placeholder = label;
        input.value = value ?? "";
        input.setAttribute("aria-label", label);
        fields.append(inputLabel, input);
        return input;
      };

      const titleInput = createInput(settingsLabels.shortcutTitleLabel ?? "名称", shortcut.title);
      const urlInput = createInput(settingsLabels.shortcutUrlLabel ?? "地址", shortcut.url, "url");
      const descriptionInput = createInput(settingsLabels.shortcutDescriptionLabel ?? "说明", shortcut.description ?? "");
      const logoInput = createInput(settingsLabels.shortcutLogoLabel ?? "图标 URL", shortcut.logo ?? "", "url");

      const error = document.createElement("p");
      error.className = "hidden text-[0.72rem] leading-snug text-error";
      fields.append(error);

      const submitButton = createIconButton("保存", "check", "text-success/75 hover:text-success");
      submitButton.type = "submit";
      const cancelButton = createIconButton("取消", "close");
      let shortcutMetadataRequestId = 0;
      let shortcutMetadata = null;

      const syncShortcutMetadata = () => {
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (!url || !isValidShortcutUrl(url) || !isRemoteUrl(url)) {
          return Promise.resolve(null);
        }

        const requestId = shortcutMetadataRequestId + 1;
        shortcutMetadataRequestId = requestId;

        return fetchShortcutMetadata({ url }).then((metadata) => {
          if (requestId !== shortcutMetadataRequestId || normalizeShortcutUrlInput(urlInput.value) !== url) {
            return null;
          }

          shortcutMetadata = metadata;
          if (!normalizeText(titleInput.value)) {
            const suggestedTitle = metadata?.title || getShortcutHostname(normalizeShortcutUrlInput(urlInput.value));
            if (suggestedTitle) {
              titleInput.value = suggestedTitle;
              clearInlineFormError(error);
            }
          }
          return metadata;
        });
      };

      cancelButton.addEventListener("click", () => {
        renderShortcutGroups();
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (!url) {
          setInlineFormError(error, "先输入地址");
          urlInput.focus();
          return;
        }

        if (!isValidShortcutUrl(url)) {
          setInlineFormError(error, "地址格式不对");
          urlInput.focus();
          return;
        }

        let title = normalizeText(titleInput.value);
        let metadata = shortcutMetadata;

        if (isRemoteUrl(url) && (!title || (!normalizeText(logoInput.value) && url !== shortcut.url))) {
          submitButton.disabled = true;
          setInlineFormError(error, title ? "正在解析图标" : "正在解析标题");
          metadata = await syncShortcutMetadata();
          title = normalizeText(titleInput.value, metadata?.title ?? "");
          submitButton.disabled = false;
        }

        if (!title) {
          setInlineFormError(error, "先输入名称");
          titleInput.focus();
          return;
        }

        shortcut.title = title;
        shortcut.url = url;

        const description = normalizeText(descriptionInput.value, metadata?.description ?? "");
        const logo = normalizeText(logoInput.value, metadata?.logoUrl ?? "");

        if (description) {
          shortcut.description = description;
        } else {
          delete shortcut.description;
        }

        if (logo) {
          shortcut.logo = logo;
        } else {
          delete shortcut.logo;
        }

        persistConfigChange("已修改");
      });

      [titleInput, urlInput, descriptionInput, logoInput].forEach((input) => {
        input.addEventListener("input", () => {
          clearInlineFormError(error);
        });
        input.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            event.preventDefault();
            renderShortcutGroups();
          }
        });
      });

      urlInput.addEventListener("input", () => {
        shortcutMetadata = null;
      });
      urlInput.addEventListener("blur", syncShortcutMetadata);
      urlInput.addEventListener("change", syncShortcutMetadata);

      form.append(fields, submitButton, cancelButton);
      return form;
    };

    const createGroupAddForm = () => {
      const form = document.createElement("form");
      form.className = "shortcut-group shortcut-group--add-form flex items-start gap-2 py-1";
      form.setAttribute("aria-label", settingsLabels.addGroupLabel ?? "添加分组");

      const field = document.createElement("label");
      field.className = "grid min-w-0 gap-1";
      const srLabel = document.createElement("span");
      srLabel.className = "sr-only";
      srLabel.textContent = settingsLabels.groupTitleLabel ?? "分组名";
      const input = document.createElement("input");
      input.className = "input input-bordered input-xs h-8 w-56 bg-base-100 text-xs";
      input.type = "text";
      input.autocomplete = "off";
      input.placeholder = settingsLabels.groupTitleLabel ?? "分组名";
      const error = document.createElement("span");
      error.className = "hidden text-[0.72rem] leading-snug text-error";
      field.append(srLabel, input, error);

      const actions = document.createElement("span");
      actions.className = "inline-flex items-center gap-1.5";
      const submitButton = createIconButton("创建", "check", "text-success/75 hover:text-success");
      submitButton.type = "submit";
      const cancelButton = createIconButton("取消", "close");
      actions.append(submitButton, cancelButton);

      cancelButton.addEventListener("click", () => {
        renderShortcutGroups();
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const title = normalizeText(input.value);

        if (!title) {
          setInlineFormError(error, "先输入分组名");
          input.focus();
          return;
        }

        newTabState.shortcutGroups.push({
          title,
          shortcuts: [],
        });
        persistConfigChange("已添加");
      });

      input.addEventListener("input", () => {
        clearInlineFormError(error);
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          renderShortcutGroups();
        }
      });

      form.append(field, actions);
      return form;
    };

    const createGroupEditForm = (group) => {
      const form = document.createElement("form");
      form.className = "shortcut-group shortcut-group--edit-form flex items-start gap-2 py-1";
      form.setAttribute("aria-label", `修改分组：${group.title}`);

      const field = document.createElement("label");
      field.className = "grid min-w-0 gap-1";
      const srLabel = document.createElement("span");
      srLabel.className = "sr-only";
      srLabel.textContent = settingsLabels.groupTitleLabel ?? "分组名";
      const input = document.createElement("input");
      input.className = "input input-bordered input-xs h-8 w-56 bg-base-100 text-xs";
      input.type = "text";
      input.autocomplete = "off";
      input.placeholder = settingsLabels.groupTitleLabel ?? "分组名";
      input.value = group.title;
      const error = document.createElement("span");
      error.className = "hidden text-[0.72rem] leading-snug text-error";
      field.append(srLabel, input, error);

      const actions = document.createElement("span");
      actions.className = "inline-flex items-center gap-1.5";
      const submitButton = createIconButton("保存", "check", "text-success/75 hover:text-success");
      submitButton.type = "submit";
      const cancelButton = createIconButton("取消", "close");
      actions.append(submitButton, cancelButton);

      cancelButton.addEventListener("click", () => {
        renderShortcutGroups();
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const title = normalizeText(input.value);

        if (!title) {
          setInlineFormError(error, "先输入分组名");
          input.focus();
          return;
        }

        group.title = title;
        persistConfigChange("已修改");
      });

      input.addEventListener("input", () => {
        clearInlineFormError(error);
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          renderShortcutGroups();
        }
      });

      form.append(field, actions);
      return form;
    };

    const moveArrayItem = (items, fromIndex, toIndex) => {
      if (
        fromIndex < 0 ||
        fromIndex >= items.length ||
        toIndex < 0 ||
        fromIndex === toIndex
      ) {
        return false;
      }

      if (toIndex > items.length) {
        return false;
      }

      const adjustedTargetIndex = fromIndex < toIndex ? toIndex - 1 : toIndex;
      if (adjustedTargetIndex === fromIndex) {
        return false;
      }

      const [item] = items.splice(fromIndex, 1);
      items.splice(Math.min(Math.max(adjustedTargetIndex, 0), items.length), 0, item);
      return true;
    };

    const moveShortcutItem = (fromGroupIndex, fromShortcutIndex, toGroupIndex, toShortcutIndex) => {
      const fromGroup = newTabState.shortcutGroups[fromGroupIndex];
      const toGroup = newTabState.shortcutGroups[toGroupIndex];

      if (
        !fromGroup ||
        !toGroup ||
        fromShortcutIndex < 0 ||
        fromShortcutIndex >= fromGroup.shortcuts.length ||
        (fromGroupIndex === toGroupIndex && fromShortcutIndex === toShortcutIndex)
      ) {
        return false;
      }

      const [shortcut] = fromGroup.shortcuts.splice(fromShortcutIndex, 1);
      const adjustedTargetIndex =
        fromGroupIndex === toGroupIndex && fromShortcutIndex < toShortcutIndex
          ? toShortcutIndex - 1
          : toShortcutIndex;
      const boundedTargetIndex = Math.min(Math.max(adjustedTargetIndex, 0), toGroup.shortcuts.length);

      if (boundedTargetIndex === fromShortcutIndex && fromGroupIndex === toGroupIndex) {
        return false;
      }

      toGroup.shortcuts.splice(boundedTargetIndex, 0, shortcut);
      return true;
    };

    const readDragPayload = (event) => {
      try {
        const payload = event.dataTransfer?.getData("application/json");
        if (payload) {
          return JSON.parse(payload);
        }
      } catch {
        // Fall through to the active payload.
      }

      return activeDragPayload;
    };

    const setDragPayload = (payload) => {
      activeDragPayload = payload;
    };

    const clearDragPayload = () => {
      activeDragPayload = null;
    };

    const dropContainerClasses = [
      "rounded-[0.55rem]",
      "outline",
      "outline-1",
      "outline-dashed",
      "outline-base-content/30",
      "outline-offset-[0.22rem]",
    ];
    const groupDropBeforeClasses = [
      "before:content-['']",
      "before:absolute",
      "before:left-0",
      "before:right-0",
      "before:top-[-0.22rem]",
      "before:z-[35]",
      "before:h-0.5",
      "before:rounded-full",
      "before:bg-base-content/70",
      "before:pointer-events-none",
    ];
    const groupDropAfterClasses = [
      "after:content-['']",
      "after:absolute",
      "after:left-0",
      "after:right-0",
      "after:bottom-[-0.22rem]",
      "after:z-[35]",
      "after:h-0.5",
      "after:rounded-full",
      "after:bg-base-content/70",
      "after:pointer-events-none",
    ];
    const itemDropBeforeClasses = [
      "before:content-['']",
      "before:absolute",
      "before:left-[-0.24rem]",
      "before:top-[0.22rem]",
      "before:bottom-[0.22rem]",
      "before:z-[35]",
      "before:w-0.5",
      "before:rounded-full",
      "before:bg-base-content/70",
      "before:pointer-events-none",
    ];
    const itemDropAfterClasses = [
      "after:content-['']",
      "after:absolute",
      "after:right-[-0.24rem]",
      "after:top-[0.22rem]",
      "after:bottom-[0.22rem]",
      "after:z-[35]",
      "after:w-0.5",
      "after:rounded-full",
      "after:bg-base-content/70",
      "after:pointer-events-none",
    ];
    const dropIndicatorClasses = [
      ...dropContainerClasses,
      ...groupDropBeforeClasses,
      ...groupDropAfterClasses,
      ...itemDropBeforeClasses,
      ...itemDropAfterClasses,
    ];

    const clearDropElement = (element) => {
      element.classList.remove(
        "shortcut-drop-target",
        "shortcut-drop-before",
        "shortcut-drop-after",
        ...dropIndicatorClasses,
      );
    };

    const clearDropIndicators = (root) => {
      clearDropElement(root);
      root.querySelectorAll(".shortcut-drop-target, .shortcut-drop-before, .shortcut-drop-after").forEach(clearDropElement);
    };

    const getDropPosition = (event, element, axis = "x") => {
      const rect = element.getBoundingClientRect();
      const pointer = axis === "y" ? event.clientY : event.clientX;
      const midpoint = axis === "y" ? rect.top + rect.height / 2 : rect.left + rect.width / 2;
      return pointer < midpoint ? "before" : "after";
    };

    const setDropContainer = (element) => {
      element.classList.add("shortcut-drop-target", ...dropContainerClasses);
    };

    const setDropPosition = (element, position, axis = "x") => {
      const indicatorClasses = axis === "y"
        ? position === "before"
          ? groupDropBeforeClasses
          : groupDropAfterClasses
        : position === "before"
          ? itemDropBeforeClasses
          : itemDropAfterClasses;

      element.classList.add("shortcut-drop-target", `shortcut-drop-${position}`);
      element.classList.add(...indicatorClasses);
    };

    const dragHandleIcon = getIconMarkup("drag");

    const faviconProxyUrl = META_PROXY_ORIGIN;

    const getProxyUrl = (url) => `${faviconProxyUrl}?url=${encodeURIComponent(url)}`;

    // 旧版本把「当前成功加载的地址」原样写进了缓存，而候选链第一条本来就是代理地址，
    // 于是缓存里存的是代理地址；下次读出来再 pushLogoCandidate 就又套一层代理，
    // 代理请求代理自身域名，Worker 侧固定 522。这里统一剥掉代理前缀再进候选链。
    // 判定用 host 而不是前缀字符串：缓存里可能是 /?url=（带斜杠）也可能不是，
    // 前缀比对会漏；循环剥到不再是本站地址为止，历史数据可能叠了两层。
    const unwrapProxyUrl = (url) => {
      if (!url) {
        return url;
      }

      let current = url;

      for (let round = 0; round < 4; round += 1) {
        let parsed;
        try {
          parsed = new URL(current);
        } catch {
          return current;
        }

        const isProxySelf = parsed.origin === faviconProxyUrl && parsed.pathname === "/";
        const inner = isProxySelf ? parsed.searchParams.get("url") : null;

        if (!inner) {
          return current;
        }

        current = inner;
      }

      return current;
    };

    const isRemoteUrl = (value) => /^https?:\/\//i.test(value);

    const getShortcutLogoCacheKey = (url) => {
      try {
        return new URL(url).origin;
      } catch {
        return url;
      }
    };

    // 与 cloudflare-worker/newtab-meta-proxy.js 的黑名单保持一致：
    // 环回（127./0.）、链路本地（169.254.）在客户端就要挡掉，
    // 否则内网站点会先发一次注定被 Worker 拒绝的请求，日志里平白多一条 400。
    //
    // IP 字面量一律不走代理：Cloudflare 对「直接 IP 访问」固定回 1003，
    // 发过去也是白发；这类地址（如 101.35.226.231:8090 的面板）
    // 交给浏览器本地直连，能否取到由本地网络决定。
    const canProxyUrl = (url) => {
      try {
        const { protocol, hostname } = new URL(url);

        // 非 http(s) 地址（如 data: 内置图标）不要往代理送
        if (protocol !== "http:" && protocol !== "https:") {
          return false;
        }

        const normalizedHost = hostname.toLowerCase().replace(/^\[|\]$/g, "");

        // 裸 IP（v4 全数字点分、v6 含冒号）本地直连，不进代理
        if (/^\d{1,3}(\.\d{1,3}){3}$/.test(normalizedHost) || normalizedHost.includes(":")) {
          return false;
        }

        if (
          normalizedHost === "localhost" ||
          normalizedHost === "::1" ||
          normalizedHost === "0:0:0:0:0:0:0:1" ||
          normalizedHost.endsWith(".local") ||
          normalizedHost.endsWith(".lan") ||
          normalizedHost.startsWith("127.") ||
          normalizedHost.startsWith("0.") ||
          normalizedHost.startsWith("10.") ||
          normalizedHost.startsWith("192.168.") ||
          normalizedHost.startsWith("169.254.")
        ) {
          return false;
        }

        const private172Match = normalizedHost.match(/^172\.(\d+)\./);
        if (private172Match && Number(private172Match[1]) >= 16 && Number(private172Match[1]) <= 31) {
          return false;
        }

        return true;
      } catch {
        return false;
      }
    };

    const resolveShortcutAssetUrl = (assetUrl, baseUrl) => {
      if (!assetUrl) {
        return "";
      }

      if (/^[a-z]+:/i.test(assetUrl)) {
        return assetUrl;
      }

      try {
        return new URL(assetUrl, baseUrl).href;
      } catch {
        return assetUrl;
      }
    };

    const pushLogoCandidate = (candidates, url, withProxy = true) => {
      if (!url || candidates.includes(url)) {
        return;
      }

      if (withProxy && canProxyUrl(url)) {
        const proxyUrl = getProxyUrl(url);
        if (!candidates.includes(proxyUrl)) {
          candidates.push(proxyUrl);
        }
      }

      candidates.push(url);
    };

    const pushLogoCandidates = (candidates, urls, withProxy = true) => {
      urls.forEach((url) => {
        pushLogoCandidate(candidates, url, withProxy);
      });
    };

    const getCachedShortcutLogo = (shortcut) => {
      const cached = shortcutLogoCache[getShortcutLogoCacheKey(shortcut.url)];

      return isPlainObject(cached) ? cached : undefined;
    };

    // 取站点地址所在的目录（保留协议、端口与路径前缀），用于按目录试 favicon。
    // 例：https://1panel.itcox.cn:15660/ccd1a10224/ → 同址；.../ccd1a10224 → 补尾斜杠的目录。
    const resolveShortcutDirectoryUrl = (url) => {
      try {
        const parsed = new URL(url);
        const path = parsed.pathname.replace(/\/[^/]*$/, "/");

        return `${parsed.origin}${path}`;
      } catch {
        return "";
      }
    };

    // 1Panel 的图标路径与守卫页特征是已知的，主机名带 panel 或安全入口样式时按 1Panel 处理；
    // 这里只做路径补充，最终能否取到仍由候选链逐条试。
    const isOnePanelHost = (hostname) =>
      /(^|\.)1?panel\./i.test(hostname) || /(^|\.)panel\./i.test(hostname);

    const getShortcutLogoUrls = (shortcut) => {
      let originUrl = "";
      try {
        originUrl = new URL(shortcut.url).origin;
      } catch {
        originUrl = "";
      }

      const hostname = getShortcutHostname(shortcut.url);
      const candidates = [];
      const cachedLogo = getCachedShortcutLogo(shortcut);
      const canUseCachedLogo = cachedLogo?.resolverVersion === logoResolverVersion;

      // 用户指定过的图标排最前，但不再就此收尾：指定图标失效（站点改版、地址过期）时
      // 后面仍接完整探测链，避免瓦片直接掉回首字母。
      if (shortcut.logo) {
        const logoUrl = unwrapProxyUrl(resolveShortcutAssetUrl(shortcut.logo, shortcut.url));

        pushLogoCandidate(candidates, logoUrl);
      }

      if (canUseCachedLogo && cachedLogo?.logoUrl) {
        pushLogoCandidate(candidates, unwrapProxyUrl(cachedLogo.logoUrl), false);
      }

      if (canUseCachedLogo && Array.isArray(cachedLogo?.candidates)) {
        pushLogoCandidates(candidates, cachedLogo.candidates.map(unwrapProxyUrl));
      }

      const commonPaths = [
        "/favicon.svg",
        "/favicon.png",
        "/favicon.ico",
        // webp 放前面：Vite 项目默认产出 favicon.webp，静态 HTML 里也常写这个格式，
        // 漏掉它时 SPA 的 HTML 兜底会把其余候选全扮成 200，白试一整轮
        "/favicon.webp",
        "/public/favicon.png",
        "/logo.svg",
        "/logo.png",
        "/logo.webp",
        "/icon.svg",
        "/icon.png",
        "/apple-touch-icon.png",
        "/apple-touch-icon-precomposed.png",
        "/assets/logo.svg",
        "/assets/logo.png",
        "/assets/favicon.svg",
        "/assets/favicon.png",
        "/images/logo.svg",
        "/images/logo.png",
        "/images/logo-blue.png",
        "/images/logo-light.png",
      ];

      // 1Panel v2 的图标固定在 /public/favicon.png：静态 HTML 里没有图标标签，
      // 且带安全入口时守卫页会把带路径的请求全返 HTML 兜底，只有站点根路径下取得到。
      // 实测确认这条是 1Panel 站点唯一能拿到图的候选，所以排在最前面。
      if (isOnePanelHost(hostname)) {
        pushLogoCandidate(candidates, `${originUrl}/public/favicon.png`);
      }

      commonPaths.forEach((path) => {
        if (!originUrl) {
          return;
        }

        pushLogoCandidate(candidates, new URL(path, originUrl).href);
      });

      const googleFavicon = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(hostname)}&sz=64`;
      const duckDuckGoFavicon = `https://icons.duckduckgo.com/ip3/${hostname}.ico`;
      // hostname 不含端口：非默认端口站点（如面板 :15660）要补回协议与端口，否则会打到默认端口上
      const faviconOrigin = originUrl ? new URL(originUrl) : null;
      const directFavicon = faviconOrigin
        ? `${faviconOrigin.protocol}//${hostname}${faviconOrigin.port ? `:${faviconOrigin.port}` : ""}/favicon.ico`
        : "";

      pushLogoCandidate(candidates, googleFavicon);
      pushLogoCandidate(candidates, duckDuckGoFavicon);
      pushLogoCandidate(candidates, directFavicon, false);

      // 带路径的站点（安全入口 /ccd1a10224/、子目录应用）图标可能在应用目录下。
      // 放在最后：这类请求大多被守卫页挡下返回 HTML 兜底，提前只会白发一批请求。
      const directoryUrl = resolveShortcutDirectoryUrl(shortcut.url);
      if (directoryUrl && directoryUrl !== originUrl) {
        commonPaths.forEach((path) => {
          pushLogoCandidate(candidates, new URL(path.slice(1), directoryUrl).href);
        });
      }

      return candidates;
    };

    const getShortcutSubtitle = (shortcut) =>
      shortcut.description ?? getCachedShortcutLogo(shortcut)?.description ?? getShortcutHostname(shortcut.url);

    const cleanShortcutTitle = (value) => {
      const title = normalizeText(value);

      if (!title) {
        return "";
      }

      const shortTitle = title.slice(0, 80);
      const match = shortTitle.match(/^(.*?)[\s]*[-–—·|:：][\s]*([^\-–—·|:：\n]{1,24})$/);

      if (match && match[1].trim() && match[2].trim()) {
        return match[1].trim();
      }

      return shortTitle;
    };

    const normalizePageTitle = (value) =>
      normalizeText(value).replace(/\u2026/g, "...").replace(/\s+/g, " ");

    // SPA 站点（如 1Panel）的静态 HTML 标题常是占位符，真实标题由前端渲染，服务端抓不到。
    const isLoadingPageTitle = (value) =>
      /^loading[.\s]*$/i.test(value) || /^(加载中|正在加载|请稍候)[.。\s]*$/.test(value);

    // 1Panel 的图标由前端运行时注入（默认 /public/favicon.png），静态 HTML 里没有图标标签；
    // 没带安全入口时会收到守卫页，页面里有固定命令文案（安全入口未配置或域名绑定不符两种变体），
    // 可据此认出 1Panel 并直接用内置图标。
    const isOnePanelGuardPage = (html) => html.includes("1pctl user-info") || html.includes("1pctl reset domain");

    const collectLogoUrlsFromHtml = (html, baseUrl) => {
      const candidates = [];
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, "text/html");
      const pageTitle = cleanShortcutTitle(normalizePageTitle(doc.querySelector("title")?.textContent));
      const fallbackTitle = cleanShortcutTitle(normalizePageTitle(
        doc.querySelector('meta[property="og:title"]')?.getAttribute("content") ??
        doc.querySelector('meta[name="application-name"]')?.getAttribute("content") ??
        "",
      ));
      const isGuardPage = isOnePanelGuardPage(html);
      const resolvedTitle = (isGuardPage ? [] : [pageTitle, fallbackTitle]).find(
        (value) => value && !isLoadingPageTitle(value),
      ) ?? "";
      const iconSelector = [
        'link[rel~="icon"][href]',
        'link[rel~="apple-touch-icon"][href]',
        'link[rel~="apple-touch-icon-precomposed"][href]',
        'link[rel~="mask-icon"][href]',
        'meta[property="og:logo"][content]',
      ].join(",");

      doc.querySelectorAll(iconSelector).forEach((element) => {
        const rawUrl = element.getAttribute("href") ?? element.getAttribute("content");
        const logoUrl = resolveShortcutAssetUrl(rawUrl, baseUrl);

        if (logoUrl && !candidates.includes(logoUrl)) {
          candidates.push(logoUrl);
        }
      });

      doc.querySelectorAll('script[type="application/ld+json"]').forEach((script) => {
        try {
          const data = JSON.parse(script.textContent ?? "null");
          const nodes = Array.isArray(data) ? data : [data];

          nodes.forEach((node) => {
            const logo = node?.logo?.url ?? node?.logo;
            const logoUrl = typeof logo === "string" ? resolveShortcutAssetUrl(logo, baseUrl) : "";

            if (logoUrl && !candidates.includes(logoUrl)) {
              candidates.push(logoUrl);
            }
          });
        } catch {
          // Ignore invalid structured data and keep other logo sources.
        }
      });

      doc.querySelectorAll('meta[property="og:image"][content], meta[name="twitter:image"][content]').forEach((element) => {
        const logoUrl = resolveShortcutAssetUrl(element.getAttribute("content") ?? "", baseUrl);

        if (logoUrl && !candidates.includes(logoUrl)) {
          candidates.push(logoUrl);
        }
      });

      return {
        candidates: isGuardPage ? [onePanelLogoDataUrl, ...candidates] : candidates,
        title: resolvedTitle,
        description: normalizeText(
          doc.querySelector('meta[name="description"]')?.getAttribute("content") ??
          doc.querySelector('meta[property="og:description"]')?.getAttribute("content"),
        ),
      };
    };

    const hasUsefulCachedLogoMetadata = (cached) =>
      Boolean(
        cached?.resolverVersion === logoResolverVersion &&
        (
          cached.metadataResolved ||
          (Array.isArray(cached.candidates) && cached.candidates.length) ||
          cached.description ||
          cached.failedAt
        ),
      );

    const mergeShortcutLogoCache = (cacheKey, payload) => {
      if (!cacheKey) {
        return;
      }

      const existing = shortcutLogoCache[cacheKey] ?? {};
      const candidates = [
        ...(Array.isArray(existing.candidates) ? existing.candidates : []),
        ...(Array.isArray(payload.candidates) ? payload.candidates : []),
      ].filter((url, index, items) => url && items.indexOf(url) === index);

      shortcutLogoCache = {
        ...shortcutLogoCache,
        [cacheKey]: {
          ...existing,
          ...payload,
          candidates,
          resolverVersion: logoResolverVersion,
          updatedAt: Date.now(),
        },
      };
      writeShortcutLogoCache();
    };

    const fetchShortcutMetadata = (shortcut) => {
      const cacheKey = getShortcutLogoCacheKey(shortcut.url);
      const cached = shortcutLogoCache[cacheKey];
      const cachedAt = Number(cached?.updatedAt ?? cached?.failedAt ?? 0);
      // 成功解析的缓存保鲜 7 天；失败记录只保鲜 1 天，避免一次抖动导致长期不重试。
      const hasResolvedLogoMetadata = Boolean(
        cached?.metadataResolved ||
        (Array.isArray(cached?.candidates) && cached.candidates.length > 0) ||
        cached?.description,
      );
      const isFresh = cachedAt
        && Date.now() - cachedAt < (hasResolvedLogoMetadata ? 7 : 1) * 24 * 60 * 60 * 1000;

      if (!isRemoteUrl(shortcut.url) || !canProxyUrl(shortcut.url)) {
        return Promise.resolve(cached);
      }

      if (isFresh && hasUsefulCachedLogoMetadata(cached)) {
        return Promise.resolve(cached);
      }

      if (shortcutLogoRequests.has(cacheKey)) {
        return shortcutLogoRequests.get(cacheKey);
      }

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 5000);
      const request = fetch(getProxyUrl(shortcut.url), {
        signal: controller.signal,
      })
        .then((response) => (response.ok ? response.text() : ""))
        .then(async (html) => {
          if (!html) {
            mergeShortcutLogoCache(cacheKey, {
              candidates: [],
              failedAt: Date.now(),
            });
            return shortcutLogoCache[cacheKey];
          }

          const discovered = collectLogoUrlsFromHtml(html, shortcut.url);
          discovered.logoUrl = unwrapProxyUrl(discovered.logoUrl ?? discovered.candidates[0] ?? "");

          if (!discovered.candidates.length && !discovered.title && !discovered.description) {
            mergeShortcutLogoCache(cacheKey, {
              candidates: [],
              failedAt: Date.now(),
            });
            return shortcutLogoCache[cacheKey];
          }

          mergeShortcutLogoCache(cacheKey, {
            ...discovered,
            metadataResolved: true,
          });
          return shortcutLogoCache[cacheKey];
        })
        .catch(() => {
          mergeShortcutLogoCache(cacheKey, {
            candidates: [],
            failedAt: Date.now(),
          });
          return shortcutLogoCache[cacheKey];
        })
        .finally(() => {
          window.clearTimeout(timeout);
          shortcutLogoRequests.delete(cacheKey);
        });

      shortcutLogoRequests.set(cacheKey, request);
      return request;
    };

    const refreshShortcutMetadataDisplay = (shortcut, image) => {
      const item = image.closest(".shortcut-item");
      const itemShell = image.closest(".shortcut-item-shell");

      if (!(item instanceof HTMLElement)) {
        return;
      }

      const subtitle = getShortcutSubtitle(shortcut);
      const itemLabelText = item.querySelector(".shortcut-item__label small");
      const tooltipText = itemShell?.querySelector(".shortcut-item__tooltip small");

      item.setAttribute("aria-label", `${shortcut.title}：${subtitle}`);

      if (itemLabelText instanceof HTMLElement) {
        itemLabelText.textContent = subtitle;
      }

      if (tooltipText instanceof HTMLElement) {
        tooltipText.textContent = subtitle;
      }
    };

    const discoverShortcutLogo = (shortcut, image) => {
      if (shortcut.logo || !isRemoteUrl(shortcut.url)) {
        return;
      }

      fetchShortcutMetadata(shortcut).then((metadata) => {
        refreshShortcutMetadataDisplay(shortcut, image);

        if (!image.isConnected) {
          return;
        }

        const nextUrls = getShortcutLogoUrls(shortcut);
        const nextLogoUrl = nextUrls[0] ?? "";
        const shouldReplaceLoadedLogo = Boolean(
          metadata?.logoUrl &&
          nextLogoUrl &&
          image.src !== nextLogoUrl &&
          image.currentSrc !== nextLogoUrl,
        );

        if (!shouldReplaceLoadedLogo && image.complete && image.naturalWidth > 0) {
          return;
        }

        image.hidden = false;
        image.closest(".shortcut-item__icon")?.querySelector(".shortcut-item__initial")?.classList.add("hidden");
        image.dataset.logoFallbacks = JSON.stringify(nextUrls.slice(1));
        image.src = nextLogoUrl;
      });
    };

    const getNextLogoFallback = (image) => {
      const fallbacks = image.dataset.logoFallbacks
        ? JSON.parse(image.dataset.logoFallbacks)
        : [];
      const nextFallback = fallbacks.shift() ?? "";
      image.dataset.logoFallbacks = JSON.stringify(fallbacks);
      return nextFallback;
    };

    // SPA 与部分面板站点对不存在的路径也返回 200 + text/html（前端路由兜底），
    // <img> 拿到 HTML 时表现不统一：多数触发 error，个别被当成可解码内容而触发 load。
    // 仅凭 naturalWidth > 0 就认为「图标找到了」会把兜底页当成功写进缓存，
    // 之后一直复用这个假图标。这里用 fetch 复核一次 content-type。
    // 状态码也要看：Google s2/favicons 对没有图标的站点回的是 404 + image/png
    // （726 字节通用地球占位图），只看 content-type 会把这张地球当站点 logo 缓存下来。
    const isImageResponse = async (url) => {
      try {
        const response = await fetch(url, { method: "GET" });
        const contentType = response.headers.get("content-type") ?? "";

        return response.ok && /^image\//i.test(contentType) && !/text\/html/i.test(contentType);
      } catch {
        return false;
      }
    };

    const bindLogoFallback = (image) => {
      image.addEventListener("load", () => {
        if (!image.currentSrc || image.naturalWidth <= 0) {
          return;
        }

        const verify = async () => {
          const loadedLogoUrl = unwrapProxyUrl(image.currentSrc);

          if (!(await isImageResponse(image.currentSrc))) {
            // 拿到的是 HTML 兜底页，按失败处理，继续往下一个候选走
            const fallback = getNextLogoFallback(image);

            if (fallback && image.src !== fallback) {
              image.src = fallback;
              return;
            }

            image.hidden = true;
            image.closest(".shortcut-item__icon")?.querySelector(".shortcut-item__initial")?.classList.remove("hidden");
            return;
          }

          const existing = shortcutLogoCache[image.dataset.logoCacheKey];

          if (
            existing?.metadataResolved &&
            existing?.logoUrl &&
            existing.logoUrl !== loadedLogoUrl
          ) {
            return;
          }

          mergeShortcutLogoCache(image.dataset.logoCacheKey, {
            logoUrl: loadedLogoUrl,
          });
        };

        void verify();
      });

      image.addEventListener("error", () => {
        const fallback = getNextLogoFallback(image);

        if (fallback && image.src !== fallback) {
          image.src = fallback;
          return;
        }

        image.hidden = true;
        image.closest(".shortcut-item__icon")?.querySelector(".shortcut-item__initial")?.classList.remove("hidden");
      });
    };

    // —— 布局引擎：网格走原生流式，堆叠/环形/随机走画布绝对定位；切换与增删用 FLIP 补间 ——
    const shortcutPlacementMemory = new Map();

    const getShortcutCanvasKey = (element) =>
      element instanceof HTMLElement ? element.dataset.canvasKey ?? "" : "";

    const hashShortcutKey = (value) => {
      let hash = 5381;

      for (let index = 0; index < value.length; index += 1) {
        hash = ((hash << 5) + hash + value.charCodeAt(index)) | 0;
      }

      return Math.abs(hash);
    };

    const createScatterRandom = (seed) => {
      let state = seed % 2147483647;

      if (state <= 0) {
        state += 2147483646;
      }

      return () => {
        state = (state * 16807) % 2147483647;
        return (state - 1) / 2147483646;
      };
    };

    const layoutShortcutCanvas = (itemsEl, mode, placements) => {
      const children = Array.from(itemsEl.children).filter((child) => child instanceof HTMLElement);

      if (mode === "grid" || !children.length) {
        itemsEl.style.removeProperty("height");
        children.forEach((child) => {
          child.style.removeProperty("position");
          child.style.removeProperty("left");
          child.style.removeProperty("top");
          child.style.removeProperty("transform");
          child.style.removeProperty("z-index");
          delete child.dataset.canvasZ;
          placements.set(getShortcutCanvasKey(child), {
            x: child.offsetLeft,
            y: child.offsetTop,
            rot: 0,
          });
        });
        return;
      }

      const tileEl = children.find((child) => child.classList.contains("shortcut-item-shell")) ?? children[0];
      const tileWidth = tileEl.offsetWidth || 96;
      const tileHeight = tileEl.offsetHeight || 88;
      const width = itemsEl.clientWidth || tileWidth;
      const positions = [];

      if (mode === "stack") {
        // 横向手牌：卡片沿一行错开、轻微重叠，每张露出左侧一条；一行放不下自动换行。
        // dataset.fanTransform 存悬停时向右铺开成完整间距的位置。
        // 每行容量按铺开后的间距算，保证铺开时不会顶出容器。
        const rowGap = 10;
        const collapsedStepX = Math.max(tileWidth * 0.6, 1);
        const expandedStepX = Math.max(tileWidth + rowGap, collapsedStepX);
        const perRow = Math.max(1, Math.floor((width - tileWidth) / expandedStepX) + 1);
        const random = createScatterRandom(newTabState.scatterSeed + 17);

        children.forEach((child, index) => {
          const column = index % perRow;
          const row = Math.floor(index / perRow);

          positions.push({
            x: column * collapsedStepX,
            y: row * (tileHeight + rowGap),
            rot: random() * 3 - 1.5,
            z: index + 1,
          });

          child.dataset.fanTransform = `translate(${column * expandedStepX}px, ${row * (tileHeight + rowGap)}px) rotate(0deg)`;
          child.dataset.fanZ = String(40 + index);
        });
      } else if (mode === "ring") {
        // 弧形：一条开口向上的圆弧（中间低、两端高），瓦片随切线倾斜。
        // 瓦片多到单环按设计间距排不下时拆成多个环纵向叠放，免得一条弧挤成一团；
        // 叠起来高度超预算就把半径拉大、弧压平，优先保证瓦片都露在视口里。
        const tileMax = Math.max(tileWidth, tileHeight);
        // 相邻瓦片沿弧的间距，与单环原有观感一致
        const arcStep = tileMax * 0.95;
        const maxArcWidth = Math.max(0, width - tileWidth);
        const perRingCapacity = Math.max(1, Math.floor(maxArcWidth / arcStep) + 1);
        const ringCount = Math.max(1, Math.ceil(children.length / perRingCapacity));
        const perRing = Math.ceil(children.length / ringCount);
        const ringGap = 12;
        const apexPad = 6;
        const heightBudget = Math.max(tileHeight * 2, window.innerHeight * 0.58);
        const dropLimit = Math.max(
          0,
          (heightBudget - apexPad - ringCount * tileHeight - (ringCount - 1) * ringGap) / ringCount,
        );
        const baseRadius = Math.max(width * 0.72, tileMax * 1.4);
        const arcDrop = (r, len) => r * (1 - Math.cos(len / (2 * r)));
        const longestArc = Math.min(maxArcWidth, (perRing - 1) * arcStep);

        let radius = baseRadius;

        if (arcDrop(radius, longestArc) > dropLimit) {
          // 半径越大弧越平（弧深越小），二分找刚好把弧深压进预算的半径
          let low = baseRadius;
          let high = baseRadius * 64;

          for (let attempt = 0; attempt < 42; attempt += 1) {
            const mid = (low + high) / 2;

            if (arcDrop(mid, longestArc) > dropLimit) {
              low = mid;
            } else {
              high = mid;
            }
          }

          radius = high;
        }

        let ringTop = apexPad;
        let placed = 0;

        for (let ring = 0; ring < ringCount && placed < children.length; ring += 1) {
          const size = Math.min(perRing, children.length - placed);
          const arcLen = Math.min(maxArcWidth, (size - 1) * arcStep);
          const half = arcLen / (2 * radius);
          const step = size > 1 ? arcLen / radius / (size - 1) : 0;

          for (let offset = 0; offset < size; offset += 1) {
            const angle = (offset - (size - 1) / 2) * step;

            positions.push({
              x: width / 2 + Math.sin(angle) * radius - tileWidth / 2,
              y: ringTop + radius * (Math.cos(angle) - Math.cos(half)),
              rot: Math.max(-26, Math.min(26, (-angle * 180) / Math.PI)),
              z: placed + offset + 1,
            });
          }

          placed += size;
          ringTop += arcDrop(radius, arcLen) + tileHeight + ringGap;
        }
      } else {
        // 有机散布：最优采样挑离已放置瓦片最远的候选点，避免规则网格感
        const canvasHeight = Math.max(
          tileHeight * 1.9,
          Math.ceil((children.length * tileWidth * tileHeight * 2.6) / Math.max(width, 1)),
        );
        const placedCenters = [];

        children.forEach((child, index) => {
          const key = getShortcutCanvasKey(child) || String(index);
          const random = createScatterRandom((newTabState.scatterSeed ^ hashShortcutKey(key)) + 11);
          const maxX = Math.max(0, width - tileWidth);
          const maxY = Math.max(0, canvasHeight - tileHeight);
          let best = { x: 0, y: 0, rot: 0 };
          let bestScore = -1;

          for (let attempt = 0; attempt < 12; attempt += 1) {
            const x = random() * maxX;
            const y = random() * maxY;
            const cx = x + tileWidth / 2;
            const cy = y + tileHeight / 2;
            let nearest = Infinity;

            placedCenters.forEach((center) => {
              nearest = Math.min(nearest, Math.hypot(center.x - cx, center.y - cy));
            });

            const edgePull = Math.min(cx, width - cx, cy, canvasHeight - cy) * 0.35;
            const score = (Number.isFinite(nearest) ? nearest : 0) + edgePull;

            if (score > bestScore) {
              bestScore = score;
              best = { x, y, rot: random() * 32 - 16 };
            }
          }

          placedCenters.push({ x: best.x + tileWidth / 2, y: best.y + tileHeight / 2 });
          positions.push({ x: best.x, y: best.y, rot: best.rot, z: 0 });
        });
      }

      const canvasHeight = positions.reduce((max, position) => Math.max(max, position.y), 0) + tileHeight + 4;

      itemsEl.style.height = `${canvasHeight}px`;
      children.forEach((child, index) => {
        const position = positions[index];

        child.style.position = "absolute";
        child.style.left = "0";
        child.style.top = "0";
        child.style.transform = `translate(${position.x}px, ${position.y}px) rotate(${position.rot}deg)`;
        child.style.zIndex = position.z ? String(position.z) : "";

        if (position.z) {
          child.dataset.canvasZ = String(position.z);
        } else {
          delete child.dataset.canvasZ;
        }

        if (mode !== "stack") {
          delete child.dataset.fanTransform;
          delete child.dataset.fanZ;
        }

        placements.set(getShortcutCanvasKey(child), {
          x: position.x,
          y: position.y,
          rot: position.rot,
        });
      });
    };

    const applyShortcutLayouts = (previousPlacements, { animate = true } = {}) => {
      const stack = document.querySelector("[data-shortcut-stack]");

      if (!(stack instanceof HTMLElement)) {
        return;
      }

      const mode = newTabState.shortcutLayout;
      const stagger = animate && previousPlacements.size === 0;
      let globalIndex = 0;

      stack.querySelectorAll(".shortcut-group__items").forEach((itemsEl) => {
        if (!(itemsEl instanceof HTMLElement)) {
          return;
        }

        const placements = new Map();

        layoutShortcutCanvas(itemsEl, mode, placements);

        Array.from(itemsEl.children).forEach((child) => {
          if (!(child instanceof HTMLElement)) {
            return;
          }

          const key = getShortcutCanvasKey(child);
          const target = placements.get(key);

          if (!target) {
            return;
          }

          const delay = stagger ? Math.min(globalIndex * 24, 360) : 0;

          globalIndex += 1;
          child.style.setProperty("--ntab-delay", `${delay}ms`);

          const previous = animate ? previousPlacements.get(key) : undefined;

          if (previous) {
            const dx = previous.x - target.x;
            const dy = previous.y - target.y;
            const dr = (previous.rot ?? 0) - target.rot;

            if (dx || dy || dr) {
              // 起点先关过渡提交，再同步恢复过渡落到终点；不走 rAF（后台/遮挡标签页会节流导致终态不落地）。
              child.style.transition = "none";
              child.style.transform = `translate(${target.x + dx}px, ${target.y + dy}px) rotate(${target.rot + dr}deg)`;
              child.getBoundingClientRect();
              child.style.transition = "";
              child.style.transform = mode === "grid"
                ? ""
                : `translate(${target.x}px, ${target.y}px) rotate(${target.rot}deg)`;
            } else if (mode === "grid") {
              child.style.transform = "";
            } else {
              child.style.transform = `translate(${target.x}px, ${target.y}px) rotate(${target.rot}deg)`;
            }
          } else if (animate && !previousPlacements.has(key)) {
            child.classList.add("ntab-pop");
            window.setTimeout(() => child.classList.remove("ntab-pop"), delay + 620);
          }
        });

        placements.forEach((value, placementKey) => {
          shortcutPlacementMemory.set(placementKey, value);
        });
      });
    };

    let shortcutLayoutResizeTimer = 0;

    const scheduleShortcutRelayout = () => {
      window.clearTimeout(shortcutLayoutResizeTimer);
      shortcutLayoutResizeTimer = window.setTimeout(() => {
        applyShortcutLayouts(shortcutPlacementMemory, { animate: false });
      }, 140);
    };

    const renderSearchEngines = () => {
      const select = document.querySelector("[data-config-search-engine]");

      if (!(select instanceof HTMLSelectElement)) {
        return;
      }

      select.textContent = "";
      newTabState.searchEngines.forEach((engine) => {
        const option = document.createElement("option");
        option.value = engine.id;
        option.textContent = engine.label;
        select.append(option);
      });

      select.value = newTabState.defaultSearchEngineId;
    };

    const renderGreeting = () => {
      const greeting = document.querySelector("[data-new-tab-greeting]");

      if (!(greeting instanceof HTMLElement)) {
        return;
      }

      const hour = new Date().getHours();
      const greetingConfig = newTabState.greetings.find((item) => {
        if (item.from < item.to) {
          return hour >= item.from && hour < item.to;
        }

        return hour >= item.from || hour < item.to;
      });

      greeting.textContent = `${greetingConfig?.label ?? "你好"}，${newTabState.userName}`;

      const dateTarget = document.querySelector("[data-new-tab-date]");

      if (dateTarget instanceof HTMLElement) {
        const now = new Date();
        dateTarget.textContent = [
          new Intl.DateTimeFormat("zh-CN", { month: "long", day: "numeric" }).format(now),
          new Intl.DateTimeFormat("zh-CN", { weekday: "long" }).format(now),
        ].join(" · ");
      }
    };

    const renderHomeLink = () => {
      const homeLink = document.querySelector("[data-home-link]");

      if (!(homeLink instanceof HTMLAnchorElement)) {
        return;
      }

      homeLink.href = newTabState.homeLink.href;
      const homeLinkLabel = homeLink.querySelector("[data-home-link-label]");

      if (homeLinkLabel instanceof HTMLElement) {
        homeLinkLabel.textContent = newTabState.homeLink.label;
        homeLinkLabel.classList.toggle("hidden", !newTabState.homeLink.label);
        return;
      }

      homeLink.textContent = newTabState.homeLink.label;
    };

    const renderShortcutGroups = () => {
      const stack = document.querySelector("[data-shortcut-stack]");

      if (!(stack instanceof HTMLElement)) {
        return;
      }

      const shell = document.querySelector("[data-new-tab-page]");

      if (shell instanceof HTMLElement) {
        // 没有分组时工具栏的添加入口无处分派，交给空态引导（见 [data-has-groups] 样式）
        shell.dataset.hasGroups = newTabState.shortcutGroups.length ? "true" : "false";
      }

      // 入场动画的弧形降级判据挂在 html 上（首帧前由内联脚本写入），切换布局后同步保持一致
      document.documentElement.dataset.newTabLayout = newTabState.shortcutLayout;

      const previousPlacements = new Map(shortcutPlacementMemory);

      shortcutPlacementMemory.clear();
      stack.textContent = "";
      closeShortcutContextMenu();

      if (!newTabState.shortcutGroups.length) {
        stack.append(createShortcutEmptyState());
        applyTextColors();
        return;
      }

      const groupSections = [];

      newTabState.shortcutGroups.forEach((group, groupIndex) => {
        const section = document.createElement("section");
        section.className = "shortcut-group group/section relative flex flex-col gap-2.5 py-1";
        section.setAttribute("aria-label", `${group.title}快捷方式`);

        const summary = document.createElement("div");
        summary.className = "shortcut-group__summary flex min-w-0 items-center gap-3";

        const title = document.createElement("span");
        title.className = "min-w-0 whitespace-nowrap text-[0.82rem] font-semibold tracking-[0.02em] text-base-content/55";
        title.dataset.newTabColorTarget = "itemLabel";
        title.textContent = group.title;

        const openGroupEditForm = () => {
          const form = createGroupEditForm(group);
          section.replaceWith(form);
          focusFirstInput(form);
        };
        const removeGroup = () => {
          const currentGroupIndex = newTabState.shortcutGroups.indexOf(group);

          if (currentGroupIndex < 0) {
            return;
          }

          newTabState.shortcutGroups.splice(currentGroupIndex, 1);
          persistConfigChange("已删除");
        };
        const openGroupMenu = (event) => {
          openShortcutContextMenu({
            event,
            fallbackElement: section,
            title: group.title,
            subtitle: "分组操作",
            actions: [
              {
                label: settingsLabels.addShortcutLabel ?? "添加站点",
                icon: "plus",
                onSelect: () => {
                  openShortcutAddForm(group);
                },
              },
              {
                label: "修改分组",
                icon: "edit",
                onSelect: openGroupEditForm,
              },
              {
                label: settingsLabels.removeGroupLabel ?? "删除分组",
                icon: "trash",
                danger: true,
                onSelect: removeGroup,
              },
            ],
          });
        };

        const titleWrap = document.createElement("span");
        titleWrap.className = "group/title flex min-w-0 items-center gap-2";

        const groupDragHandle = document.createElement("span");
        groupDragHandle.className = "shortcut-drag-handle grid h-5 w-4 shrink-0 cursor-grab place-items-center border border-base-content/10 bg-base-100 text-base-content/35 opacity-0 transition hover:text-base-content/70 focus-visible:opacity-100 active:cursor-grabbing group-hover/title:opacity-100 max-sm:hidden";
        groupDragHandle.draggable = true;
        groupDragHandle.title = "拖拽排序";
        groupDragHandle.setAttribute("aria-label", `拖拽排序：${group.title}`);
        groupDragHandle.innerHTML = dragHandleIcon;
        groupDragHandle.addEventListener("dragstart", (event) => {
          setDragPayload({
            type: "group",
            groupIndex,
          });
          if (event.dataTransfer) {
            event.dataTransfer.setData("application/json", JSON.stringify(activeDragPayload));
            event.dataTransfer.setData("text/plain", group.title);
            event.dataTransfer.effectAllowed = "move";
          }
          section.classList.add("opacity-50");
        });
        groupDragHandle.addEventListener("dragend", () => {
          section.classList.remove("opacity-50");
          clearDropIndicators(stack);
          clearDragPayload();
        });
        titleWrap.append(groupDragHandle, title);

        const groupMenuButton = document.createElement("button");
        groupMenuButton.className = "btn btn-square btn-ghost btn-xs shortcut-group__menu h-6 min-h-6 w-6 shrink-0 p-0 text-base-content/45 opacity-0 transition hover:text-base-content/70 focus-visible:text-base-content/70 focus-visible:opacity-100 group-hover/title:opacity-100 max-sm:opacity-100 [&_svg]:h-3.5 [&_svg]:w-3.5";
        groupMenuButton.type = "button";
        groupMenuButton.title = "分组操作";
        groupMenuButton.setAttribute("aria-label", `分组操作：${group.title}`);
        groupMenuButton.innerHTML = getIconMarkup("more");
        groupMenuButton.addEventListener("click", openGroupMenu);

        titleWrap.append(groupMenuButton);
        titleWrap.addEventListener("contextmenu", openGroupMenu);

        const count = document.createElement("span");
        count.className = "shrink-0 text-[0.68rem] font-medium text-base-content/30";
        count.textContent = String(group.shortcuts.length);

        const rule = document.createElement("span");
        rule.className = "h-px min-w-6 flex-1 bg-base-content/10";
        rule.setAttribute("aria-hidden", "true");

        summary.append(titleWrap, count, rule);

        section.addEventListener("dragover", (event) => {
          const payload = readDragPayload(event);

          if (payload?.type !== "group") {
            return;
          }

          event.preventDefault();
          event.stopPropagation();
          if (event.dataTransfer) {
            event.dataTransfer.dropEffect = "move";
          }
          clearDropIndicators(stack);
          const position = getDropPosition(event, section, "y");
          setDropPosition(section, position, "y");
        });
        section.addEventListener("dragleave", () => {
          clearDropElement(section);
        });
        section.addEventListener("drop", (event) => {
          const payload = readDragPayload(event);

          if (payload?.type !== "group") {
            return;
          }

          event.preventDefault();
          event.stopPropagation();
          clearDropIndicators(stack);

          const position = getDropPosition(event, section, "y");
          const targetIndex = groupIndex + (position === "after" ? 1 : 0);

          if (moveArrayItem(newTabState.shortcutGroups, Number(payload.groupIndex), targetIndex)) {
            persistConfigChange("已排序");
          }
        });

        const items = document.createElement("div");
        items.className = "shortcut-group__items relative flex w-full min-w-0 flex-wrap items-start justify-start gap-2 sm:gap-2.5";
        items.addEventListener("dragover", (event) => {
          const payload = readDragPayload(event);

          if (payload?.type !== "shortcut") {
            return;
          }

          event.preventDefault();
          event.stopPropagation();
          if (event.dataTransfer) {
            event.dataTransfer.dropEffect = "move";
          }
          clearDropIndicators(stack);
          setDropContainer(items);
        });
        items.addEventListener("dragleave", () => {
          clearDropElement(items);
        });
        items.addEventListener("drop", (event) => {
          const payload = readDragPayload(event);

          if (payload?.type !== "shortcut") {
            return;
          }

          event.preventDefault();
          event.stopPropagation();
          clearDropIndicators(stack);

          if (
            moveShortcutItem(
              Number(payload.groupIndex),
              Number(payload.shortcutIndex),
              groupIndex,
              group.shortcuts.length,
            )
          ) {
            persistConfigChange("已排序");
          }
        });
        items.addEventListener("contextmenu", (event) => {
          if (event.target !== items) {
            return;
          }

          event.preventDefault();
          openShortcutAddForm(group);
        });
        // 堆叠模式：悬停整组向右铺开成完整间距，移开复位（牌堆位来自布局内存）
        items.addEventListener("pointerenter", () => {
          if (newTabState.shortcutLayout !== "stack") {
            return;
          }

          Array.from(items.children).forEach((child) => {
            if (!(child instanceof HTMLElement) || !child.dataset.fanTransform) {
              return;
            }

            child.style.transitionDelay = `${Math.min(Number(child.dataset.canvasIndex ?? 0) * 26, 320)}ms`;
            child.style.transform = child.dataset.fanTransform;
            child.style.zIndex = child.dataset.fanZ ?? "";
          });
        });
        items.addEventListener("pointerleave", () => {
          if (newTabState.shortcutLayout !== "stack") {
            return;
          }

          Array.from(items.children).forEach((child) => {
            if (!(child instanceof HTMLElement) || !child.dataset.fanTransform) {
              return;
            }

            child.style.transitionDelay = "";
            const placement = shortcutPlacementMemory.get(getShortcutCanvasKey(child));

            child.style.transform = placement
              ? `translate(${placement.x}px, ${placement.y}px) rotate(${placement.rot}deg)`
              : "";
            child.style.zIndex = child.dataset.canvasZ ?? "";
          });
