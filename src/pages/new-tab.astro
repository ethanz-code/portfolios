        if (targetIndex >= 0 && existingSelect instanceof HTMLSelectElement) {
          existingSelect.value = String(targetIndex);
          existingSelect.dispatchEvent(new Event("change", { bubbles: true }));
        }

        existing.scrollIntoView({ block: "nearest" });
        focusFirstInput(existing);
        return;
      }

      const groups = newTabState.shortcutGroups;
      const target = group ?? groups.find((item) => item.title === lastShortcutAddGroupTitle) ?? groups[0];

      if (!target) {
