      const syncShortcutMetadata = () => {
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (!url || !isValidShortcutUrl(url) || !isRemoteUrl(url)) {
          return Promise.resolve(null);
        }

        const requestId = shortcutMetadataRequestId + 1;
        shortcutMetadataRequestId = requestId;

        return fetchShortcutMetadata({ url }).then((metadata) => {
          if (requestId !== shortcutMetadataRequestId || normalizeShortcutUrlInput(urlInput.value) !== url) {
            return null;
          }

          applyShortcutMetadata(metadata);
          return metadata;
        });
