    const moveArrayItem = (items, fromIndex, toIndex) => {
      if (
        fromIndex < 0 ||
        fromIndex >= items.length ||
        toIndex < 0 ||
        fromIndex === toIndex
      ) {
        return false;
      }

      if (toIndex > items.length) {
        return false;
      }

      const adjustedTargetIndex = fromIndex < toIndex ? toIndex - 1 : toIndex;
      if (adjustedTargetIndex === fromIndex) {
        return false;
      }

      const [item] = items.splice(fromIndex, 1);
      items.splice(Math.min(Math.max(adjustedTargetIndex, 0), items.length), 0, item);
      return true;
    };

    const moveShortcutItem = (fromGroupIndex, fromShortcutIndex, toGroupIndex, toShortcutIndex) => {
      const fromGroup = newTabState.shortcutGroups[fromGroupIndex];
      const toGroup = newTabState.shortcutGroups[toGroupIndex];

      if (
        !fromGroup ||
        !toGroup ||
        fromShortcutIndex < 0 ||
        fromShortcutIndex >= fromGroup.shortcuts.length ||
        (fromGroupIndex === toGroupIndex && fromShortcutIndex === toShortcutIndex)
      ) {
        return false;
      }

      const [shortcut] = fromGroup.shortcuts.splice(fromShortcutIndex, 1);
      const adjustedTargetIndex =
        fromGroupIndex === toGroupIndex && fromShortcutIndex < toShortcutIndex
          ? toShortcutIndex - 1
          : toShortcutIndex;
      const boundedTargetIndex = Math.min(Math.max(adjustedTargetIndex, 0), toGroup.shortcuts.length);

      if (boundedTargetIndex === fromShortcutIndex && fromGroupIndex === toGroupIndex) {
        return false;
      }

      toGroup.shortcuts.splice(boundedTargetIndex, 0, shortcut);
      return true;
    };

    const readDragPayload = (event) => {
      try {
        const payload = event.dataTransfer?.getData("application/json");
        if (payload) {
          return JSON.parse(payload);
        }
      } catch {
        // Fall through to the active payload.
      }

      return activeDragPayload;
    };

    const setDragPayload = (payload) => {
      activeDragPayload = payload;
    };

    const clearDragPayload = () => {
      activeDragPayload = null;
    };

    const dropContainerClasses = [
      "rounded-[0.55rem]",
      "outline",
      "outline-1",
      "outline-dashed",
      "outline-base-content/30",
      "outline-offset-[0.22rem]",
    ];
    const groupDropBeforeClasses = [
      "before:content-['']",
      "before:absolute",
      "before:left-0",
      "before:right-0",
      "before:top-[-0.22rem]",
      "before:z-[35]",
      "before:h-0.5",
      "before:rounded-full",
