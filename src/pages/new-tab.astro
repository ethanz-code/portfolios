    const groupDropAfterClasses = [
      "after:content-['']",
      "after:absolute",
      "after:left-0",
      "after:right-0",
      "after:bottom-[-0.22rem]",
      "after:z-[35]",
      "after:h-0.5",
      "after:rounded-full",
      "after:bg-base-content/70",
      "after:pointer-events-none",
    ];
    const itemDropBeforeClasses = [
      "before:content-['']",
      "before:absolute",
      "before:left-[-0.24rem]",
      "before:top-[0.22rem]",
      "before:bottom-[0.22rem]",
      "before:z-[35]",
      "before:w-0.5",
      "before:rounded-full",
      "before:bg-base-content/70",
      "before:pointer-events-none",
    ];
    const itemDropAfterClasses = [
      "after:content-['']",
      "after:absolute",
      "after:right-[-0.24rem]",
      "after:top-[0.22rem]",
      "after:bottom-[0.22rem]",
      "after:z-[35]",
      "after:w-0.5",
      "after:rounded-full",
      "after:bg-base-content/70",
      "after:pointer-events-none",
    ];
    const dropIndicatorClasses = [
      ...dropContainerClasses,
      ...groupDropBeforeClasses,
      ...groupDropAfterClasses,
      ...itemDropBeforeClasses,
      ...itemDropAfterClasses,
    ];

    const clearDropElement = (element) => {
      element.classList.remove(
        "shortcut-drop-target",
        "shortcut-drop-before",
        "shortcut-drop-after",
        ...dropIndicatorClasses,
      );
    };

    const clearDropIndicators = (root) => {
      clearDropElement(root);
      root.querySelectorAll(".shortcut-drop-target, .shortcut-drop-before, .shortcut-drop-after").forEach(clearDropElement);
    };

    const getDropPosition = (event, element, axis = "x") => {
      const rect = element.getBoundingClientRect();
      const pointer = axis === "y" ? event.clientY : event.clientX;
      const midpoint = axis === "y" ? rect.top + rect.height / 2 : rect.left + rect.width / 2;
      return pointer < midpoint ? "before" : "after";
    };

    const setDropContainer = (element) => {
      element.classList.add("shortcut-drop-target", ...dropContainerClasses);
    };

    const setDropPosition = (element, position, axis = "x") => {
      const indicatorClasses = axis === "y"
        ? position === "before"
          ? groupDropBeforeClasses
          : groupDropAfterClasses
        : position === "before"
          ? itemDropBeforeClasses
          : itemDropAfterClasses;

      element.classList.add("shortcut-drop-target", `shortcut-drop-${position}`);
      element.classList.add(...indicatorClasses);
    };

    const dragHandleIcon = getIconMarkup("drag");

    const faviconProxyUrl = META_PROXY_ORIGIN;

    const getProxyUrl = (url) => `${faviconProxyUrl}?url=${encodeURIComponent(url)}`;

    const isRemoteUrl = (value) => /^https?:\/\//i.test(value);

    const getShortcutLogoCacheKey = (url) => {
      try {
        return new URL(url).origin;
      } catch {
        return url;
      }
    };

    const canProxyUrl = (url) => {
      try {
        const { hostname } = new URL(url);
        const normalizedHost = hostname.toLowerCase();

        if (
          normalizedHost === "localhost" ||
          normalizedHost.endsWith(".local") ||
          normalizedHost.endsWith(".lan") ||
          normalizedHost.startsWith("10.") ||
          normalizedHost.startsWith("192.168.")
        ) {
          return false;
        }

        const private172Match = normalizedHost.match(/^172\.(\d+)\./);
        if (private172Match && Number(private172Match[1]) >= 16 && Number(private172Match[1]) <= 31) {
          return false;
        }

        return true;
      } catch {
        return false;
      }
    };

    const resolveShortcutAssetUrl = (assetUrl, baseUrl) => {
      if (!assetUrl) {
        return "";
      }

      if (/^[a-z]+:/i.test(assetUrl)) {
        return assetUrl;
      }

      try {
        return new URL(assetUrl, baseUrl).href;
      } catch {
        return assetUrl;
      }
    };

    const pushLogoCandidate = (candidates, url, withProxy = true) => {
      if (!url || candidates.includes(url)) {
        return;
      }

      if (withProxy && canProxyUrl(url)) {
        const proxyUrl = getProxyUrl(url);
        if (!candidates.includes(proxyUrl)) {
          candidates.push(proxyUrl);
        }
      }

      candidates.push(url);
    };

    const pushLogoCandidates = (candidates, urls, withProxy = true) => {
      urls.forEach((url) => {
        pushLogoCandidate(candidates, url, withProxy);
      });
    };

    const getCachedShortcutLogo = (shortcut) => {
      const cached = shortcutLogoCache[getShortcutLogoCacheKey(shortcut.url)];

      return isPlainObject(cached) ? cached : undefined;
    };

    const getShortcutLogoUrls = (shortcut) => {
      if (shortcut.logo) {
        const logoUrl = resolveShortcutAssetUrl(shortcut.logo, shortcut.url);

        return isRemoteUrl(logoUrl)
          ? [getProxyUrl(logoUrl), logoUrl]
          : [logoUrl];
      }

      let originUrl = "";
      try {
        originUrl = new URL(shortcut.url).origin;
      } catch {
        originUrl = "";
      }

      const hostname = getShortcutHostname(shortcut.url);
      const candidates = [];
      const cachedLogo = getCachedShortcutLogo(shortcut);
      const canUseCachedLogo = cachedLogo?.resolverVersion === logoResolverVersion;

      if (canUseCachedLogo && cachedLogo?.logoUrl) {
        pushLogoCandidate(candidates, cachedLogo.logoUrl, false);
      }

      if (canUseCachedLogo && Array.isArray(cachedLogo?.candidates)) {
        pushLogoCandidates(candidates, cachedLogo.candidates);
      }

      const commonPaths = [
        "/favicon.svg",
        "/favicon.png",
        "/favicon.ico",
        "/logo.svg",
        "/logo.png",
        "/icon.svg",
        "/icon.png",
        "/apple-touch-icon.png",
        "/apple-touch-icon-precomposed.png",
        "/assets/logo.svg",
        "/assets/logo.png",
        "/assets/favicon.svg",
        "/assets/favicon.png",
        "/images/logo.svg",
        "/images/logo.png",
        "/images/logo-blue.png",
        "/images/logo-light.png",
      ];

      commonPaths.forEach((path) => {
        if (!originUrl) {
          return;
        }

        pushLogoCandidate(candidates, new URL(path, originUrl).href);
      });

      const googleFavicon = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(hostname)}&sz=64`;
      const duckDuckGoFavicon = `https://icons.duckduckgo.com/ip3/${hostname}.ico`;
      const directFavicon = `https://${hostname}/favicon.ico`;

      pushLogoCandidate(candidates, googleFavicon);
      pushLogoCandidate(candidates, duckDuckGoFavicon);
      pushLogoCandidate(candidates, directFavicon, false);

      return candidates;
    };

    const getShortcutSubtitle = (shortcut) =>
      shortcut.description ?? getCachedShortcutLogo(shortcut)?.description ?? getShortcutHostname(shortcut.url);

    const cleanShortcutTitle = (value) => {
      const title = normalizeText(value);

      if (!title) {
        return "";
      }

      const shortTitle = title.slice(0, 80);
      const match = shortTitle.match(/^(.*?)[\s]*[-–—·|:：][\s]*([^\-–—·|:：\n]{1,24})$/);

      if (match && match[1].trim() && match[2].trim()) {
        return match[1].trim();
      }

      return shortTitle;
    };

    const normalizePageTitle = (value) =>
      normalizeText(value).replace(/\u2026/g, "...").replace(/\s+/g, " ");

    // SPA 站点（如 1Panel）的静态 HTML 标题常是占位符，真实标题由前端渲染，服务端抓不到。
    const isLoadingPageTitle = (value) =>
      /^loading[.\s]*$/i.test(value) || /^(加载中|正在加载|请稍候)[.。\s]*$/.test(value);

    const collectLogoUrlsFromHtml = (html, baseUrl) => {
      const candidates = [];
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, "text/html");
      const pageTitle = cleanShortcutTitle(normalizePageTitle(doc.querySelector("title")?.textContent));
      const fallbackTitle = cleanShortcutTitle(normalizePageTitle(
        doc.querySelector('meta[property="og:title"]')?.getAttribute("content") ??
        doc.querySelector('meta[name="application-name"]')?.getAttribute("content") ??
        "",
      ));
      const resolvedTitle = [pageTitle, fallbackTitle].find(
        (value) => value && !isLoadingPageTitle(value),
      ) ?? "";
      const iconSelector = [
        'link[rel~="icon"][href]',
        'link[rel~="apple-touch-icon"][href]',
        'link[rel~="apple-touch-icon-precomposed"][href]',
        'link[rel~="mask-icon"][href]',
        'meta[property="og:logo"][content]',
      ].join(",");

      doc.querySelectorAll(iconSelector).forEach((element) => {
        const rawUrl = element.getAttribute("href") ?? element.getAttribute("content");
        const logoUrl = resolveShortcutAssetUrl(rawUrl, baseUrl);

        if (logoUrl && !candidates.includes(logoUrl)) {
          candidates.push(logoUrl);
        }
      });

      doc.querySelectorAll('script[type="application/ld+json"]').forEach((script) => {
        try {
          const data = JSON.parse(script.textContent ?? "null");
          const nodes = Array.isArray(data) ? data : [data];

          nodes.forEach((node) => {
            const logo = node?.logo?.url ?? node?.logo;
            const logoUrl = typeof logo === "string" ? resolveShortcutAssetUrl(logo, baseUrl) : "";

            if (logoUrl && !candidates.includes(logoUrl)) {
              candidates.push(logoUrl);
            }
          });
        } catch {
          // Ignore invalid structured data and keep other logo sources.
        }
      });

      doc.querySelectorAll('meta[property="og:image"][content], meta[name="twitter:image"][content]').forEach((element) => {
        const logoUrl = resolveShortcutAssetUrl(element.getAttribute("content") ?? "", baseUrl);

        if (logoUrl && !candidates.includes(logoUrl)) {
          candidates.push(logoUrl);
        }
      });

      return {
        candidates,
        title: resolvedTitle,
        description: normalizeText(
          doc.querySelector('meta[name="description"]')?.getAttribute("content") ??
          doc.querySelector('meta[property="og:description"]')?.getAttribute("content"),
        ),
      };
    };

    const collectAssetScriptUrlsFromHtml = (html, baseUrl) => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, "text/html");
      const urls = [];
      const selector = [
        "script[src]",
        'link[rel="modulepreload"][href]',
        'link[rel="preload"][as="script"][href]',
      ].join(",");

      doc.querySelectorAll(selector).forEach((element) => {
        const rawUrl = element.getAttribute("src") ?? element.getAttribute("href");
        const scriptUrl = resolveShortcutAssetUrl(rawUrl, baseUrl);

        if (scriptUrl && !urls.includes(scriptUrl)) {
          urls.push(scriptUrl);
        }
      });

      return urls;
    };

    const collectBundledLogoUrls = async (html, baseUrl, signal) => {
      const scriptUrls = collectAssetScriptUrlsFromHtml(html, baseUrl).slice(0, 2);
      const candidates = [];

      for (const scriptUrl of scriptUrls) {
        try {
          const response = await fetch(getProxyUrl(scriptUrl), { signal });
          const script = response.ok ? await response.text() : "";

          if (/assets\/js\/1panel-(?:menu-)?logo-[\w-]+\.js/.test(script)) {
            candidates.push(onePanelLogoDataUrl);
          }
        } catch {
          // Ignore optional bundle probing and keep the regular favicon chain.
        }
      }

      return {
        logoUrl: candidates[0],
        candidates: candidates.filter((url, index, items) => items.indexOf(url) === index),
      };
    };

    const hasUsefulCachedLogoMetadata = (cached) =>
      Boolean(
        cached?.resolverVersion === logoResolverVersion &&
        (
          cached.metadataResolved ||
          (Array.isArray(cached.candidates) && cached.candidates.length) ||
          cached.description ||
          cached.failedAt
        ),
      );

    const mergeShortcutLogoCache = (cacheKey, payload) => {
      if (!cacheKey) {
        return;
      }

      const existing = shortcutLogoCache[cacheKey] ?? {};
      const candidates = [
        ...(Array.isArray(existing.candidates) ? existing.candidates : []),
        ...(Array.isArray(payload.candidates) ? payload.candidates : []),
      ].filter((url, index, items) => url && items.indexOf(url) === index);

      shortcutLogoCache = {
        ...shortcutLogoCache,
        [cacheKey]: {
          ...existing,
          ...payload,
          candidates,
          resolverVersion: logoResolverVersion,
          updatedAt: Date.now(),
        },
      };
      writeShortcutLogoCache();
    };

    const fetchShortcutMetadata = (shortcut) => {
      const cacheKey = getShortcutLogoCacheKey(shortcut.url);
      const cached = shortcutLogoCache[cacheKey];
      const cachedAt = Number(cached?.updatedAt ?? cached?.failedAt ?? 0);
      // 成功解析的缓存保鲜 7 天；失败记录只保鲜 1 天，避免一次抖动导致长期不重试。
      const hasResolvedLogoMetadata = Boolean(
        cached?.metadataResolved ||
        (Array.isArray(cached?.candidates) && cached.candidates.length > 0) ||
        cached?.description,
      );
      const isFresh = cachedAt
        && Date.now() - cachedAt < (hasResolvedLogoMetadata ? 7 : 1) * 24 * 60 * 60 * 1000;

      if (!isRemoteUrl(shortcut.url) || !canProxyUrl(shortcut.url)) {
        return Promise.resolve(cached);
      }

      if (isFresh && hasUsefulCachedLogoMetadata(cached)) {
        return Promise.resolve(cached);
      }

      if (shortcutLogoRequests.has(cacheKey)) {
        return shortcutLogoRequests.get(cacheKey);
      }

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 5000);
      const request = fetch(getProxyUrl(shortcut.url), {
        signal: controller.signal,
      })
        .then((response) => (response.ok ? response.text() : ""))
        .then(async (html) => {
          if (!html) {
            mergeShortcutLogoCache(cacheKey, {
              candidates: [],
              failedAt: Date.now(),
            });
            return shortcutLogoCache[cacheKey];
          }

          const discovered = collectLogoUrlsFromHtml(html, shortcut.url);
          const bundled = discovered.candidates.length
            ? { candidates: [] }
            : await collectBundledLogoUrls(html, shortcut.url, controller.signal);
          if (bundled.logoUrl) {
            discovered.logoUrl = bundled.logoUrl;
          }
          discovered.candidates = [
            ...discovered.candidates,
            ...bundled.candidates,
          ].filter((url, index, items) => url && items.indexOf(url) === index);
          discovered.logoUrl = discovered.logoUrl ?? discovered.candidates[0] ?? "";

          if (!discovered.candidates.length && !discovered.title && !discovered.description) {
            mergeShortcutLogoCache(cacheKey, {
              candidates: [],
              failedAt: Date.now(),
            });
            return shortcutLogoCache[cacheKey];
          }

          mergeShortcutLogoCache(cacheKey, {
            ...discovered,
            metadataResolved: true,
          });
          return shortcutLogoCache[cacheKey];
        })
        .catch(() => {
          mergeShortcutLogoCache(cacheKey, {
            candidates: [],
            failedAt: Date.now(),
          });
          return shortcutLogoCache[cacheKey];
        })
        .finally(() => {
          window.clearTimeout(timeout);
          shortcutLogoRequests.delete(cacheKey);
        });

      shortcutLogoRequests.set(cacheKey, request);
      return request;
    };

    const refreshShortcutMetadataDisplay = (shortcut, image) => {
      const item = image.closest(".shortcut-item");
      const itemShell = image.closest(".shortcut-item-shell");

      if (!(item instanceof HTMLElement)) {
        return;
      }

      const subtitle = getShortcutSubtitle(shortcut);
      const itemLabelText = item.querySelector(".shortcut-item__label small");
      const tooltipText = itemShell?.querySelector(".shortcut-item__tooltip small");

      item.setAttribute("aria-label", `${shortcut.title}：${subtitle}`);

      if (itemLabelText instanceof HTMLElement) {
        itemLabelText.textContent = subtitle;
      }

      if (tooltipText instanceof HTMLElement) {
        tooltipText.textContent = subtitle;
      }
    };

    const discoverShortcutLogo = (shortcut, image) => {
      if (shortcut.logo || !isRemoteUrl(shortcut.url)) {
        return;
      }

      fetchShortcutMetadata(shortcut).then((metadata) => {
        refreshShortcutMetadataDisplay(shortcut, image);

        if (!image.isConnected) {
          return;
        }

        const nextUrls = getShortcutLogoUrls(shortcut);
        const nextLogoUrl = nextUrls[0] ?? "";
        const shouldReplaceLoadedLogo = Boolean(
          metadata?.logoUrl &&
          nextLogoUrl &&
          image.src !== nextLogoUrl &&
          image.currentSrc !== nextLogoUrl,
        );

        if (!shouldReplaceLoadedLogo && image.complete && image.naturalWidth > 0) {
          return;
        }

        image.hidden = false;
        image.closest(".shortcut-item__icon")?.querySelector(".shortcut-item__initial")?.classList.add("hidden");
        image.dataset.logoFallbacks = JSON.stringify(nextUrls.slice(1));
        image.src = nextLogoUrl;
      });
    };

    const getNextLogoFallback = (image) => {
      const fallbacks = image.dataset.logoFallbacks
        ? JSON.parse(image.dataset.logoFallbacks)
        : [];
      const nextFallback = fallbacks.shift() ?? "";
      image.dataset.logoFallbacks = JSON.stringify(fallbacks);
      return nextFallback;
    };

    const bindLogoFallback = (image) => {
      image.addEventListener("load", () => {
        if (image.currentSrc && image.naturalWidth > 0) {
          const existing = shortcutLogoCache[image.dataset.logoCacheKey];

          if (
            existing?.metadataResolved &&
            existing?.logoUrl &&
            existing.logoUrl !== image.currentSrc
          ) {
            return;
          }

          mergeShortcutLogoCache(image.dataset.logoCacheKey, {
            logoUrl: image.currentSrc,
          });
        }
      });

      image.addEventListener("error", () => {
        const fallback = getNextLogoFallback(image);

        if (fallback && image.src !== fallback) {
          image.src = fallback;
          return;
        }

        image.hidden = true;
        image.closest(".shortcut-item__icon")?.querySelector(".shortcut-item__initial")?.classList.remove("hidden");
      });
    };

    // —— 布局引擎：网格走原生流式，堆叠/环形/随机走画布绝对定位；切换与增删用 FLIP 补间 ——
    const shortcutPlacementMemory = new Map();

    const getShortcutCanvasKey = (element) =>
      element instanceof HTMLElement ? element.dataset.canvasKey ?? "" : "";

    const hashShortcutKey = (value) => {
      let hash = 5381;

      for (let index = 0; index < value.length; index += 1) {
        hash = ((hash << 5) + hash + value.charCodeAt(index)) | 0;
      }

      return Math.abs(hash);
    };

    const createScatterRandom = (seed) => {
      let state = seed % 2147483647;

      if (state <= 0) {
        state += 2147483646;
      }

      return () => {
        state = (state * 16807) % 2147483647;
        return (state - 1) / 2147483646;
      };
    };

    const layoutShortcutCanvas = (itemsEl, mode, placements) => {
      const children = Array.from(itemsEl.children).filter((child) => child instanceof HTMLElement);

      if (mode === "grid" || !children.length) {
        itemsEl.style.removeProperty("height");
        children.forEach((child) => {
          child.style.removeProperty("position");
          child.style.removeProperty("left");
          child.style.removeProperty("top");
          child.style.removeProperty("transform");
          child.style.removeProperty("z-index");
          delete child.dataset.canvasZ;
          placements.set(getShortcutCanvasKey(child), {
            x: child.offsetLeft,
            y: child.offsetTop,
            rot: 0,
          });
        });
        return;
      }

      const tileEl = children.find((child) => child.classList.contains("shortcut-item-shell")) ?? children[0];
      const tileWidth = tileEl.offsetWidth || 96;
      const tileHeight = tileEl.offsetHeight || 88;
      const width = itemsEl.clientWidth || tileWidth;
      const positions = [];

      if (mode === "stack") {
        // 横向手牌：卡片沿一行错开、轻微重叠，每张露出左侧一条；一行放不下自动换行。
        // dataset.fanTransform 存悬停时向右铺开成完整间距的位置。
        // 每行容量按铺开后的间距算，保证铺开时不会顶出容器。
        const rowGap = 10;
        const collapsedStepX = Math.max(tileWidth * 0.6, 1);
        const expandedStepX = Math.max(tileWidth + rowGap, collapsedStepX);
        const perRow = Math.max(1, Math.floor((width - tileWidth) / expandedStepX) + 1);
        const random = createScatterRandom(newTabState.scatterSeed + 17);

        children.forEach((child, index) => {
          const column = index % perRow;
          const row = Math.floor(index / perRow);

          positions.push({
            x: column * collapsedStepX,
            y: row * (tileHeight + rowGap),
            rot: random() * 3 - 1.5,
            z: index + 1,
          });

          child.dataset.fanTransform = `translate(${column * expandedStepX}px, ${row * (tileHeight + rowGap)}px) rotate(0deg)`;
          child.dataset.fanZ = String(40 + index);
        });
      } else if (mode === "ring") {
        // 弧形：一条开口向上的圆弧（中间低、两端高），瓦片随切线倾斜。
        // 瓦片多到单环按设计间距排不下时拆成多个环纵向叠放，免得一条弧挤成一团；
        // 叠起来高度超预算就把半径拉大、弧压平，优先保证瓦片都露在视口里。
        const tileMax = Math.max(tileWidth, tileHeight);
        // 相邻瓦片沿弧的间距，与单环原有观感一致
        const arcStep = tileMax * 0.95;
        const maxArcWidth = Math.max(0, width - tileWidth);
        const perRingCapacity = Math.max(1, Math.floor(maxArcWidth / arcStep) + 1);
        const ringCount = Math.max(1, Math.ceil(children.length / perRingCapacity));
        const perRing = Math.ceil(children.length / ringCount);
        const ringGap = 12;
        const apexPad = 6;
        const heightBudget = Math.max(tileHeight * 2, window.innerHeight * 0.58);
        const dropLimit = Math.max(
          0,
          (heightBudget - apexPad - ringCount * tileHeight - (ringCount - 1) * ringGap) / ringCount,
        );
        const baseRadius = Math.max(width * 0.72, tileMax * 1.4);
        const arcDrop = (r, len) => r * (1 - Math.cos(len / (2 * r)));
        const longestArc = Math.min(maxArcWidth, (perRing - 1) * arcStep);

        let radius = baseRadius;

        if (arcDrop(radius, longestArc) > dropLimit) {
          // 半径越大弧越平（弧深越小），二分找刚好把弧深压进预算的半径
          let low = baseRadius;
          let high = baseRadius * 64;

          for (let attempt = 0; attempt < 42; attempt += 1) {
            const mid = (low + high) / 2;

            if (arcDrop(mid, longestArc) > dropLimit) {
              low = mid;
            } else {
              high = mid;
            }
          }

          radius = high;
        }

        let ringTop = apexPad;
        let placed = 0;

        for (let ring = 0; ring < ringCount && placed < children.length; ring += 1) {
          const size = Math.min(perRing, children.length - placed);
          const arcLen = Math.min(maxArcWidth, (size - 1) * arcStep);
          const half = arcLen / (2 * radius);
          const step = size > 1 ? arcLen / radius / (size - 1) : 0;

          for (let offset = 0; offset < size; offset += 1) {
            const angle = (offset - (size - 1) / 2) * step;

            positions.push({
              x: width / 2 + Math.sin(angle) * radius - tileWidth / 2,
              y: ringTop + radius * (Math.cos(angle) - Math.cos(half)),
              rot: Math.max(-26, Math.min(26, (-angle * 180) / Math.PI)),
              z: placed + offset + 1,
            });
          }

          placed += size;
          ringTop += arcDrop(radius, arcLen) + tileHeight + ringGap;
        }
      } else {
        // 有机散布：最优采样挑离已放置瓦片最远的候选点，避免规则网格感
        const canvasHeight = Math.max(
          tileHeight * 1.9,
          Math.ceil((children.length * tileWidth * tileHeight * 2.6) / Math.max(width, 1)),
        );
        const placedCenters = [];

        children.forEach((child, index) => {
          const key = getShortcutCanvasKey(child) || String(index);
          const random = createScatterRandom((newTabState.scatterSeed ^ hashShortcutKey(key)) + 11);
          const maxX = Math.max(0, width - tileWidth);
          const maxY = Math.max(0, canvasHeight - tileHeight);
          let best = { x: 0, y: 0, rot: 0 };
          let bestScore = -1;

          for (let attempt = 0; attempt < 12; attempt += 1) {
            const x = random() * maxX;
            const y = random() * maxY;
            const cx = x + tileWidth / 2;
            const cy = y + tileHeight / 2;
            let nearest = Infinity;

            placedCenters.forEach((center) => {
              nearest = Math.min(nearest, Math.hypot(center.x - cx, center.y - cy));
            });

            const edgePull = Math.min(cx, width - cx, cy, canvasHeight - cy) * 0.35;
            const score = (Number.isFinite(nearest) ? nearest : 0) + edgePull;

            if (score > bestScore) {
              bestScore = score;
              best = { x, y, rot: random() * 32 - 16 };
            }
          }

          placedCenters.push({ x: best.x + tileWidth / 2, y: best.y + tileHeight / 2 });
          positions.push({ x: best.x, y: best.y, rot: best.rot, z: 0 });
        });
      }

      const canvasHeight = positions.reduce((max, position) => Math.max(max, position.y), 0) + tileHeight + 4;

      itemsEl.style.height = `${canvasHeight}px`;
      children.forEach((child, index) => {
        const position = positions[index];

        child.style.position = "absolute";
        child.style.left = "0";
        child.style.top = "0";
        child.style.transform = `translate(${position.x}px, ${position.y}px) rotate(${position.rot}deg)`;
        child.style.zIndex = position.z ? String(position.z) : "";

        if (position.z) {
          child.dataset.canvasZ = String(position.z);
        } else {
          delete child.dataset.canvasZ;
        }

        if (mode !== "stack") {
          delete child.dataset.fanTransform;
          delete child.dataset.fanZ;
        }

        placements.set(getShortcutCanvasKey(child), {
          x: position.x,
          y: position.y,
          rot: position.rot,
        });
      });
    };

    const applyShortcutLayouts = (previousPlacements, { animate = true } = {}) => {
      const stack = document.querySelector("[data-shortcut-stack]");

      if (!(stack instanceof HTMLElement)) {
        return;
      }

      const mode = newTabState.shortcutLayout;
      const stagger = animate && previousPlacements.size === 0;
      let globalIndex = 0;

      stack.querySelectorAll(".shortcut-group__items").forEach((itemsEl) => {
        if (!(itemsEl instanceof HTMLElement)) {
          return;
        }

        const placements = new Map();

        layoutShortcutCanvas(itemsEl, mode, placements);

        Array.from(itemsEl.children).forEach((child) => {
          if (!(child instanceof HTMLElement)) {
            return;
          }

          const key = getShortcutCanvasKey(child);
          const target = placements.get(key);

          if (!target) {
            return;
          }

          const delay = stagger ? Math.min(globalIndex * 24, 360) : 0;

          globalIndex += 1;
          child.style.setProperty("--ntab-delay", `${delay}ms`);

          const previous = animate ? previousPlacements.get(key) : undefined;

          if (previous) {
            const dx = previous.x - target.x;
            const dy = previous.y - target.y;
            const dr = (previous.rot ?? 0) - target.rot;

            if (dx || dy || dr) {
              // 起点先关过渡提交，再同步恢复过渡落到终点；不走 rAF（后台/遮挡标签页会节流导致终态不落地）。
              child.style.transition = "none";
              child.style.transform = `translate(${target.x + dx}px, ${target.y + dy}px) rotate(${target.rot + dr}deg)`;
              child.getBoundingClientRect();
              child.style.transition = "";
              child.style.transform = mode === "grid"
                ? ""
                : `translate(${target.x}px, ${target.y}px) rotate(${target.rot}deg)`;
            } else if (mode === "grid") {
              child.style.transform = "";
            } else {
              child.style.transform = `translate(${target.x}px, ${target.y}px) rotate(${target.rot}deg)`;
            }
          } else if (animate && !previousPlacements.has(key)) {
            child.classList.add("ntab-pop");
            window.setTimeout(() => child.classList.remove("ntab-pop"), delay + 620);
          }
        });

        placements.forEach((value, placementKey) => {
          shortcutPlacementMemory.set(placementKey, value);
        });
      });
    };

    let shortcutLayoutResizeTimer = 0;

    const scheduleShortcutRelayout = () => {
      window.clearTimeout(shortcutLayoutResizeTimer);
      shortcutLayoutResizeTimer = window.setTimeout(() => {
        applyShortcutLayouts(shortcutPlacementMemory, { animate: false });
      }, 140);
    };

    const renderSearchEngines = () => {
      const select = document.querySelector("[data-config-search-engine]");

      if (!(select instanceof HTMLSelectElement)) {
        return;
      }

      select.textContent = "";
      newTabState.searchEngines.forEach((engine) => {
        const option = document.createElement("option");
        option.value = engine.id;
        option.textContent = engine.label;
        select.append(option);
      });

      select.value = newTabState.defaultSearchEngineId;
    };

    const renderGreeting = () => {
      const greeting = document.querySelector("[data-new-tab-greeting]");

      if (!(greeting instanceof HTMLElement)) {
        return;
      }

      const hour = new Date().getHours();
      const greetingConfig = newTabState.greetings.find((item) => {
        if (item.from < item.to) {
          return hour >= item.from && hour < item.to;
        }

        return hour >= item.from || hour < item.to;
      });

      greeting.textContent = `${greetingConfig?.label ?? "你好"}，${newTabState.userName}`;

      const dateTarget = document.querySelector("[data-new-tab-date]");

      if (dateTarget instanceof HTMLElement) {
        const now = new Date();
        dateTarget.textContent = [
          new Intl.DateTimeFormat("zh-CN", { month: "long", day: "numeric" }).format(now),
          new Intl.DateTimeFormat("zh-CN", { weekday: "long" }).format(now),
        ].join(" · ");
      }
    };

    const renderHomeLink = () => {
      const homeLink = document.querySelector("[data-home-link]");

      if (!(homeLink instanceof HTMLAnchorElement)) {
        return;
      }

      homeLink.href = newTabState.homeLink.href;
      const homeLinkLabel = homeLink.querySelector("[data-home-link-label]");

      if (homeLinkLabel instanceof HTMLElement) {
        homeLinkLabel.textContent = newTabState.homeLink.label;
        homeLinkLabel.classList.toggle("hidden", !newTabState.homeLink.label);
        return;
      }

      homeLink.textContent = newTabState.homeLink.label;
    };

    const renderShortcutGroups = () => {
      const stack = document.querySelector("[data-shortcut-stack]");

      if (!(stack instanceof HTMLElement)) {
