            fallbackElement: section,
            title: group.title,
            subtitle: "分组操作",
            actions: [
              {
                label: settingsLabels.addShortcutLabel ?? "添加站点",
                icon: "plus",
                onSelect: () => {
                  openShortcutAddForm(group);
                },
