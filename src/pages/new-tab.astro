        });
        items.addEventListener("pointerleave", () => {
          if (newTabState.shortcutLayout !== "stack") {
            return;
          }

          Array.from(items.children).forEach((child) => {
            if (!(child instanceof HTMLElement) || !child.dataset.fanTransform) {
              return;
            }

            child.style.transitionDelay = "";
            const placement = shortcutPlacementMemory.get(getShortcutCanvasKey(child));

            child.style.transform = placement
              ? `translate(${placement.x}px, ${placement.y}px) rotate(${placement.rot}deg)`
              : "";
            child.style.zIndex = child.dataset.canvasZ ?? "";
