        });

        group.shortcuts.forEach((shortcut, shortcutIndex) => {
          const itemShell = document.createElement("div");
          itemShell.className = "shortcut-item-shell group relative z-0 h-[5.75rem] w-[5rem] cursor-grab hover:z-30 focus-within:z-30 active:cursor-grabbing sm:h-[6.2rem] sm:w-[6rem]";
          itemShell.dataset.canvasKey = `${shortcut.url}\n${shortcut.title}`;
          itemShell.dataset.canvasIndex = String(shortcutIndex);

